#!/bin/sh
# S3 boot init: read the slot state, mount the three layers, switch_root.
#
# Order matters and is asserted, not assumed:
#
#   0. p4  first-boot growth: the partition table is rewritten so p4 reaches the end of
#          the disk, the kernel re-reads it, and the outcome lands in
#          <p4 root subvolume>/.ab/grow as `result=<state> last_lba=<n>`
#   1. p4  unmounted device    btrfs filesystem resize max <device>   (no mount yet)
#          then                 root subvolume rw,compress=zstd:6    -> /mnt/p4root
#          then                 .ab/partitions.before, .ab/grow, umount
#   2. p4  @overlay-<version>  rw,compress=zstd:6,discard=async
#                              subvol=@overlay-<version>         -> /mnt/p4
#   3. p2  @platform           ro,noatime                      -> /mnt/@platform
#   4. p2  @sys               ro,noatime                       -> /mnt/@sys
#   5. overlay lowerdir=/mnt/@platform:/mnt/@sys
#              upperdir=/mnt/p4/upper workdir=/mnt/p4/work   -> /newroot
#   6. p4  @data               rw,noatime                       -> /newroot/data
#      p4  @docker             rw,noatime,nodatacow,nodatasum   -> /newroot/opt/docker
#      p4  @swap               rw,noatime,nodatacow,nodatasum   -> /newroot/swap
#
# The growth runs before anything is mounted, so the filesystem is mounted on a
# partition that already has its final size. It only ever enlarges p4 and it is
# idempotent: a disk that already reaches the end of the usable area is left alone and
# reported as already-full. A growth failure never stops the boot; p4 simply stays at
# its shipped 64 MiB and the state is recorded for ab-boot to pick up.
#
# The three user-data subvolumes are mounted under /newroot so that they become /data,
# /opt/docker and /swap once switch_root has happened. A failure there is logged as
# p4-partial and the boot continues: a missing /data must not cost a bootable system.
# Only @overlay carries compress=; a filesystem has exactly one compression level, so
# the child mounts repeat no compress option at all.
#
# The filesystem is resized before anything is mounted, on the device itself: btrfs-progs
# then has no mount point to resolve and no second mount to trip over. The root subvolume
# is the first mount after that, and it carries `compress=` and `discard=`: `compress=` is
# only applied by the first mount of a filesystem. The generation layer
# is mounted afterwards with the same options; repeating them is harmless because the
# filesystem already has its level. The read-only layers are mounted under @-names so the
# overlay command line literally carries both layer names. The writable layer name comes
# from the state file (@overlay-<upstream version>), never from the generation counter:
# the counter orders generations, the name identifies them.
#
# Everything asserted here is re-checked from inside the composed root by
# /s3-post.sh, which switch_root hands control to as the new /init.
#
# Kernel command line:
#   ab.slot=<a|b>     slot GRUB selected for this boot (default: the committed slot)
#   ab.disk=<disk>    disk holding the four partitions; only a hint, accepted when the
#                     reverse lookup agrees that it carries ab-esp
#   wf.dev=<disk>     test/QEMU alias for the same hint
#   wf.boot=<n>       test label only, recorded in the probe file (default 1)
#
# The boot disk is never assumed: /dev/vda only exists on virtio. platform/lib/
# disk-identity.sh resolves it through kernel parameter, PARTUUID, PARTNAME, mount
# reverse lookup and unique candidate, and the partition nodes come from sysfs, so
# /dev/sda4, /dev/nvme0n1p4 and /dev/mmcblk0p4 are all found without any string surgery.
# When it cannot decide, the boot continues without growing or mounting p4 and reports
# the reason instead of powering off.
#
# Judge line, frozen:
#   S3-RESULT=ok slot=<a|b> upper=<@overlay-version> lower=<platform:sys> root=overlay
#   S3-RESULT=fail reason=<token>

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

BOOT=1
# Two distinct mount points for the two p4 passes, so a leftover mount is easy to spot in
# the log: the resize pass uses P4_RESIZE_MOUNT and is unmounted before the record pass.
P4_RESIZE_MOUNT=/mnt/p4resize
for arg in $(cat /proc/cmdline); do
    case "${arg}" in
        wf.boot=*) BOOT="${arg#wf.boot=}" ;;
    esac
done

. /lib/wf.sh
. /lib/grow.sh
. /lib/disk-identity.sh

wf_log "S3 layered boot, boot ${BOOT}"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
# devtmpfs is the only device source: the upstream busybox has no mdev applet, and the
# kernel this image ships with always carries devtmpfs. Partitions the grow step adds
# later appear here too, because devtmpfs is the kernel's own directory.
mount -t devtmpfs devtmpfs /dev 2>/dev/null
# /dev/null proves the mount worked: the directory itself is created at build time, so
# testing for it would always pass. When devtmpfs did not populate /dev, say what the
# kernel reported before giving up on the device scan below.
if [ ! -e /dev/null ]; then
    wf_log "devtmpfs did not populate /dev; /proc/filesystems: $(tr '\n' ' ' </proc/filesystems 2>/dev/null)"
    wf_log "/dev entries: $(ls /dev 2>/dev/null | tr '\n' ' ')"
    wf_fail no-dev-directory
fi
mkdir -p /mnt /newroot

KVER="$(uname -r)"
wf_log "kernel ${KVER}"

# --------------------------------------------------------------------------- #
# Modules: btrfs for the slots and the writable layer, vfat for the ESP
# --------------------------------------------------------------------------- #

MODDIR="/lib/modules/${KVER}"
[ -d "${MODDIR}" ] || wf_fail no-module-directory
loaded=0
pass=1
while [ "${pass}" -le 4 ]; do
    for ko in "${MODDIR}"/*.ko; do
        [ -f "${ko}" ] || continue
        name="$(basename "${ko}" .ko | tr '-' '_')"
        [ -d "/sys/module/${name}" ] && continue
        # insmod is the kmod package's applet link (/sbin/insmod -> /sbin/kmod): the
        # upstream busybox does not carry the insmod applet.
        if /sbin/insmod "${ko}" 2>/dev/null; then
            loaded=$((loaded + 1))
        fi
    done
    if [ -d /sys/module/btrfs ] && [ -d /sys/module/vfat ]; then
        break
    fi
    pass=$((pass + 1))
done
wf_log "loaded ${loaded} module(s)"
[ -d /sys/module/btrfs ] || wf_fail btrfs-not-loaded
[ -d /sys/module/vfat ] || wf_fail vfat-not-loaded

# --------------------------------------------------------------------------- #
# 1. Device identity: which disk carries us
# --------------------------------------------------------------------------- #
# The result is evidence, not a guess: five resolution levels, and a disk only counts
# when sysfs reports DEVTYPE=disk with removable=0 and all four ab-* partitions agree on
# it. Anything else is reported and the boot goes on without touching the disk.

dev=""
dev_method=""
dev_error=""
identity="$(di_resolve)"
identity_rc=$?
case "${identity}" in
    disk=*)
        dev_rest="${identity#disk=}"
        dev="${dev_rest%% *}"
        dev_method="${identity##*method=}"
        ;;
    *)
        dev_error="${identity#reason=}"
        ;;
esac
if [ "${identity_rc}" -ne 0 ]; then
    wf_log "device identity unresolved: ${dev_error:-unknown}"
    wf_say "[boot] stage=device disk=unknown method=none reason=${dev_error:-unknown}"
else
    wf_log "device: disk=${dev} method=${dev_method}"
    wf_say "[boot] stage=device disk=${dev} method=${dev_method}"
fi

# --------------------------------------------------------------------------- #
# 2. Partition discovery: on the resolved disk, by name, then by partition number
# --------------------------------------------------------------------------- #
# Every lookup is scoped to the disk that was just resolved, so a second disk carrying a
# copy of this image (or a USB stick) can never supply the writable layer or the slots.
# di_find_partition tries the partition number on that disk, accepts it only when the
# kernel confirms the same GPT name there, then falls back to the name on that disk. Only
# when no disk could be resolved does a bare name lookup answer, and it still refuses
# partitions whose parent disk is removable.
# Nothing here glues a digit onto a device name: the partition number is matched through
# sysfs PARTN, so sda4, nvme0n1p4 and mmcblk0p4 all work.

esp="$(di_find_partition ab-esp 1 "${dev}")" || esp=""
slot_a="$(di_find_partition ab-slot-a 2 "${dev}")" || slot_a=""
slot_b="$(di_find_partition ab-slot-b 3 "${dev}")" || slot_b=""
p4="$(di_find_partition ab-data 4 "${dev}")" || p4=""
wf_log "partitions on ${dev:-an unresolved disk}: esp=${esp:-none} slot-a=${slot_a:-none} slot-b=${slot_b:-none} data=${p4:-none}"
[ -n "${esp}" ] || wf_fail no-block-device

# The failure path has to reach the ESP even when it fails before mounting it: a pending
# slot that cannot finish the initramfs must not be selected again by GRUB, so wf_fail
# rewrites the slot hint before it powers off.
# shellcheck disable=SC2034  # read by wf_failsafe_abandon in lib/wf.sh
WF_ESP_DEV="${esp}"
export WF_ESP_DEV

# --------------------------------------------------------------------------- #
# 3. First-boot growth of p4, before anything is mounted
# --------------------------------------------------------------------------- #
# The image ships p4 with 64 MiB and leaves the tail of the disk unallocated; the
# table is rewritten here so the filesystem below is mounted on its final geometry.
# Every outcome is a recorded state, never a boot failure: a 64 MiB p4 still boots, it
# just cannot hold much. `<state>` is done, already-full, missing-sfdisk or fail:<token>.

if [ -n "${dev}" ] && [ -n "${p4}" ]; then
    # Diagnose from a pulled disk, not from a serial console. The buffer lives on the
    # initramfs tmpfs here: the ESP is only mounted later, and read-only, so writing
    # "straight to /esp" (as an earlier version did) silently lost every line. The buffer
    # is copied onto p4 once that is mounted, and ab-boot carries it to the ESP.
    # /tmp does not exist in this initramfs (only bin proc sys dev mnt lib/modules are
    # created), so the buffer lives in /run/grow - the same directory wf_grow_run keeps
    # its table dumps in, which this line creates first because wf_grow_log appends to it
    # before wf_grow_run gets that far.
    mkdir -p /run/grow 2>/dev/null || :
    WF_GROW_LOG_FILE="/run/grow/grow.log"
    export WF_GROW_LOG_FILE
    : >"${WF_GROW_LOG_FILE}" 2>/dev/null || :
    grow_line="$(wf_grow_run "${dev}" "${p4}")" || grow_line="fail:grow-crashed 0"
elif [ -n "${dev_error}" ]; then
    # Writing a partition table on a disk nobody could identify is exactly the mistake
    # that bricks a machine, so the reason is recorded and the disks stay untouched.
    wf_log "p4 growth skipped: ${dev_error}"
    grow_line="fail:${dev_error} 0"
else
    wf_log "p4 growth skipped: no data partition was found"
    grow_line="fail:no-data-partition 0"
fi
grow_state="${grow_line%% *}"
grow_last_lba="${grow_line##* }"
case "${grow_state}" in
    done | already-full | missing-sfdisk) : ;;
    fail:?*) : ;;
    *)
        wf_log "unexpected growth result '${grow_state}', recording fail:grow-crashed"
        grow_state="fail:grow-crashed"
        ;;
esac
case "${grow_last_lba}" in
    '' | *[!0-9]*) grow_last_lba=0 ;;
esac
wf_log "p4 growth: ${grow_state} (last usable LBA ${grow_last_lba})"

# --------------------------------------------------------------------------- #
# 3b. Filesystem resize: a clean mount, the resize, and the mount given back
# --------------------------------------------------------------------------- #
# The btrfs-progs shipped in the image does not resize an unmounted device — it answers
# `ERROR: not a directory: /dev/vda4` — so the filesystem is mounted for the resize. That
# mount carries NO options of its own: no compress=, no discard=, no subvol=. A resize on
# a freshly grown partition must not depend on the options of a later mount, and keeping
# them apart is what makes a failure diagnosable (`unable to resize ...: Invalid
# argument` is an option/mount interaction, `not a directory` is a device target).
#
# The mount is unmounted inside wf_grow_resize_mounted, before the option-carrying mount
# that writes the growth record, so the filesystem is never mounted twice at once.
# A resize failure is recorded, never fatal: ab-boot retries it at runtime with p4
# mounted, and even without that a 64 MiB p4 still boots.
case "${grow_state}" in
    done | already-full)
        wf_log "p4 step=resize target=${p4} state=${grow_state} clean-mount=${P4_RESIZE_MOUNT}"
        grow_fs="$(wf_grow_resize_mounted "${p4}" "${P4_RESIZE_MOUNT}" "${dev}")"
        case "${grow_fs}" in
            done) wf_log "btrfs filesystem at max size" ;;
            *)
                wf_log "btrfs filesystem resize failed, recording ${grow_fs}"
                grow_state="${grow_fs}"
                ;;
        esac
        ;;
esac

# --------------------------------------------------------------------------- #
# 4. State from the ESP
# --------------------------------------------------------------------------- #

mkdir -p /esp
mount -t vfat -o ro "${esp}" /esp || wf_fail esp-mount-failed
STATE=/esp/ab/state.json
[ -f "${STATE}" ] || wf_fail state-missing

slot="$(wf_committed "${STATE}")"
committed_slot="${slot}"
case "${slot}" in
    a | b) : ;;
    *) wf_fail "state-committed-invalid-${slot:-empty}" ;;
esac
# GRUB names the slot it booted; without that hint the committed slot is the one we
# are supposed to be running.
requested_slot=""
for arg in $(cat /proc/cmdline); do
    case "${arg}" in
        ab.slot=*) requested_slot="${arg#ab.slot=}" ;;
    esac
done
if [ -n "${requested_slot}" ]; then
    case "${requested_slot}" in
        a | b) : ;;
        *) wf_fail "ab-slot-invalid-${requested_slot}" ;;
    esac
    slot="${requested_slot}"
    wf_log "GRUB selected slot ${slot} (committed is ${committed_slot})"
fi
case "${slot}" in
    a) slot_dev="${slot_a}" ;;
    b) slot_dev="${slot_b}" ;;
esac
upper="$(wf_upper "${STATE}" "${slot}")"
[ -n "${upper}" ] || wf_fail state-upper-invalid
generation="$(wf_generation "${STATE}")" || generation=unknown
wf_log "state: committed=${slot} upper=${upper} generation=${generation}"

# --------------------------------------------------------------------------- #
# 5. Mount order: p4 root subvolume (resize, record), then the generation layer,
#    then the read-only layers
# --------------------------------------------------------------------------- #

mkdir -p /mnt/p4 /mnt/p4root "${P4_RESIZE_MOUNT}" /mnt/@platform /mnt/@sys
degraded=0

# --------------------------------------------------------------------------- #
# 5a. p4, first pass: mount the filesystem root once to keep the growth record
# --------------------------------------------------------------------------- #
# The resize already happened in section 3b, on the unmounted device. This mount only
# exists to write `.ab/grow` and `.ab/partitions.before` on the root subvolume: it
# outlives every generation layer, and ab-boot mounts it at /mnt/p4 at runtime.
#
# This is also the first mount of the filesystem, so it carries compress= and discard=:
# `compress=` is only applied by the first mount, and the generation mount below repeats
# the same level. The mount is given back before that second mount, so btrfs-progs and
# the overlay never see the filesystem mounted twice.
if mount -o rw,noatime,compress=zstd:6,discard=async,"subvol=/" "${p4}" /mnt/p4root; then
    p4root_line="$(awk '$2 == "/mnt/p4root" { print }' /proc/mounts)"
    case "${p4root_line}" in
        *compress=*) : ;;
        *) wf_fail p4-compress-option-missing ;;
    esac

    wf_log "p4 step=record start device=${p4} state=${grow_state}"
    # The pre-change table is kept next to the record: if the write turns out to be
    # half-applied on a power cut, the old geometry is on the same disk.
    if wf_grow_backup /mnt/p4root; then
        wf_log "pre-growth partition table kept in .ab/partitions.before"
    fi
    if wf_grow_record /mnt/p4root "${grow_state}" "${grow_last_lba}"; then
        wf_log "p4 growth recorded: result=${grow_state} last_lba=${grow_last_lba}"
        # Carry the buffered log next to the record: p4 survives the boot and ab-boot
        # copies it to the ESP, so a failure has a reason on the disk either way.
        if [ -s "${WF_GROW_LOG_FILE}" ]; then
            cat "${WF_GROW_LOG_FILE}" >>/mnt/p4root/.ab/grow.log 2>/dev/null ||
                wf_log "warning: could not keep the grow log on p4"
        fi
    else
        wf_log "warning: could not write the growth record on the p4 root subvolume"
    fi
    # The mount is given back before the generation mount, so the filesystem is never
    # mounted twice while btrfs-progs or the overlay is working on it.
    umount /mnt/p4root || {
        wf_log "umount /mnt/p4root failed, retrying once"
        sleep 1
        umount /mnt/p4root || wf_log "warning: /mnt/p4root is still mounted"
    }
    if awk -v mp=/mnt/p4root '$2 == mp { found = 1 } END { exit !found }' \
        /proc/mounts 2>/dev/null; then
        wf_log "warning: p4 root subvolume is still mounted at /mnt/p4root"
    else
        wf_log "p4 step=record done, the filesystem has no mount again"
    fi
else
    # The root subvolume is not mountable, so the resize and the record cannot happen.
    # The generation mount below still gets its chance: only the root subvolume may be
    # broken, and a boot with a degraded p4 is better than no boot.
    wf_log "warning: p4 root subvolume not mountable; resize and growth record skipped"
fi

# --------------------------------------------------------------------------- #
# 5b. p4, second pass: the generation's writable layer, mounted for the overlay
# --------------------------------------------------------------------------- #
if mount -o rw,noatime,compress=zstd:6,discard=async,"subvol=/${upper}" "${p4}" /mnt/p4; then
    p4_line="$(awk '$2 == "/mnt/p4" { print }' /proc/mounts)"
    case "${p4_line}" in
        *compress=*) : ;;
        *) wf_fail p4-compress-option-missing ;;
    esac
    wf_log "p4 mounted with compress= (${upper})"
else
    # A broken writable partition must not stop the boot: the system still works,
    # it just cannot persist anything. The upper moves to tmpfs and the boot is
    # reported as degraded.
    degraded=1
    wf_log "p4 unavailable, booting degraded with a tmpfs upper"
    wf_say "[boot] action=degraded-boot p4=degraded"
    mount -t tmpfs -o mode=0755 tmpfs /mnt/p4 || wf_fail degraded-tmpfs-failed
    wf_log "p4 growth result: ${grow_state} (not recorded, p4 is unavailable)"
fi
mkdir -p /mnt/p4/upper /mnt/p4/work

mount -o ro,noatime,"subvol=/@platform" "${slot_dev}" /mnt/@platform || wf_fail platform-mount-failed
mount -o ro,noatime,"subvol=/@sys" "${slot_dev}" /mnt/@sys || wf_fail sys-mount-failed

[ -f /mnt/@platform/etc/platform-release ] || wf_fail platform-layer-empty
[ -x /mnt/@sys/sbin/init ] || wf_fail sys-layer-empty
wf_log "read-only layers mounted: @platform, @sys from ${slot_dev}"

# --------------------------------------------------------------------------- #
# 6. Compose the root
# --------------------------------------------------------------------------- #

mount -t overlay overlay \
    -o "lowerdir=/mnt/@platform:/mnt/@sys,upperdir=/mnt/p4/upper,workdir=/mnt/p4/work,index=off" \
    /newroot || wf_fail overlay-mount-failed

overlay_line="$(awk '$2 == "/newroot" { print }' /proc/mounts)"
case "${overlay_line}" in
    *lowerdir=/mnt/@platform:/mnt/@sys*) : ;;
    *) wf_fail overlay-lowerdir-wrong ;;
esac
case "${overlay_line}" in
    *upperdir=/mnt/p4/upper*) : ;;
    *) wf_fail overlay-upperdir-wrong ;;
esac
case "${overlay_line}" in
    *workdir=/mnt/p4/work*) : ;;
    *) wf_fail overlay-workdir-wrong ;;
esac
# index=off is the kernel default, so it is not echoed back in /proc/mounts. The
# assertion therefore rejects the harmful state (index=on) instead of requiring the
# literal default to appear.
case "${overlay_line}" in
    *index=on*) wf_fail overlay-index-wrong ;;
    *) : ;;
esac
wf_log "overlay composed at /newroot"

# The platform layer must be visible through the merged view.
[ -f /newroot/etc/platform-release ] || wf_fail platform-release-not-in-root

# --------------------------------------------------------------------------- #
# 7. User data subvolumes: created under /newroot so they become /data and friends
# --------------------------------------------------------------------------- #
# These are the entry points to the user's data at runtime, so they are mounted here
# rather than left to a later stage: /data, /opt/docker and /swap exist before the
# first process of the composed root starts. The mount points are created through the
# overlay, which records them in the generation's upper directory.
#
# No compress= option is repeated: a btrfs filesystem has exactly one compression level
# and @overlay already set it (zstd:6). nodatacow/nodatasum restate what the build set
# with chattr +C on @docker and @swap, where COW must stay off for dockerd's layers and
# for swapfiles. A failure is recorded as p4-partial and the boot continues.
p4_partial=""
for spec in \
    "@data:/newroot/data:rw,noatime" \
    "@docker:/newroot/opt/docker:rw,noatime,nodatacow,nodatasum" \
    "@swap:/newroot/swap:rw,noatime,nodatacow,nodatasum"
do
    subvol="${spec%%:*}"
    subvol_spec="${spec#*:}"
    target="${subvol_spec%%:*}"
    options="${subvol_spec#*:}"
    if [ "${degraded}" = "1" ]; then
        p4_partial="${p4_partial} ${subvol}"
        continue
    fi
    if ! mkdir -p "${target}" 2>/dev/null; then
        wf_log "cannot create ${target}; ${subvol} stays unmounted"
        p4_partial="${p4_partial} ${subvol}"
        continue
    fi
    if mount -o "${options},subvol=/${subvol}" "${p4}" "${target}"; then
        wf_log "mounted ${subvol} on ${target} (${options})"
    else
        wf_log "mount of ${subvol} on ${target} failed; continuing"
        p4_partial="${p4_partial} ${subvol}"
    fi
done
if [ -n "${p4_partial}" ]; then
    p4_partial="${p4_partial# }"
    wf_log "p4-partial:${p4_partial} not mounted, the boot continues"
    wf_say "[boot] action=p4-partial subvolumes=${p4_partial}"
else
    wf_log "p4 user data mounted: @data->/data @docker->/opt/docker @swap->/swap"
fi

# --------------------------------------------------------------------------- #
# 8. Probe writes: they must land in the generation's upper directory
# --------------------------------------------------------------------------- #

probe=/.s3-probe
new_file="/.s3-new-${BOOT}"

if [ "${BOOT}" = "2" ]; then
    [ -f "/newroot${probe}" ] || wf_fail probe-lost-between-boots
    case "$(cat "/newroot${probe}")" in
        *boot=1*) wf_log "first boot probe survived: $(cat "/newroot${probe}")" ;;
        *) wf_fail probe-content-unexpected ;;
    esac
fi

printf 'boot=%s slot=%s upper=%s\n' "${BOOT}" "${slot}" "${upper}" >"/newroot${probe}" \
    || wf_fail probe-write-failed
printf 'created on boot %s\n' "${BOOT}" >"/newroot${new_file}" \
    || wf_fail newfile-write-failed

if [ "${degraded}" = "1" ]; then
    wf_log "degraded boot: probe writes land in tmpfs and disappear on reboot"
fi

[ -f "/mnt/p4/upper${probe}" ] || wf_fail probe-not-in-upper
[ -f "/mnt/p4/upper${new_file}" ] || wf_fail newfile-not-in-upper
[ ! -e "/mnt/@platform${probe}" ] || wf_fail probe-leaked-to-platform
[ ! -e "/mnt/@sys${probe}" ] || wf_fail probe-leaked-to-sys
wf_log "probe writes landed in upper, not in the read-only layers"

# --------------------------------------------------------------------------- #
# 9. Hand over to the composed root
# --------------------------------------------------------------------------- #

cp /s3-post.sh /newroot/.s3-post || wf_fail post-script-stage-failed
chmod 0755 /newroot/.s3-post
umount /esp || wf_log "warning: could not unmount the ESP"

for fs in proc sys dev; do
    mkdir -p "/newroot/${fs}"
    # `-o move` is understood by both busybox and util-linux, but devtmpfs refuses to
    # move on some kernels, so a bind mount is used as the fallback: the old root is
    # discarded by switch_root anyway, and the nodes are the same either way.
    if ! move_err="$(mount -o move "/${fs}" "/newroot/${fs}" 2>&1)"; then
        wf_log "move of /${fs} failed (${move_err}); falling back to bind"
        mount --bind "/${fs}" "/newroot/${fs}" \
            || wf_fail "move-${fs}-failed"
    fi
done

wf_log "switching root to the overlay"
# switch_root must be PID 1, and this script is a child of the shell that the kernel
# started as init, so exec replaces the shell instead of forking a helper.
# shellcheck disable=SC2093  # exec only returns when it fails; the line below handles that
exec switch_root /newroot /bin/sh /.s3-post "${slot}" "${upper}" "${BOOT}"

# exec only returns when it fails.
wf_fail switch-root-failed
