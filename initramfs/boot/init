#!/bin/sh
# S3 boot init: read the slot state, mount the three layers, switch_root.
#
# Order matters and is asserted, not assumed:
#
#   0. p4  first-boot growth: the partition table is rewritten so p4 reaches the end of
#          the disk, the kernel re-reads it, and the outcome lands in
#          <p4 root subvolume>/.ab/grow as `result=<state> last_lba=<n>`
#   1. p4  unmounted device    btrfs filesystem resize max <device>   (no mount yet)
#          then                 root subvolume rw,compress=zstd:6    -> /mnt/p4root
#          then                 .ab/partitions.before, .ab/grow, .ab/esp-health, umount
#   2. p4  @overlay-<version>  rw,compress=zstd:6,discard=async
#                              subvol=@overlay-<version>         -> /mnt/p4
#   3. p2  @platform           ro,noatime                      -> /mnt/@platform
#   4. p2  @sys               ro,noatime                       -> /mnt/@sys
#   5. overlay lowerdir=/mnt/@platform:/mnt/@sys
#              upperdir=/mnt/p4/upper workdir=/mnt/p4/work   -> /newroot
#   6. p4  @data               rw,noatime                       -> /newroot/data
#      p4  @docker             rw,noatime,nodatacow,nodatasum   -> /newroot/opt/docker
#      p4  @swap               rw,noatime,nodatacow,nodatasum   -> /newroot/swap
#
# The ESP (p1) is probed read-only before any of that - boot signature, the FAT's
# clean-shutdown bit, the FSInfo sector - and mounted read-write immediately after the
# growth, because everything from the state file onwards is read from it and the failure
# path has to be able to rewrite the GRUB hint on the same mount (initramfs/lib/esp-health.sh
# holds the probe; a mount before the growth would break the partition-table reread).
#
# One breadcrumb per milestone goes to the first surface that can hold it, in the order this
# boot makes them available: the serial port only while nothing is mounted, the ESP ring log
# once it is mounted, and the p4 side after it is given back. `wf_mark` never changes a boot
# decision - a line that cannot be written is a missing diagnostic, not a reason to stop:
#
#   device  grow-done  esp-mounted  state  p4-record  overlay  esp-unmounted  switching-root
#
# The growth runs before anything is mounted, so the filesystem is mounted on a
# partition that already has its final size. It only ever enlarges p4 and it is
# idempotent: a disk that already reaches the end of the usable area is left alone and
# reported as already-full. A growth failure never stops the boot; p4 simply stays at
# its shipped 64 MiB and the state is recorded for ab-boot to pick up.
#
# The three user-data subvolumes are mounted under /newroot so that they become /data,
# /opt/docker and /swap once switch_root has happened. A failure there is logged as
# p4-partial and the boot continues: a missing /data must not cost a bootable system.
# Only @overlay carries compress=; a filesystem has exactly one compression level, so
# the child mounts repeat no compress option at all.
#
# The filesystem is resized before anything is mounted, on the device itself: btrfs-progs
# then has no mount point to resolve and no second mount to trip over. The root subvolume
# is the first mount after that, and it carries `compress=` and `discard=`: `compress=` is
# only applied by the first mount of a filesystem. The generation layer
# is mounted afterwards with the same options; repeating them is harmless because the
# filesystem already has its level. The read-only layers are mounted under @-names so the
# overlay command line literally carries both layer names. The writable layer name comes
# from the state file (@overlay-<upstream version>), never from the generation counter:
# the counter orders generations, the name identifies them.
#
# In a CI build everything asserted here is re-checked from inside the composed root by
# /s3-post.sh, which switch_root hands control to as the new /init. A production initramfs
# carries no such file, and there the composed root's own /sbin/init is PID 1: the hook is
# a build-time injection (AB_CI_HOOKS=1), so its absence is not a boot failure.
#
# Kernel command line:
#   ab.slot=<a|b>     slot GRUB selected for this boot (default: the committed slot)
#   ab.disk=<disk>    disk holding the four partitions; only a hint, accepted when the
#                     reverse lookup agrees that it carries ab-esp
#   wf.dev=<disk>     test/QEMU alias for the same hint
#   wf.boot=<n>       test label only, recorded in the probe file (default 1)
#
# The boot disk is never assumed: /dev/vda only exists on virtio. platform/lib/
# disk-identity.sh resolves it through kernel parameter, PARTUUID, PARTNAME, mount
# reverse lookup and unique candidate, and the partition nodes come from sysfs, so
# /dev/sda4, /dev/nvme0n1p4 and /dev/mmcblk0p4 are all found without any string surgery.
# When it cannot decide, the boot continues without growing or mounting p4 and reports
# the reason instead of powering off.
#
# Judge line, frozen:
#   S3-RESULT=ok slot=<a|b> upper=<@overlay-version> lower=<platform:sys> root=overlay
#   S3-RESULT=fail reason=<token>

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

BOOT=1
# Two distinct mount points for the two p4 passes, so a leftover mount is easy to spot in
# the log: the resize pass uses P4_RESIZE_MOUNT and is unmounted before the record pass.
P4_RESIZE_MOUNT=/mnt/p4resize
# The CI assertion, injected by the build only when AB_CI_HOOKS=1 (see
# scripts/ci/initramfs.sh). Named once here so the handover below asks a single question -
# "is it in this initramfs" - and so a test can point it somewhere else.
WF_POST_HOOK="${WF_POST_HOOK:-/s3-post.sh}"
for arg in $(cat /proc/cmdline); do
    case "${arg}" in
        wf.boot=*) BOOT="${arg#wf.boot=}" ;;
    esac
done

. /lib/wf.sh
. /lib/grow.sh
. /lib/disk-identity.sh
. /lib/esp-health.sh

wf_log "S3 layered boot, boot ${BOOT}"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
# Device nodes: devtmpfs when the kernel has it, otherwise built from sysfs. This kernel
# does not mount devtmpfs and the upstream busybox has no mdev applet, so the sysfs walk
# is the path that actually runs. wf_coldplug_dev is called again after the partition
# table is rewritten, because the grow step needs the new partition node.
mount -t devtmpfs devtmpfs /dev 2>/dev/null
wf_coldplug_dev /dev
if [ ! -e /dev/null ]; then
    wf_log "no /dev/null after the sysfs coldplug; /proc/filesystems: $(tr '\n' ' ' </proc/filesystems 2>/dev/null)"
    wf_log "/dev entries: $(ls /dev 2>/dev/null | tr '\n' ' ')"
    wf_fail no-dev-directory
fi
mkdir -p /mnt /newroot

KVER="$(uname -r)"
wf_log "kernel ${KVER}"

# --------------------------------------------------------------------------- #
# Modules: btrfs for the slots and the writable layer, vfat for the ESP
# --------------------------------------------------------------------------- #

MODDIR="/lib/modules/${KVER}"
[ -d "${MODDIR}" ] || wf_fail no-module-directory
loaded=0
pass=1
while [ "${pass}" -le 4 ]; do
    for ko in "${MODDIR}"/*.ko; do
        [ -f "${ko}" ] || continue
        name="$(basename "${ko}" .ko | tr '-' '_')"
        [ -d "/sys/module/${name}" ] && continue
        # insmod is the kmod package's applet link (/sbin/insmod -> /sbin/kmod): the
        # upstream busybox does not carry the insmod applet.
        if /sbin/insmod "${ko}" 2>/dev/null; then
            loaded=$((loaded + 1))
        fi
    done
    if [ -d /sys/module/btrfs ] && [ -d /sys/module/vfat ]; then
        break
    fi
    pass=$((pass + 1))
done
wf_log "loaded ${loaded} module(s)"
[ -d /sys/module/btrfs ] || wf_fail btrfs-not-loaded
[ -d /sys/module/vfat ] || wf_fail vfat-not-loaded

# --------------------------------------------------------------------------- #
# 1. Device identity: which disk carries us
# --------------------------------------------------------------------------- #
# The result is evidence, not a guess: five resolution levels, and a disk only counts
# when sysfs reports DEVTYPE=disk with removable=0 and all four ab-* partitions agree on
# it. Anything else is reported and the boot goes on without touching the disk.

dev=""
dev_method=""
dev_error=""
identity="$(di_resolve)"
identity_rc=$?
case "${identity}" in
    disk=*)
        dev_rest="${identity#disk=}"
        dev="${dev_rest%% *}"
        dev_method="${identity##*method=}"
        ;;
    *)
        dev_error="${identity#reason=}"
        ;;
esac
if [ "${identity_rc}" -ne 0 ]; then
    wf_log "device identity unresolved: ${dev_error:-unknown}"
    wf_say "[boot] stage=device disk=unknown method=none reason=${dev_error:-unknown}"
else
    wf_log "device: disk=${dev} method=${dev_method}"
    wf_say "[boot] stage=device disk=${dev} method=${dev_method}"
fi
# Milestone 1. Nothing is mounted yet, so this is a serial line and no file at all - which
# is exactly the point: a boot that dies in the growth window has to be readable on the
# port it was started from, because there is nowhere else yet.
wf_mark device "disk=${dev:-unknown}" "method=${dev_method:-none}"

# --------------------------------------------------------------------------- #
# 2. Partition discovery: on the resolved disk, by name, then by partition number
# --------------------------------------------------------------------------- #
# Every lookup is scoped to the disk that was just resolved, so a second disk carrying a
# copy of this image (or a USB stick) can never supply the writable layer or the slots.
# di_find_partition tries the partition number on that disk, accepts it only when the
# kernel confirms the same GPT name there, then falls back to the name on that disk. Only
# when no disk could be resolved does a bare name lookup answer, and it still refuses
# partitions whose parent disk is removable.
# Nothing here glues a digit onto a device name: the partition number is matched through
# sysfs PARTN, so sda4, nvme0n1p4 and mmcblk0p4 all work.

esp="$(di_find_partition ab-esp 1 "${dev}")" || esp=""
slot_a="$(di_find_partition ab-slot-a 2 "${dev}")" || slot_a=""
slot_b="$(di_find_partition ab-slot-b 3 "${dev}")" || slot_b=""
p4="$(di_find_partition ab-data 4 "${dev}")" || p4=""
wf_log "partitions on ${dev:-an unresolved disk}: esp=${esp:-none} slot-a=${slot_a:-none} slot-b=${slot_b:-none} data=${p4:-none}"
[ -n "${esp}" ] || wf_fail no-block-device

# The failure path has to reach the ESP even when it fails before mounting it: a pending
# slot that cannot finish the initramfs must not be selected again by GRUB, so wf_fail
# rewrites the slot hint before it powers off.
# shellcheck disable=SC2034  # read by wf_failsafe_abandon in lib/wf.sh
WF_ESP_DEV="${esp}"
export WF_ESP_DEV

# --------------------------------------------------------------------------- #
# 2b. ESP health: a read-only verdict on p1, taken before anything is mounted
# --------------------------------------------------------------------------- #
# The 05:36 poweroff left no evidence and the leading candidate is the ESP itself, which is
# also the one surface that cannot be repaired from the running system. So the volume is
# read - boot signature, the FAT's clean-shutdown bit, the FSInfo sector - and nothing else:
# no write, no repair, no partition change, not here and not behind a flag.
#
# It runs now because the device node exists and the disk is still idle; the verdict is
# finalised after the mount below, and recorded on the p4 side, which is the surface a
# pulled disk still explains the boot from. A dirty or unreadable answer changes nothing:
# it is written down and the boot continues.
esp_probe="$(wf_esp_health_probe "${esp}")"

# --------------------------------------------------------------------------- #
# 3. First-boot growth of p4, before anything is mounted
# --------------------------------------------------------------------------- #
# The image ships p4 with 64 MiB and leaves the tail of the disk unallocated; the
# table is rewritten here so the filesystem below is mounted on its final geometry.
# Every outcome is a recorded state, never a boot failure: a 64 MiB p4 still boots, it
# just cannot hold much. `<state>` is done, already-full, missing-sfdisk or fail:<token>.

if [ -n "${dev}" ] && [ -n "${p4}" ]; then
    # Diagnose from a pulled disk, not from a serial console. The buffer lives on the
    # initramfs tmpfs here because the ESP is not mounted yet, so writing "straight to /esp"
    # (as an earlier version did) would land in a tmpfs directory that the real mount covers
    # and the initramfs takes with it - which silently lost every line of one boot already.
    # The buffer is copied onto p4 once that is mounted, and ab-boot carries it to the ESP.
    # /tmp does not exist in this initramfs (only bin proc sys dev mnt lib/modules are
    # created), so the buffer lives in /run/grow - the same directory wf_grow_run keeps
    # its table dumps in, which this line creates first because wf_grow_log appends to it
    # before wf_grow_run gets that far.
    mkdir -p /run/grow 2>/dev/null || :
    WF_GROW_LOG_FILE="/run/grow/grow.log"
    export WF_GROW_LOG_FILE
    : >"${WF_GROW_LOG_FILE}" 2>/dev/null || :
    grow_line="$(wf_grow_run "${dev}" "${p4}")" || grow_line="fail:grow-crashed 0"
elif [ -n "${dev_error}" ]; then
    # Writing a partition table on a disk nobody could identify is exactly the mistake
    # that bricks a machine, so the reason is recorded and the disks stay untouched.
    wf_log "p4 growth skipped: ${dev_error}"
    grow_line="fail:${dev_error} 0"
else
    wf_log "p4 growth skipped: no data partition was found"
    grow_line="fail:no-data-partition 0"
fi
grow_state="${grow_line%% *}"
grow_last_lba="${grow_line##* }"
case "${grow_state}" in
    done | already-full | missing-sfdisk) : ;;
    fail:?*) : ;;
    *)
        wf_log "unexpected growth result '${grow_state}', recording fail:grow-crashed"
        grow_state="fail:grow-crashed"
        ;;
esac
case "${grow_last_lba}" in
    '' | *[!0-9]*) grow_last_lba=0 ;;
esac
wf_log "p4 growth: ${grow_state} (last usable LBA ${grow_last_lba})"

# --------------------------------------------------------------------------- #
# 3b. Filesystem resize: a clean mount, the resize, and the mount given back
# --------------------------------------------------------------------------- #
# The btrfs-progs shipped in the image does not resize an unmounted device — it answers
# `ERROR: not a directory: /dev/vda4` — so the filesystem is mounted for the resize. That
# mount carries NO options of its own: no compress=, no discard=, no subvol=. A resize on
# a freshly grown partition must not depend on the options of a later mount, and keeping
# them apart is what makes a failure diagnosable (`unable to resize ...: Invalid
# argument` is an option/mount interaction, `not a directory` is a device target).
#
# The mount is unmounted inside wf_grow_resize_mounted, before the option-carrying mount
# that writes the growth record, so the filesystem is never mounted twice at once.
# A resize failure is recorded, never fatal: ab-boot retries it at runtime with p4
# mounted, and even without that a 64 MiB p4 still boots.
case "${grow_state}" in
    done | already-full)
        wf_log "p4 step=resize target=${p4} state=${grow_state} clean-mount=${P4_RESIZE_MOUNT}"
        grow_fs="$(wf_grow_resize_mounted "${p4}" "${P4_RESIZE_MOUNT}" "${dev}")"
        case "${grow_fs}" in
            done) wf_log "btrfs filesystem at max size" ;;
            *)
                wf_log "btrfs filesystem resize failed, recording ${grow_fs}"
                grow_state="${grow_fs}"
                ;;
        esac
        ;;
esac

# Milestone 2. The growth and the resize are finished and their outcome is a token, so the
# last state of it is what the breadcrumb carries - not the pre-resize one.
wf_mark grow-done "result=${grow_state}"

# --------------------------------------------------------------------------- #
# 3c. p4 root subvolume: the second landing zone, and the growth record's home
# --------------------------------------------------------------------------- #
# This mount happens *here*, before the ESP is touched, and not in section 5a where the
# record is written. The reason is the failure path: `esp-mount-failed` and `state-missing`
# - the two candidates the 05:36 poweroff is blamed on - are the exact cases in which the
# ESP cannot hold the evidence, and until this mount existed the p4 fallback had nowhere to
# go either (`/mnt/p4root` was only created at 5a), so those failures were serial-only,
# which is the defect this whole unit exists to fix. It cannot move earlier than this: the
# growth and the resize both rewrite/rename partition state and need the disk with nothing
# mounted on it (see `blockdev --rereadpt` in grow.sh).
#
# The root subvolume outlives every generation layer and ab-boot mounts it at /mnt/p4 at
# runtime, so `.ab/grow` and `.ab/esp-health` written here survive the boot.
#
# It carries compress= and discard= because it is the first option-carrying mount of the
# filesystem; the generation mount below repeats the level (a filesystem has one), and the
# root subvolume is given back before that second mount so btrfs-progs and the overlay never
# see the filesystem mounted twice.
mkdir -p /mnt/p4root 2>/dev/null || :
WF_P4_MOUNT="/mnt/p4root"
export WF_P4_MOUNT
p4root_state="unavailable"
if mount -o rw,noatime,compress=zstd:6,discard=async,"subvol=/" "${p4}" /mnt/p4root; then
    p4root_state="mounted"
    # The first durable landing zone of this boot. It is armed here and not only after the
    # ESP mount, because the two failures this unit exists for (`esp-mount-failed` and
    # `state-missing`) happen while the ESP has no zone at all - with WF_MARK_LOG empty they
    # would be serial-only, and a machine that powers itself off hands its serial log to
    # nobody. Armed before the assertion below on purpose: that one can already fail the
    # boot, and its breadcrumb has to land on a disk that is really there.
    WF_MARK_LOG="$(wf_mark_zone)"
    export WF_MARK_LOG
    p4root_line="$(awk '$2 == "/mnt/p4root" { print }' /proc/mounts)"
    case "${p4root_line}" in
        *compress=*) : ;;
        *) wf_fail p4-compress-option-missing ;;
    esac
    wf_log "p4 root subvolume mounted at /mnt/p4root (the p4 side of the breadcrumb log)"
else
    # The root subvolume is not mountable. The generation mount below still gets its chance:
    # only the root subvolume may be broken, and a boot with a degraded p4 is better than no
    # boot. With no mount there is no p4 landing zone either, so the zone is cleared rather
    # than left pointing at a bare directory that no disk backs.
    wf_log "warning: p4 root subvolume not mountable; the grow record and the p4 fallback are unavailable"
    WF_P4_MOUNT=""
    export WF_P4_MOUNT
fi

# --------------------------------------------------------------------------- #
# 4. State from the ESP
# --------------------------------------------------------------------------- #
# Mounted read-write, because the failure path needs to rewrite ab-slot.cfg and a second
# mount of an already mounted point can only fail ("already mounted or mount point busy") -
# that is how a boot that powered off left no evidence at all. One mount, once.
#
# This is the first moment of the boot at which anything durable can be written, so it is
# where the breadcrumb log starts. WF_MARK_LOG comes from wf_mark_zone, which asks the mount
# table rather than the file system: a line therefore cannot land in a tmpfs directory that
# a later mount covers up and the initramfs takes with it.

mkdir -p /esp
if mount -t vfat -o rw,noatime "${esp}" /esp; then
    esp_mount="rw"
else
    esp_mount="fail"
fi
# The fourth reading is the mount itself, and it is also what makes the kernel inspect the
# volume and log its own opinion of it - so the verdict can only be finished here.
esp_health="$(wf_esp_health_finish "${esp_probe}" "${BOOT}" "${esp_mount}")"
esp_state="$(wf_esp_health_state "${esp_health}")"
wf_log "esp health: ${esp_health}"
wf_say "[boot] stage=esp-health ${esp_health}"
if [ "${esp_mount}" = "rw" ]; then
    WF_MARK_LOG="$(wf_mark_zone)"
    export WF_MARK_LOG
fi
# Milestone 3. With the mount refused no landing zone exists yet (p4 comes later), so this
# one is a serial line and the boot then takes its failure path.
wf_mark esp-mounted "mount=${esp_mount}" "esp=${esp_state}"
[ "${esp_mount}" = "rw" ] || wf_fail esp-mount-failed
STATE=/esp/ab/state.json
[ -f "${STATE}" ] || wf_fail state-missing

slot="$(wf_committed "${STATE}")"
committed_slot="${slot}"
case "${slot}" in
    a | b) : ;;
    *) wf_fail "state-committed-invalid-${slot:-empty}" ;;
esac
# GRUB names the slot it booted; without that hint the committed slot is the one we
# are supposed to be running.
requested_slot=""
for arg in $(cat /proc/cmdline); do
    case "${arg}" in
        ab.slot=*) requested_slot="${arg#ab.slot=}" ;;
    esac
done
if [ -n "${requested_slot}" ]; then
    case "${requested_slot}" in
        a | b) : ;;
        *) wf_fail "ab-slot-invalid-${requested_slot}" ;;
    esac
    slot="${requested_slot}"
    wf_log "GRUB selected slot ${slot} (committed is ${committed_slot})"
fi
case "${slot}" in
    a) slot_dev="${slot_a}" ;;
    b) slot_dev="${slot_b}" ;;
esac
upper="$(wf_upper "${STATE}" "${slot}")"
[ -n "${upper}" ] || wf_fail state-upper-invalid
generation="$(wf_generation "${STATE}")" || generation=unknown
wf_log "state: committed=${slot} upper=${upper} generation=${generation}"
# Milestone 4. The slot decision is the last thing read from the ESP before the layers are
# mounted, so a boot that dies in the mount window says which layer it died on.
wf_mark state "committed=${committed_slot}" "slot=${slot}" "upper=${upper}"

# --------------------------------------------------------------------------- #
# 5. Mount order: p4 root subvolume (resize, record), then the generation layer,
#    then the read-only layers
# --------------------------------------------------------------------------- #

mkdir -p /mnt/p4 /mnt/@platform /mnt/@sys
degraded=0

# --------------------------------------------------------------------------- #
# 5a. p4: the growth record and the ESP verdict, on the root subvolume mounted at 3c
# --------------------------------------------------------------------------- #
# This is the surface that survives a boot which never reaches userspace, so both the growth
# result and the read-only ESP verdict go here, and it is given back before the generation
# mount below so the filesystem is never mounted twice while btrfs-progs or the overlay is
# working on it.
if [ "${p4root_state}" = "mounted" ]; then
    wf_log "p4 step=record start device=${p4} state=${grow_state}"
    # The pre-change table is kept next to the record: if the write turns out to be
    # half-applied on a power cut, the old geometry is on the same disk.
    if wf_grow_backup /mnt/p4root; then
        wf_log "pre-growth partition table kept in .ab/partitions.before"
    fi
    if wf_grow_record /mnt/p4root "${grow_state}" "${grow_last_lba}"; then
        wf_log "p4 growth recorded: result=${grow_state} last_lba=${grow_last_lba}"
        p4root_state="recorded"
        # Carry the buffered log next to the record: p4 survives the boot and ab-boot
        # copies it to the ESP, so a failure has a reason on the disk either way.
        if [ -s "${WF_GROW_LOG_FILE}" ]; then
            cat "${WF_GROW_LOG_FILE}" >>/mnt/p4root/.ab/grow.log 2>/dev/null ||
                wf_log "warning: could not keep the grow log on p4"
        fi
    else
        wf_log "warning: could not write the growth record on the p4 root subvolume"
    fi
    # The ESP verdict goes next to the growth record: this is the only place in the boot
    # where both the conclusion and a writable disk exist. The ESP is deliberately not the
    # place for it - a broken ESP is the case it has to describe.
    if wf_esp_health_record /mnt/p4root "${esp_health}"; then
        wf_log "esp health recorded in .ab/esp-health"
    else
        wf_log "warning: could not write the ESP health record on the p4 root subvolume"
    fi
    # The mount is given back before the generation mount, so the filesystem is never
    # mounted twice while btrfs-progs or the overlay is working on it.
    umount /mnt/p4root || {
        wf_log "umount /mnt/p4root failed, retrying once"
        sleep 1
        umount /mnt/p4root || wf_log "warning: /mnt/p4root is still mounted"
    }
    if awk -v mp=/mnt/p4root '$2 == mp { found = 1 } END { exit !found }' \
        /proc/mounts 2>/dev/null; then
        wf_log "warning: p4 root subvolume is still mounted at /mnt/p4root"
    else
        wf_log "p4 step=record done, the filesystem has no mount again"
    fi
else
    wf_log "warning: p4 root subvolume not mountable; growth record and ESP verdict not kept"
fi
# The root subvolume is given back: from here the p4 landing zone is the generation's
# writable layer (5b) or nothing at all. Leaving WF_P4_MOUNT on /mnt/p4root now would point
# it at a bare directory on the initramfs tmpfs, and a breadcrumb written there would be
# gone with the initramfs - the exact silent loss this file was fixed for.
WF_P4_MOUNT=""
export WF_P4_MOUNT
# Milestone 5. Whatever happened above, the boot now says what it managed to keep: the
# growth result, the ESP verdict and whether the p4 record could be written at all.
wf_mark p4-record "grow=${grow_state}" "esp=${esp_state}" "p4=${p4root_state}"

# --------------------------------------------------------------------------- #
# 5b. p4, second pass: the generation's writable layer, mounted for the overlay
# --------------------------------------------------------------------------- #
if mount -o rw,noatime,compress=zstd:6,discard=async,"subvol=/${upper}" "${p4}" /mnt/p4; then
    # This layer stays mounted until switch_root, so from this line on it is the p4 landing
    # zone. It is set before the compress check below on purpose: that check can fail the
    # boot, and its breadcrumb has to land on a disk that is really there.
    WF_P4_MOUNT="/mnt/p4"
    export WF_P4_MOUNT
    p4_line="$(awk '$2 == "/mnt/p4" { print }' /proc/mounts)"
    case "${p4_line}" in
        *compress=*) : ;;
        *) wf_fail p4-compress-option-missing ;;
    esac
    wf_log "p4 mounted with compress= (${upper})"
else
    # A broken writable partition must not stop the boot: the system still works,
    # it just cannot persist anything. The upper moves to tmpfs and the boot is
    # reported as degraded.
    degraded=1
    # No writable partition: /mnt/p4 is a tmpfs the initramfs takes with it, so it is not a
    # landing zone and no line is written into it (it would be a line no disk ever held).
    WF_P4_MOUNT=""
    export WF_P4_MOUNT
    wf_log "p4 unavailable, booting degraded with a tmpfs upper"
    wf_say "[boot] action=degraded-boot p4=degraded"
    mount -t tmpfs -o mode=0755 tmpfs /mnt/p4 || wf_fail degraded-tmpfs-failed
    wf_log "p4 growth result: ${grow_state} (not recorded, p4 is unavailable)"
fi
mkdir -p /mnt/p4/upper /mnt/p4/work

mount -o ro,noatime,"subvol=/@platform" "${slot_dev}" /mnt/@platform || wf_fail platform-mount-failed
mount -o ro,noatime,"subvol=/@sys" "${slot_dev}" /mnt/@sys || wf_fail sys-mount-failed

[ -f /mnt/@platform/etc/platform-release ] || wf_fail platform-layer-empty
[ -x /mnt/@sys/sbin/init ] || wf_fail sys-layer-empty
wf_log "read-only layers mounted: @platform, @sys from ${slot_dev}"

# --------------------------------------------------------------------------- #
# 6. Compose the root
# --------------------------------------------------------------------------- #

mount -t overlay overlay \
    -o "lowerdir=/mnt/@platform:/mnt/@sys,upperdir=/mnt/p4/upper,workdir=/mnt/p4/work,index=off" \
    /newroot || wf_fail overlay-mount-failed

overlay_line="$(awk '$2 == "/newroot" { print }' /proc/mounts)"
case "${overlay_line}" in
    *lowerdir=/mnt/@platform:/mnt/@sys*) : ;;
    *) wf_fail overlay-lowerdir-wrong ;;
esac
case "${overlay_line}" in
    *upperdir=/mnt/p4/upper*) : ;;
    *) wf_fail overlay-upperdir-wrong ;;
esac
case "${overlay_line}" in
    *workdir=/mnt/p4/work*) : ;;
    *) wf_fail overlay-workdir-wrong ;;
esac
# index=off is the kernel default, so it is not echoed back in /proc/mounts. The
# assertion therefore rejects the harmful state (index=on) instead of requiring the
# literal default to appear.
case "${overlay_line}" in
    *index=on*) wf_fail overlay-index-wrong ;;
    *) : ;;
esac
wf_log "overlay composed at /newroot"
# Milestone 6. The three layers are one root now; a boot that dies between here and the
# switch has its root already composed, which is the state the probe writes below need.
wf_mark overlay "upper=${upper}"

# The platform layer must be visible through the merged view.
[ -f /newroot/etc/platform-release ] || wf_fail platform-release-not-in-root

# --------------------------------------------------------------------------- #
# 7. User data subvolumes: created under /newroot so they become /data and friends
# --------------------------------------------------------------------------- #
# These are the entry points to the user's data at runtime, so they are mounted here
# rather than left to a later stage: /data, /opt/docker and /swap exist before the
# first process of the composed root starts. The mount points are created through the
# overlay, which records them in the generation's upper directory.
#
# No compress= option is repeated: a btrfs filesystem has exactly one compression level
# and @overlay already set it (zstd:6). nodatacow/nodatasum restate what the build set
# with chattr +C on @docker and @swap, where COW must stay off for dockerd's layers and
# for swapfiles. A failure is recorded as p4-partial and the boot continues.
p4_partial=""
for spec in \
    "@data:/newroot/data:rw,noatime" \
    "@docker:/newroot/opt/docker:rw,noatime,nodatacow,nodatasum" \
    "@swap:/newroot/swap:rw,noatime,nodatacow,nodatasum"
do
    subvol="${spec%%:*}"
    subvol_spec="${spec#*:}"
    target="${subvol_spec%%:*}"
    options="${subvol_spec#*:}"
    if [ "${degraded}" = "1" ]; then
        p4_partial="${p4_partial} ${subvol}"
        continue
    fi
    if ! mkdir -p "${target}" 2>/dev/null; then
        wf_log "cannot create ${target}; ${subvol} stays unmounted"
        p4_partial="${p4_partial} ${subvol}"
        continue
    fi
    if mount -o "${options},subvol=/${subvol}" "${p4}" "${target}"; then
        wf_log "mounted ${subvol} on ${target} (${options})"
    else
        wf_log "mount of ${subvol} on ${target} failed; continuing"
        p4_partial="${p4_partial} ${subvol}"
    fi
done
if [ -n "${p4_partial}" ]; then
    p4_partial="${p4_partial# }"
    wf_log "p4-partial:${p4_partial} not mounted, the boot continues"
    wf_say "[boot] action=p4-partial subvolumes=${p4_partial}"
else
    wf_log "p4 user data mounted: @data->/data @docker->/opt/docker @swap->/swap"
fi

# --------------------------------------------------------------------------- #
# 8. Probe writes: they must land in the generation's upper directory
# --------------------------------------------------------------------------- #

probe=/.s3-probe
new_file="/.s3-new-${BOOT}"

if [ "${BOOT}" = "2" ]; then
    [ -f "/newroot${probe}" ] || wf_fail probe-lost-between-boots
    case "$(cat "/newroot${probe}")" in
        *boot=1*) wf_log "first boot probe survived: $(cat "/newroot${probe}")" ;;
        *) wf_fail probe-content-unexpected ;;
    esac
fi

printf 'boot=%s slot=%s upper=%s\n' "${BOOT}" "${slot}" "${upper}" >"/newroot${probe}" \
    || wf_fail probe-write-failed
printf 'created on boot %s\n' "${BOOT}" >"/newroot${new_file}" \
    || wf_fail newfile-write-failed

if [ "${degraded}" = "1" ]; then
    wf_log "degraded boot: probe writes land in tmpfs and disappear on reboot"
fi

[ -f "/mnt/p4/upper${probe}" ] || wf_fail probe-not-in-upper
[ -f "/mnt/p4/upper${new_file}" ] || wf_fail newfile-not-in-upper
[ ! -e "/mnt/@platform${probe}" ] || wf_fail probe-leaked-to-platform
[ ! -e "/mnt/@sys${probe}" ] || wf_fail probe-leaked-to-sys
wf_log "probe writes landed in upper, not in the read-only layers"

# --------------------------------------------------------------------------- #
# 9. Hand over to the composed root
# --------------------------------------------------------------------------- #
# Which program becomes PID 1 depends on the build, not on the machine:
#
#   CI build      scripts/ci/initramfs.sh packs post.sh as /s3-post.sh when the build sets
#                 AB_CI_HOOKS=1; it becomes /.s3-post in the composed root and asserts the
#                 switch from inside it
#   production    nothing is injected, and the composed root's own /sbin/init is PID 1,
#                 exactly as on any other boot
#
# A missing hook is therefore not a failure, it is the production build. The previous
# `cp /s3-post.sh ... || wf_fail` turned every flashed machine into a poweroff at this line.
# The decision is one function so that the copy, its mode and the command line cannot drift
# apart, and so that a test can run it.

# handover_cmd <newroot> <slot> <upper> <boot>: stage the hook if it is there and print the
# command line switch_root should run. Non-zero only means the staging itself failed.
handover_cmd() {
    wf_hc_newroot="$1"
    if [ -f "${WF_POST_HOOK}" ]; then
        cp "${WF_POST_HOOK}" "${wf_hc_newroot}/.s3-post" || return 1
        chmod 0755 "${wf_hc_newroot}/.s3-post" || return 1
        printf 'switch_root %s /bin/sh /.s3-post %s %s %s' \
            "${wf_hc_newroot}" "$2" "$3" "$4"
        return 0
    fi
    printf 'switch_root %s /sbin/init' "${wf_hc_newroot}"
    return 0
}

handover="$(handover_cmd /newroot "${slot}" "${upper}" "${BOOT}")" || handover=""
if [ -z "${handover}" ]; then
    # The hook is there but could not be staged. That is still not a reason to power the
    # machine off: the composed root is complete, so it starts as it would without the hook.
    wf_log "warning: could not stage ${WF_POST_HOOK}; the composed root starts with /sbin/init"
    handover="switch_root /newroot /sbin/init"
fi
# What the breadcrumb reports is read back from the command that will run, so the line on the
# disk and the handover itself cannot name different programs.
handover_init="/.s3-post"
case "${handover}" in
    *" /sbin/init") handover_init="/sbin/init" ;;
esac
umount /esp || wf_log "warning: could not unmount the ESP"

# --------------------------------------------------------------------------- #
# 9a. The p4 side for the last two milestones: the *root* subvolume, not the layer
# --------------------------------------------------------------------------- #
# Giving the ESP back is the moment the ESP stops being able to hold a breadcrumb, and
# `esp-unmounted` / `switching-root` are exactly the two lines a boot that dies at the
# handover has to leave behind. Two ways to put them on p4, and only one of them is
# findable afterwards:
#
#   /mnt/p4        the generation's writable layer. It *is* still mounted here, and a line
#                  written there lands inside @overlay-<version>, a subvolume nothing mounts
#                  at runtime - which is why a real boot left 4 breadcrumbs in the ring log
#                  and no file at all where a human looks (`/mnt/p4/.ab/`).
#   /mnt/p4root    the root subvolume: `.ab/grow`, `.ab/esp-health` and `.ab/partitions.before`
#                  are already there, ab-boot reads that directory at runtime, and it is what
#                  a pulled disk shows. Mounted once more, read-write and without compress (the
#                  level belongs to the filesystem already), for the two lines below only, and
#                  given back before switch_root so it cannot leak into the new root.
p4_last=""
if [ "${degraded}" = "0" ] && [ -n "${p4}" ]; then
    if mount -o rw,noatime,"subvol=/" "${p4}" /mnt/p4root 2>/dev/null; then
        p4_last="/mnt/p4root"
    else
        # The root subvolume will not mount again. The generation layer is still a real btrfs
        # subvolume on the same disk, so a line there is at least on p4 and not in a tmpfs -
        # the file name stays the same (`.ab/init-fail.log`), only the directory differs.
        wf_log "warning: p4 root subvolume not mountable for the last breadcrumbs; using ${upper}"
        p4_last="/mnt/p4"
    fi
fi
# No p4 at all (a degraded boot): the zone stays empty and the last two lines go to the
# serial port. Never into the tmpfs that stands in for /mnt/p4 in that boot.
WF_P4_MOUNT="${p4_last}"
export WF_P4_MOUNT
WF_MARK_LOG="$(wf_mark_zone)"
export WF_MARK_LOG
wf_mark esp-unmounted

for fs in proc sys dev; do
    mkdir -p "/newroot/${fs}"
    # `-o move` is understood by both busybox and util-linux, but devtmpfs refuses to
    # move on some kernels, so a bind mount is used as the fallback: the old root is
    # discarded by switch_root anyway, and the nodes are the same either way.
    if ! move_err="$(mount -o move "/${fs}" "/newroot/${fs}" 2>&1)"; then
        wf_log "move of /${fs} failed (${move_err}); falling back to bind"
        mount --bind "/${fs}" "/newroot/${fs}" \
            || wf_fail "move-${fs}-failed"
    fi
done

# Milestone 8. The last line a boot can leave before PID 1 changes: whatever happens in the
# handover, the disk already says how far this boot got and which program was next.
wf_mark switching-root "init=${handover_init}"
wf_log "switching root to the overlay (${handover_init})"
# The write mount has done its job and is given back, so it cannot survive as an unreachable
# mount under the new root. The log is disarmed with it: from here there is no landing zone,
# and a breadcrumb written by a `switch_root` that returned would land in a tmpfs directory
# the initramfs takes with it. The judge line and the serial port carry that failure.
if [ "${p4_last}" = "/mnt/p4root" ]; then
    umount /mnt/p4root || wf_log "warning: p4 root subvolume is still mounted"
    WF_MARK_LOG=""
    export WF_MARK_LOG
    # The zone goes with the mount: from here /mnt/p4root is a bare directory on the tmpfs
    # again, and the evidence path of a failure in this last stretch must not pick it.
    WF_P4_MOUNT=""
    export WF_P4_MOUNT
fi
# switch_root must be PID 1, and this script is a child of the shell that the kernel
# started as init, so exec replaces the shell instead of forking a helper.
# shellcheck disable=SC2086  # the words of the command line are the argument list
# shellcheck disable=SC2093  # exec only returns when it fails; the line below handles that
exec ${handover}

# exec only returns when it fails.
wf_fail switch-root-failed
