#!/bin/sh /etc/rc.common
# ab-boot - early boot bookkeeping for the A/B slots.
#
# Runs before the network comes up. It mounts the two ESP-backed surfaces the A/B
# tooling needs (/boot for the state and the ring log, /mnt/p4 for the writable
# subvolumes), rotates the boot log, records this boot, and marks a candidate first
# boot when the pending slot is the slot we just started.
#
# The running slot comes from the kernel command line (`ab.slot=<a|b>`), which is what
# GRUB sets per menu entry; without it the committed slot is the honest assumption.
#
# Nothing here may block the boot: every failure is logged and reported through the
# exit status of the helper, not by refusing to continue.

# START is consumed by /etc/rc.common, not by this file.
# shellcheck disable=SC2034
START=15

AB_ESP=/boot
AB_P4=/mnt/p4
LOG_MAX=32768

# find_partition <partlabel> <fallback>: resolve a partition device by GPT name when
# the kernel exposes PARTNAME, falling back to the documented partition order.
find_partition() {
	_want="$1"
	_fallback="$2"
	for _event in /sys/class/block/*/uevent; do
		[ -f "${_event}" ] || continue
		case "$(sed -n 's/^DEVTYPE=//p' "${_event}")" in
			partition) : ;;
			*) continue ;;
		esac
		if [ "$(sed -n 's/^PARTNAME=//p' "${_event}")" = "${_want}" ]; then
			printf '/dev/%s' "$(basename "$(dirname "${_event}")")"
			return 0
		fi
	done
	printf '%s' "${_fallback}"
}

is_mounted() {
	awk -v mp="$1" '$2 == mp { found = 1 } END { exit !found }' /proc/mounts 2>/dev/null
}

mount_esp() {
	is_mounted "${AB_ESP}" && return 0
	mkdir -p "${AB_ESP}"
	_dev="$(find_partition ab-esp /dev/vda1)"
	ensure_dev "${_dev}"
	mount -t vfat -o rw,noatime "${_dev}" "${AB_ESP}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_ESP}"
		return 1
	}
}

# console_say <line...>: procd sends hook stdout to syslog, so milestones are also
# written to the console where the test harness can see them.
console_say() {
	printf '%s\n' "$*" >/dev/console 2>/dev/null || :
}

# ensure_dev <path>: procd may start these hooks before devtmpfs carries every node.
ensure_dev() {
	[ -b "$1" ] && return 0
	mdev -s 2>/dev/null || :
	[ -b "$1" ]
}

mount_p4() {
	is_mounted "${AB_P4}" && return 0
	mkdir -p "${AB_P4}"
	_dev="$(find_partition ab-shared /dev/vda4)"
	ensure_dev "${_dev}"
	mount -o rw,noatime "${_dev}" "${AB_P4}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_P4}"
		return 1
	}
}

# log_append <line...>: one full-file write with the documented truncation rule.
log_append() {
	_log="${AB_ESP}/ab/log/boot-0.log"
	_tmp="${_log}.tmp.$$"
	mkdir -p "${AB_ESP}/ab/log"
	[ -f "${_log}" ] && cat "${_log}" >"${_tmp}"
	printf '%s\n' "$*" >>"${_tmp}"
	if [ "$(wc -c <"${_tmp}")" -gt "${LOG_MAX}" ]; then
		_tail="${_tmp}.tail"
		tail -c $((LOG_MAX - 512)) "${_tmp}" >"${_tail}"
		printf 'TRUNCATED=1\n' >>"${_tail}"
		mv "${_tail}" "${_tmp}"
	fi
	sync
	mv "${_tmp}" "${_log}"
	sync
}

rotate_logs() {
	mkdir -p "${AB_ESP}/ab/log"
	rm -f "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-1.log" ] && mv "${AB_ESP}/ab/log/boot-1.log" "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-0.log" ] && mv "${AB_ESP}/ab/log/boot-0.log" "${AB_ESP}/ab/log/boot-1.log"
}

start() {
	mount_esp || {
		echo "ab-boot: cannot mount the ESP, slot bookkeeping disabled"
		exit 0
	}
	mount_p4 || echo "ab-boot: cannot mount the writable partition, reclamation degraded"

	rotate_logs

	status_line="$(ab-slot status 2>/dev/null)"
	field() {
		for kv in ${status_line}; do
			case "${kv}" in
				"$1="*)
					printf '%s' "${kv#*=}"
					return 0
					;;
			esac
		done
		return 1
	}

	slot="$(field slot)"
	upper="$(field upper)"
	pending="$(field pending)"
	committed="$(field committed)"
	generation="$(field generation)"
	p4="$(field p4)"
	rootfs="$(ab-slot rootfs "${slot}" 2>/dev/null)"

	log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=ok"
	console_say "ab-boot: running slot ${slot:-?} (${upper:-?}), generation ${generation:-?}, committed ${committed:-?}, p4=${p4:-?}"

	if [ "${p4}" = "degraded" ]; then
		log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=fail reason=p4-degraded action=degraded-boot"
		console_say "ab-boot: p4=degraded, writes will not survive a reboot"
	fi

	if [ -n "${pending}" ] && [ "${pending}" != "none" ] && [ "${pending}" = "${slot}" ]; then
		printf '%s %s\n' "${slot}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"${AB_ESP}/ab/candidate"
		sync
		log_append "stage=boot slot=${slot} upper=${upper} rootfs=${rootfs:-?} result=ok candidate=1"
		console_say "ab-boot: slot ${slot} is the pending slot, marking a candidate first boot"
	fi

	# The btrfs tool ships in the platform layer; prove it runs before relying on it,
	# because every reclaim, snapshot and rollback path needs it.
	btrfs_ok=0
	if command -v btrfs >/dev/null 2>&1; then
		console_say "ab-boot: btrfs-tool $(btrfs --version 2>&1 | head -n 1)"
		if btrfs subvolume list / >/dev/null 2>&1; then
			btrfs_ok=1
			log_append "stage=btrfs-check slot=${slot:-?} result=ok"
			console_say "ab-boot: btrfs=ok subvolume-list=ok"
		else
			log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=subvolume-list-failed"
			console_say "ab-boot: btrfs=fail reason=subvolume-list-failed"
		fi
	else
		log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=btrfs-tool-missing"
		console_say "ab-boot: btrfs=fail reason=btrfs-tool-missing"
	fi

	# Reclaim unreachable layers early in the boot. It must never block the boot, so
	# every outcome is logged and the return status is ignored.
	if [ "${p4}" = "ok" ] && [ "${btrfs_ok}" = "1" ]; then
		if ab-slot gc >/tmp/ab-boot-gc.log 2>&1; then
			reclaimed="$(grep -c 'ab-slot: deleting' /tmp/ab-boot-gc.log 2>/dev/null)"
			[ -n "${reclaimed}" ] || reclaimed=0
			log_append "stage=gc slot=${slot:-?} result=ok reclaimed=${reclaimed}"
			console_say "ab-boot: early reclamation removed ${reclaimed} layer(s)"
		else
			gc_reason="$(grep -o 'reason=[a-z-]*' /tmp/ab-boot-gc.log 2>/dev/null | tail -n 1)"
			log_append "stage=gc slot=${slot:-?} result=fail ${gc_reason:-reason=gc-failed}"
			console_say "ab-boot: early reclamation reported problems ${gc_reason:-}"
		fi
	fi
}
