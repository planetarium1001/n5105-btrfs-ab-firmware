#!/bin/sh /etc/rc.common
# ab-boot - early boot bookkeeping for the A/B slots.
#
# Runs before the network comes up. It mounts the two ESP-backed surfaces the A/B
# tooling needs (/boot for the state and the ring log, /mnt/p4 for the writable
# subvolumes), rotates the boot log, records this boot, heals the GRUB hint and marks
# a candidate first boot when the pending slot is the slot we just started. It also
# decides the first-boot package follow, hands it to a detached worker, and lets that
# worker reconcile the services procd gave up on while the follow was moving packages
# (see services_reconcile).
#
# The running slot comes from the kernel command line (`ab.slot=<a|b>`), which is what
# the GRUB menu entry of that slot sets; without it the committed slot is the honest
# assumption.
#
# The file that tells GRUB which slot to boot (/boot/grub/ab-slot.cfg) is rewritten
# here from ab/state.json on every boot. That is the self-heal path: the state file is
# the truth, and a power cut between the state write and the file write, a hand-edited
# state file, or a file left behind by an older boot all end up consistent again one
# boot later.
#
# Nothing here may block the boot: every failure is logged and reported through the
# exit status of the helper, not by refusing to continue.

# START is consumed by /etc/rc.common, not by this file.
# shellcheck disable=SC2034
START=15

AB_ESP="${AB_ESP:-/boot}"
AB_P4="${AB_P4:-/mnt/p4}"
# Mount table the helpers consult; overridable so a test can describe a system.
AB_MOUNTS="${AB_MOUNTS:-/proc/mounts}"
# Package follow (see packages_follow_schedule below): the library that owns the
# transaction, the network-fallback library that decides when to call it, the record that
# says whether there is anything outstanding, and the root it acts on.
AB_PACKAGES_LIB="${AB_PACKAGES_LIB:-/lib/upgrade/packages.sh}"
AB_PACKAGES_FOLLOW_LIB="${AB_PACKAGES_FOLLOW_LIB:-/lib/ab-net-probe.sh}"
AB_PACKAGES_FILE="${AB_PACKAGES_FILE:-${AB_ESP}/ab/packages}"
AB_PACKAGES_TARGET="${AB_PACKAGES_TARGET:-/}"
# Service reconciliation (see services_reconcile below): where the enabled services are
# linked, where their scripts live, how long the worker waits for procd to finish walking
# the boot scripts, and the four commands a test has to be able to take over - the uptime it
# reads, the procd query it asks, and the sleeper it waits with.
AB_BOOT_RC_DIR="${AB_BOOT_RC_DIR:-/etc/rc.d}"
AB_BOOT_INITD_DIR="${AB_BOOT_INITD_DIR:-/etc/init.d}"
AB_BOOT_SETTLE_S="${AB_BOOT_SETTLE_S:-120}"
AB_BOOT_SETTLE_WAIT_S="${AB_BOOT_SETTLE_WAIT_S:-180}"
AB_BOOT_UPTIME_FILE="${AB_BOOT_UPTIME_FILE:-/proc/uptime}"
AB_BOOT_PROCD_STATE_CMD="${AB_BOOT_PROCD_STATE_CMD:-}"
AB_BOOT_SLEEP_CMD="${AB_BOOT_SLEEP_CMD:-sleep}"
LOG_MAX=32768
export AB_ESP AB_P4 AB_MOUNTS
# The follow's variables are deliberately *not* exported: the detached worker is a
# subshell of this one, so it sees them anyway, while `ab-slot` (which ab-boot calls and
# which resolves its own AB_PACKAGES_LIB) must not inherit a path this file was pointed at.

# Partition discovery is shared: platform/lib/disk-identity.sh decides which disk this
# machine booted from and platform/lib/ab-partitions.sh turns that into device nodes.
# Neither file is duplicated here, and no device name is hard coded: a machine whose
# disk cannot be identified logs it and boots with the slots it already has.
AB_PARTITIONS_LIB="${AB_PARTITIONS_LIB:-/lib/ab-partitions.sh}"
AB_PARTITIONS_OK=0
if [ -f "${AB_PARTITIONS_LIB}" ]; then
	# shellcheck source=platform/lib/ab-partitions.sh
	. "${AB_PARTITIONS_LIB}"
	AB_PARTITIONS_OK=1
fi

# part_device <partname> <number>: the device to mount, or non-zero with a line on the
# console. The lookup itself belongs to platform/lib/ab-partitions.sh.
part_device() {
	if [ "${AB_PARTITIONS_OK}" != "1" ]; then
		console_say "ab-boot: ${AB_PARTITIONS_LIB} is missing, cannot resolve ${1}"
		return 1
	fi
	_dev="$(ab_find_partition "$1" "$2")" || {
		console_say "ab-boot: cannot identify the ${1} partition on this machine"
		return 1
	}
	ensure_dev "${_dev}" || {
		console_say "ab-boot: ${1} resolved to ${_dev}, which is not a block device"
		return 1
	}
	printf '%s' "${_dev}"
}

# record_disk: the disk this machine booted from, and how it was found, in the ring log
# and on the console. The build writes the same pair into ab/device.json, so a machine
# and an image can be compared without guessing.
record_disk() {
	if [ "${AB_PARTITIONS_OK}" != "1" ]; then
		log_append "stage=device slot=${1:-?} disk=unknown method=unavailable"
		console_say "ab-boot: stage=device slot=${1:-?} disk=unknown method=unavailable"
		return 1
	fi
	_identity="$(ab_disk_identity)" || {
		log_append "stage=device slot=${1:-?} disk=unknown method=unresolved"
		console_say "ab-boot: stage=device slot=${1:-?} disk=unknown method=unresolved"
		return 1
	}
	# "disk=<dev> method=<token>" -> the two values the log and the console report
	_disk="${_identity#disk=}"
	_disk="${_disk%% *}"
	_method="${_identity#*method=}"
	log_append "stage=device slot=${1:-?} disk=${_disk:-unknown} method=${_method:-unknown}"
	# Same key=values on the console: the serial log is what a failed CI run has, and
	# "our init really ran" is exactly what it has to prove.
	console_say "ab-boot: stage=device slot=${1:-?} disk=${_disk:-unknown} method=${_method:-unknown}"
	return 0
}

is_mounted() {
	awk -v mp="$1" '$2 == mp { found = 1 } END { exit !found }' "${AB_MOUNTS}" 2>/dev/null
}

mount_esp() {
	is_mounted "${AB_ESP}" && return 0
	mkdir -p "${AB_ESP}"
	_dev="$(part_device ab-esp 1)" || return 1
	mount -t vfat -o rw,noatime "${_dev}" "${AB_ESP}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_ESP}"
		return 1
	}
}

# Milestone lines have to reach the serial log and the local screen: the helper lives in
# the platform layer so every hook and tool writes them the same way (see
# platform/lib/ab-console.sh).
AB_CONSOLE_LIB="${AB_CONSOLE_LIB:-/lib/ab-console.sh}"
if [ ! -f "${AB_CONSOLE_LIB}" ]; then
	AB_CONSOLE_LIB="$(dirname "$0")/../../lib/ab-console.sh"
fi
if [ -f "${AB_CONSOLE_LIB}" ]; then
	# shellcheck source=platform/lib/ab-console.sh
	. "${AB_CONSOLE_LIB}"
else
	# Degraded: the platform layer is incomplete. Still say something on the console.
	console_say() {
		printf '%s\n' "$*" >/dev/console 2>/dev/null || :
	}
fi

# ensure_dev <path>: wait for procd to carry the node, and never build one here.
#
# /dev belongs to procd: it mounts the tmpfs and replays /sys/dev into it (early_dev, then
# coldplug). This hook can start before that replay has reached the partition node, so a
# node that will exist a moment later is not there yet. Waiting is the only honest option:
# the kernel has no devtmpfs (mount -t devtmpfs returns ENODEV) and the upstream busybox
# has no mdev applet, so the `mdev -s` that used to sit here could only fail silently.
# Two seconds in 0.1s steps, then report the missing node to the caller.
ensure_dev() {
	[ -b "$1" ] && return 0
	_waited=0
	while [ "${_waited}" -lt 20 ]; do
		sleep 0.1 2>/dev/null || sleep 1
		[ -b "$1" ] && return 0
		_waited=$((_waited + 1))
	done
	return 1
}

mount_p4() {
	is_mounted "${AB_P4}" && return 0
	mkdir -p "${AB_P4}"
	_dev="$(part_device ab-data 4)" || return 1
	mount -o rw,noatime "${_dev}" "${AB_P4}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_P4}"
		return 1
	}
}

# log_append <line...>: one full-file write with the documented truncation rule.
# publish_grow_log: the initramfs keeps its grow decision on p4; copy it to the ESP so a
# pulled ESP explains the boot without touching the data partition. Best effort: the log
# is diagnostics, never a boot dependency.
publish_grow_log() {
	_grow_src="${AB_P4}/.ab/grow.log"
	_grow_dst="${AB_ESP}/ab/log/grow.log"
	[ -f "${_grow_src}" ] || return 0
	mkdir -p "${AB_ESP}/ab/log" 2>/dev/null || return 0
	cat "${_grow_src}" >"${_grow_dst}.tmp.$$" 2>/dev/null || return 0
	sync
	mv "${_grow_dst}.tmp.$$" "${_grow_dst}" 2>/dev/null || return 0
	return 0
}

log_append() {
	_log="${AB_ESP}/ab/log/boot-0.log"
	_tmp="${_log}.tmp.$$"
	mkdir -p "${AB_ESP}/ab/log"
	[ -f "${_log}" ] && cat "${_log}" >"${_tmp}"
	printf '%s\n' "$*" >>"${_tmp}"
	if [ "$(wc -c <"${_tmp}")" -gt "${LOG_MAX}" ]; then
		_tail="${_tmp}.tail"
		tail -c $((LOG_MAX - 512)) "${_tmp}" >"${_tail}"
		printf 'TRUNCATED=1\n' >>"${_tail}"
		mv "${_tail}" "${_tmp}"
	fi
	sync
	mv "${_tmp}" "${_log}"
	sync
}

# candidate_attempt: the attempt count the initramfs left in the candidate marker, or 0
# when there is no marker. The marker's third field is the count; a two-field marker from an
# older image counts as attempt 1, the same reading initramfs/lib/wf.sh uses.
candidate_attempt() {
	_ca_file="${AB_ESP}/ab/candidate"
	[ -f "${_ca_file}" ] || {
		printf '0'
		return 0
	}
	_ca_line=$(cat "${_ca_file}" 2>/dev/null) || _ca_line=""
	# shellcheck disable=SC2086  # deliberate word splitting: space separated fields
	set -- ${_ca_line}
	[ "$#" -ge 1 ] || {
		printf '0'
		return 0
	}
	case "${3:-}" in
		'' | *[!0-9]*) printf '1' ;;
		*) printf '%s' "${3}" ;;
	esac
}

# publish_interrupted: the initramfs writes the one line it knows about an interrupted
# candidate boot (`slot=… attempt=… last=… result=…`) next to the marker; this is where it
# becomes a `stage=interrupted` line in the ring log, which is the file `ab-slot log` and the
# acceptance checklist read. Published once, then removed: an ESP that cannot be written
# would otherwise replay the same interruption on every boot forever.
publish_interrupted() {
	_pi_src="${AB_ESP}/ab/interrupted"
	[ -f "${_pi_src}" ] || return 0
	_pi_line=$(cat "${_pi_src}" 2>/dev/null) || _pi_line=""
	[ -n "${_pi_line}" ] || {
		rm -f "${_pi_src}" 2>/dev/null || :
		return 0
	}
	log_append "stage=interrupted ${_pi_line}"
	console_say "ab-boot: previous candidate boot did not finish (${_pi_line})"
	rm -f "${_pi_src}" 2>/dev/null || :
	return 0
}

rotate_logs() {
	mkdir -p "${AB_ESP}/ab/log"
	rm -f "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-1.log" ] && mv "${AB_ESP}/ab/log/boot-1.log" "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-0.log" ] && mv "${AB_ESP}/ab/log/boot-0.log" "${AB_ESP}/ab/log/boot-1.log"
}

# heal_slot_cfg: point GRUB at the slot ab/state.json names, and report which one.
#
# The rule and the file writer live in ab-slot (`next --write`), so the boot path and
# the state commands cannot disagree about either the format or the value.
heal_slot_cfg() {
	if _heal="$(ab-slot next --write 2>/dev/null)"; then
		log_append "stage=slot-cfg slot=${1:-?} result=ok ${_heal}"
		console_say "ab-boot: next boot runs ${_heal}"
		return 0
	fi
	log_append "stage=slot-cfg slot=${1:-?} result=fail reason=slot-cfg-not-written"
	console_say "ab-boot: could not rewrite /boot/grub/ab-slot.cfg, the menu keeps its previous entry"
	return 1
}

# resize_from_record: finish a filesystem growth the initramfs could not do.
#
# The initramfs grows p4 while the filesystem is mounted more than once, which makes
# `btrfs filesystem resize` fail with EBUSY and record `result=fail:btrfs-resize` in
# .ab/grow. Here the same filesystem is mounted exactly once, on /mnt/p4, which is the
# exclusive state btrfs-progs needs, so the growth can be finished from the running
# system. The record stays the single truth: on success it is rewritten to `done`, and
# the boot hook's own grow line then reports that.
#
# Never blocks a boot: btrfs' own output goes to ab/log/resize.log (the device can be
# asked what happened), the ring log gets one line, and every failure only logs.
# clear_stale_lock: a lock directory that no live writer can own any more, left behind by
# a power cut, a watchdog reset or a hard kill. ab-slot takes such a lock over on demand;
# clearing it here puts the fact in the ring log and keeps the first state write of this
# boot cheap. A lock of *this* boot is not touched here: it belongs to something that may
# well be running right now, and ab-slot decides that case with the owner's pid.
clear_stale_lock() {
	_lock="${AB_ESP}/ab/.lock"
	[ -d "${_lock}" ] || return 0
	if [ -f "${_lock}/owner" ]; then
		_lock_boot="$(head -n 1 "${_lock}/owner" 2>/dev/null | sed 's/ .*//')"
		_lock_now="$(cat "${AB_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" 2>/dev/null)"
		[ -n "${_lock_now}" ] || _lock_now="unknown"
		if [ -n "${_lock_boot}" ] && [ "${_lock_boot}" = "${_lock_now}" ]; then
			return 0
		fi
	fi
	rm -rf "${_lock}" 2>/dev/null || return 0
	log_append "stage=lock action=stale-lock-taken source=ab-boot"
	console_say "ab-boot: removed a state lock left behind by an earlier boot"
}

resize_from_record() {
	is_mounted "${AB_P4}" || return 0
	_resize_grow="${AB_P4}/.ab/grow"
	[ -f "${_resize_grow}" ] || return 0
	grep -q 'result=fail:btrfs-resize' "${_resize_grow}" 2>/dev/null || return 0
	mkdir -p "${AB_ESP}/ab/log" 2>/dev/null
	if btrfs filesystem resize max "${AB_P4}" >>"${AB_ESP}/ab/log/resize.log" 2>&1; then
		_resize_lba="$(sed -n 's/.*last_lba=//p' "${_resize_grow}" | head -n 1)"
		if printf 'result=done last_lba=%s\n' "${_resize_lba}" >"${_resize_grow}.tmp" 2>/dev/null &&
			mv "${_resize_grow}.tmp" "${_resize_grow}" 2>/dev/null; then
			sync 2>/dev/null || :
		else
			rm -f "${_resize_grow}.tmp" 2>/dev/null || :
		fi
		log_append "stage=resize result=ok source=ab-boot"
		console_say "ab-boot: filesystem grown to the partition size, the initramfs left it for us"
		return 0
	fi
	log_append "stage=resize result=fail:btrfs-resize source=ab-boot"
	console_say "ab-boot: filesystem growth still failing, see ab/log/resize.log"
	return 0
}

# grow_result: the first-boot growth result that the initramfs recorded on p4.
#
# The initramfs writes p4's subvolume root, so `.ab/grow` is either directly on the
# mount (subvolume mounted at /mnt/p4) or under the running slot's layer (the
# partition mounted at /mnt/p4). Both places are accepted; a missing file is the
# documented "not recorded" case and is never an error.
grow_result() {
	for _candidate in "${AB_P4}/.ab/grow" "${AB_P4}/$1/.ab/grow"; do
		case "${_candidate}" in
			"${AB_P4}//.ab/grow") continue ;;
		esac
		if [ -f "${_candidate}" ]; then
			_line="$(head -n 1 "${_candidate}" 2>/dev/null)"
			case "${_line}" in
				result=*) printf '%s' "${_line}" ;;
				*) printf 'result=unreadable' ;;
			esac
			return 0
		fi
	done
	return 1
}

# esp_health_result: the read-only ESP verdict the initramfs recorded on p4.
#
# The initramfs judges the volume before it mounts it - boot signature, the FAT's
# clean-shutdown bit, the FSInfo sector, then the mount result - and writes one line to
# `.ab/esp-health`. It lands on p4 rather than on the ESP on purpose: the verdict has to
# describe a partition that may well be the broken one. Like grow_result, both places are
# accepted (the root subvolume mounted at /mnt/p4, or the running slot's layer), and a
# missing file is the documented "not recorded" case, never an error.
esp_health_result() {
	for _candidate in "${AB_P4}/.ab/esp-health" "${AB_P4}/$1/.ab/esp-health"; do
		case "${_candidate}" in
			"${AB_P4}//.ab/esp-health") continue ;;
		esac
		if [ -f "${_candidate}" ]; then
			_line="$(head -n 1 "${_candidate}" 2>/dev/null)"
			case "${_line}" in
				esp=*) printf '%s' "${_line}" ;;
				*) printf 'esp=unrecorded' ;;
			esac
			return 0
		fi
	done
	return 1
}

# --------------------------------------------------------------------------- #
# Package follow: handed to a worker, never run here
#
# An upgrade replaces the system tree; the aligner moves world and distfeeds to match it,
# but the packages themselves were built for the base the machine came from. Following them
# is a network transaction, and this hook runs before the network - so nothing of it happens
# in this file, and no apk is run on the boot path at all. The old shape of this section
# waited for a default route inside a detached child and then reinstalled; the default route
# is not the question (a captive portal has one) and the reinstall was the wrong primitive.
#
# What this file does is the decision - this slot, this version, nothing outstanding in the
# record yet, all read from the record the upgrade published - and then it detaches
# platform/lib/ab-net-probe.sh's worker, which owns the network question, the single
# instance lock and the retry ladder (design.md §9). The boot never waits for it, and every
# outcome is one `stage=packages-refresh` line in the ring log, written by the worker.
#
# The worker's last step is the service reconciliation below: while it was moving packages,
# procd was starting the boot scripts, and a daemon that started inside that window can be
# down for the rest of the boot. That step is the one place in this file where the follow
# touches anything outside the record, and it never decides the follow's verdict.
# --------------------------------------------------------------------------- #

# packages_record_field <key>: one field of the published package record, or empty.
packages_record_field() {
	[ -r "${AB_PACKAGES_FILE}" ] || return 0
	sed -n "s/^packages=[a-z]* .* $1=\([^ ]*\).*/\1/p" "${AB_PACKAGES_FILE}" 2>/dev/null | tail -n 1
}

# packages_refresh_due <slot>: 0 when this boot should start the follow.
#
# The record's `follow=` field decides. `pending` is exactly "this base still owes a follow";
# `followed`, `failed`, `abandoned` and `never` are settled - a failed transaction is the
# user's to re-run with `ab-packages update`, and an abandoned one has already waited a day -
# and a record for another slot is another base's business.
#
# A record written before the field existed falls back to the old key: `version=` present and
# not `unknown`, this slot, and `refresh=` not equal to it (one attempt per base). That is the
# stricter of the two answers for a record that names no base, and deliberately so: without a
# version there is nothing to follow to, and starting a worker on it would be noise.
#
# The rule belongs to platform/lib/upgrade/packages.sh (`ab_packages_follow_due`) and is only
# restated here because a boot hook cannot be sourced by the hotplug hook that answers the
# same question on `ifup`, and because the boot must be able to decide without a library that
# may be missing. tests/modules/upgrade/test_net_probe.sh asserts this restatement and the one
# in platform/lib/ab-net-probe.sh agree, and that the worker defers to the owner once loaded.
packages_refresh_due() {
	AB_PACKAGES_REFRESH_DUE_VERSION=""
	[ "${AB_PACKAGES_REFRESH_TRIGGER:-1}" = "1" ] || return 1
	[ -n "${1:-}" ] || return 1
	[ -r "${AB_PACKAGES_FILE}" ] || return 1
	_version="$(packages_record_field version)"
	_slot="$(packages_record_field slot)"
	[ -z "${_slot}" ] || [ "${_slot}" = "$1" ] || return 1
	case "$(packages_record_field follow)" in
		pending)
			case "${_version}" in
				'' | unknown) _version="unknown" ;;
			esac
			AB_PACKAGES_REFRESH_DUE_VERSION="${_version}"
			return 0
			;;
		'') ;;
		*) return 1 ;;
	esac
	case "${_version}" in
		'' | unknown) return 1 ;;
	esac
	[ "$(packages_record_field refresh)" = "${_version}" ] && return 1
	AB_PACKAGES_REFRESH_DUE_VERSION="${_version}"
	return 0
}

# packages_follow_oneshot <slot> <version>: the follow without the network fallback.
#
# Called when the platform layer has no ab-net-probe.sh - a partial install, a chroot, or a
# test that only supplies the package library. It is the behaviour this hook had before the
# fallback existed: one call, and the library answers the network question for itself. The
# shipped layer carries the library, so the ladder above is what a machine runs.
packages_follow_oneshot() {
	_slot="${1:-?}"
	_version="${2:-unknown}"
	if [ ! -f "${AB_PACKAGES_LIB}" ]; then
		log_append "stage=packages-refresh slot=${_slot} result=fail reason=library-missing version=${_version}"
		console_say "ab-boot: package follow unavailable, ${AB_PACKAGES_LIB} is missing"
		return 1
	fi
	# shellcheck source=platform/lib/upgrade/packages.sh disable=SC1090
	. "${AB_PACKAGES_LIB}"
	_entry=""
	for _candidate in ab_packages_follow_if_ready ab_packages_follow ab_packages_refresh; do
		if command -v "${_candidate}" >/dev/null 2>&1; then
			_entry="${_candidate}"
			break
		fi
	done
	if [ -z "${_entry}" ]; then
		# The record keeps `follow=pending`: a library that exposes no entry has not followed
		# anything, and claiming otherwise would be the defect this unit exists to remove.
		log_append "stage=packages-refresh slot=${_slot} result=deferred reason=entry-missing version=${_version}"
		console_say "ab-boot: ${AB_PACKAGES_LIB} exposes no follow entry, the record keeps follow pending"
		return 1
	fi
	# The slot is the entry's own gate where it takes one (a follow for the other slot is
	# another base's business); the older spellings take one argument and ignore it.
	"${_entry}" "${AB_PACKAGES_TARGET}" "${_slot}"
	_rc=$?
	_state="${AB_PACKAGES_FOLLOW_STATE:-${AB_PACKAGES_REFRESH_STATE:-unknown}}"
	_reason="${AB_PACKAGES_FOLLOW_REASON:-${AB_PACKAGES_REFRESH_REASON:-unknown}}"
	_followed="${AB_PACKAGES_FOLLOW_VERSION:-${AB_PACKAGES_REFRESH_VERSION:-${_version}}}"
	log_append "stage=packages-refresh slot=${_slot} result=${_state} reason=${_reason} version=${_followed}"
	console_say "ab-boot: package follow ${_state} (${_reason}) for ${_version}"
	return "${_rc}"
}

# --------------------------------------------------------------------------- #
# Service reconciliation
#
# Measured on the reference machine on 2026-11-19: the first boot of a base that was just
# aligned moves the whole package set (one measured boot upgraded 128 packages and kept 138,
# the third-round matrix measured 168 and 97), and that window overlaps the boot scripts
# procd runs after this hook (S19 to S99). A daemon that starts inside the window finds a
# kmod missing or being replaced, fails its own initialisation, and nothing tries it again in
# this boot. dockerd was down on the same machine from 03:59Z to 05:20Z through more than 15
# machine restarts, while the machine's own record said the client was present and the daemon
# was not. A longer wait cannot repair this: procd starts each service once, so the repair has
# to be a *new* start, asked for once the boot has settled and the packages have stopped
# moving.
#
# The measured failure, from the first boot of the controlled hop on 2026-11-19:
#
#   dockerd: failed to start daemon: Error initializing network controller: error obtaining
#   controller instance: failed to register "bridge" driver: failed to add jump rules to ipv4
#   NAT table: ... Warning: Extension addrtype revision 0 not supported, missing kernel
#   module?
#
# The criterion is procd's own instance record, and it is deliberately NOT "every enabled
# service whose `running` answers non-zero". That wider rule was measured and rejected: a
# healthy boot of the reference machine has seven enabled services whose `running` answers
# non-zero, and not one of them is broken. Measured on the same machine in the same session,
# with the ubus record each one leaves behind:
#
#   system, ucitrack, gpio_switch, firewall, packet_steering, cron, openclash
#       no instance record at all - procd never reached procd_close_instance for them
#       (a one-shot script, a script that re-applies state on demand, or a start_service
#       that returned early because the machine's own configuration says nothing to do)
#   urandom_seed
#       an instance record that is not running, with exit_code=0 - it finished its job
#
# Starting those would re-run boot scripts out of procd's order, start a service the user
# turned off in its own configuration, and report `result=partial` on a machine where nothing
# is wrong, which destroys the one signal this line exists to carry.
#
# What is left after that filter is exactly the defect: an instance procd created, that is not
# running, and that exited non-zero. On the measured broken boot that set was `dockerd`
# (running=false, exit_code=1) and nothing else. The same rule covers a service that procd
# respawned into a crash loop, because such an instance also ends non-zero.
#
# Note what this deliberately does not rely on: dockerd's init script sets no
# `procd_set_param respawn`, so procd never logged a crash loop for it and never retried it.
# A rule keyed on the `s in a crash loop` line would have missed the one case that was
# measured, which is why the instance record is the signal and the log line is not.
# --------------------------------------------------------------------------- #

# boot_uptime: whole seconds since boot. A test points this at a file of its own, because
# the question the wait asks is about time and no test may spend it.
boot_uptime() {
	_bu_seconds="$(cut -d. -f1 "${AB_BOOT_UPTIME_FILE}" 2>/dev/null)"
	case "${_bu_seconds}" in
		'' | *[!0-9]*) printf '0' ;;
		*) printf '%s' "${_bu_seconds}" ;;
	esac
}

# boot_sleep <seconds>: the worker's sleeper, so a test does not wait for it.
boot_sleep() {
	case "${1:-}" in
		'' | *[!0-9]*) return 0 ;;
	esac
	[ "${1}" -gt 0 ] || return 0
	# shellcheck disable=SC2086  # deliberate: AB_BOOT_SLEEP_CMD is a command line
	${AB_BOOT_SLEEP_CMD} "${1}" 2>/dev/null || :
	return 0
}

# boot_waited_for_settle: wait, bounded, until procd has walked the boot scripts.
#
# Before procd has reached S99 every service after this hook has no instance record yet, so
# the reconcile would find nothing and could only report a zero it did not earn. Measured on
# the reference machine, procd reaches `- init complete -` at an uptime of about 19 s, so the
# default threshold of 120 s leaves room for a slower first boot. The wait is bounded because
# a machine whose uptime cannot be read must still get its one reconcile attempt.
boot_waited_for_settle() {
	_bw_settle="${AB_BOOT_SETTLE_S}"
	case "${_bw_settle}" in
		'' | *[!0-9]*) _bw_settle=120 ;;
	esac
	_bw_budget="${AB_BOOT_SETTLE_WAIT_S}"
	case "${_bw_budget}" in
		'' | *[!0-9]*) _bw_budget=180 ;;
	esac
	_bw_waited=0
	while [ "$(boot_uptime)" -lt "${_bw_settle}" ]; do
		[ "${_bw_waited}" -lt "${_bw_budget}" ] || return 1
		boot_sleep 5
		_bw_waited=$((_bw_waited + 5))
	done
	return 0
}

# services_procd_available: can this machine be asked what procd did with a service?
#
# Two things are needed and both are taken from the image rather than assumed: the ubus CLI
# and jsonfilter (which is what /lib/functions/procd.sh reads the same object with). A test
# supplies its own query, so it is always "available" there.
services_procd_available() {
	[ -n "${AB_BOOT_PROCD_STATE_CMD}" ] && return 0
	command -v ubus >/dev/null 2>&1 || return 1
	command -v jsonfilter >/dev/null 2>&1 || return 1
	return 0
}

# services_procd_state <name>: "<running> <exit>" for the first instance procd records.
#
#   0  the two values are on stdout
#   1  procd cannot be asked on this machine
#   2  procd records no instance for this service (it never reached procd_close_instance)
#
# The query is procd's own ubus object, which is what `/etc/init.d/<name> running` reads too;
# `exit_code` is the field that separates "finished its job" from "died", and `running` alone
# cannot. AB_BOOT_PROCD_STATE_CMD replaces the whole query, which is how a test drives every
# one of those three answers without a procd.
services_procd_state() {
	_sp_name="${1:?services_procd_state needs a service name}"
	if [ -n "${AB_BOOT_PROCD_STATE_CMD}" ]; then
		# shellcheck disable=SC2086  # deliberate: AB_BOOT_PROCD_STATE_CMD is a command line
		${AB_BOOT_PROCD_STATE_CMD} "${_sp_name}"
		return $?
	fi
	command -v ubus >/dev/null 2>&1 || return 1
	command -v jsonfilter >/dev/null 2>&1 || return 1
	_sp_json="$(ubus call service list "{\"name\":\"${_sp_name}\"}" 2>/dev/null)" || return 1
	_sp_running="$(printf '%s\n' "${_sp_json}" |
		jsonfilter -e "@[\"${_sp_name}\"].instances[*].running" 2>/dev/null | head -n 1)"
	# No instance is the answer for a service procd never instantiated, and it is not the same
	# fact as an instance that is down. The caller skips both, but only one of them is a
	# candidate for the repair, so the two are kept apart here rather than collapsed.
	[ -n "${_sp_running}" ] || return 2
	_sp_exit="$(printf '%s\n' "${_sp_json}" |
		jsonfilter -e "@[\"${_sp_name}\"].instances[*].exit_code" 2>/dev/null | head -n 1)"
	printf '%s %s\n' "${_sp_running}" "${_sp_exit:-0}"
	return 0
}

# services_failed: the enabled procd services that procd started and that died, one per line.
#
# A service is a candidate when it is linked into the boot sequence, its init script says
# procd owns it, and procd's record for it is an instance that is not running and that exited
# non-zero. The link is the enable state, so a service somebody enabled by hand is treated
# like any other, and one that is not linked is left alone: starting a service the user turned
# off would be this hook overriding a decision it does not own.
services_failed() {
	_sf_found=""
	for _sf_link in "${AB_BOOT_RC_DIR}"/S*; do
		[ -e "${_sf_link}" ] || continue
		_sf_name="${_sf_link##*/}"
		# `S99dockerd` -> `dockerd`; the rank is one or more digits.
		_sf_name="$(printf '%s\n' "${_sf_name}" | sed 's/^S[0-9][0-9]*//')"
		[ -n "${_sf_name}" ] || continue
		_sf_init="${AB_BOOT_INITD_DIR}/${_sf_name}"
		[ -x "${_sf_init}" ] || continue
		# A service that does not use procd is not procd's to repair, and its "not running"
		# means nothing: measured, `system` and `ucitrack` answer non-zero on a healthy boot.
		grep -q '^USE_PROCD=1' "${_sf_init}" 2>/dev/null || continue
		_sf_state="$(services_procd_state "${_sf_name}")" || continue
		_sf_running="${_sf_state%% *}"
		_sf_exit="${_sf_state#* }"
		[ "${_sf_running}" = "false" ] || continue
		case "${_sf_exit}" in
			'' | 0) continue ;;
		esac
		_sf_found="${_sf_found}${_sf_found:+ }${_sf_name}"
	done
	[ -n "${_sf_found}" ] || return 0
	printf '%s\n' "${_sf_found}" | tr ' ' '\n'
	return 0
}

# services_reconcile <slot> <follow-status>: give the daemons procd lost a second start.
#
# Called by the detached follow worker once the follow has settled, so it never holds the
# boot, and it never decides whether the follow succeeded: a service that still refuses to
# start is logged and the boot continues. What it has to make visible is whether it ran at
# all (`result=skipped` and the reason), which services procd lost (`down=`), how many starts
# it asked for (`started=`) and which starts were refused (`failed=`).
services_reconcile() {
	_sr_slot="${1:-?}"
	_sr_follow_rc="${2:-0}"
	# A follow that never settled moved nothing, so the window this repairs did not open.
	# Reporting a reconcile there would be a claim the machine cannot back with a fact.
	if [ "${_sr_follow_rc}" != "0" ]; then
		log_append "stage=services-reconciled slot=${_sr_slot} result=skipped reason=follow-unsettled"
		console_say "ab-boot: the package follow did not settle, no service to reconcile"
		return 0
	fi
	if ! boot_waited_for_settle; then
		log_append "stage=services-reconciled slot=${_sr_slot} result=skipped reason=boot-not-settled uptime=$(boot_uptime)"
		console_say "ab-boot: the boot did not settle in time, no service to reconcile"
		return 0
	fi
	# The query is answered once, up front: a machine without procd's ubus object cannot tell
	# "no service died" from "nobody looked", and the two must not produce the same line.
	if ! services_procd_available; then
		log_append "stage=services-reconciled slot=${_sr_slot} result=skipped reason=no-procd-query"
		console_say "ab-boot: procd cannot be asked, no service to reconcile"
		return 0
	fi
	_sr_down="$(services_failed)"
	# The comma-separated form is what the ring log carries; it is built from the same list the
	# loop below starts, so the two can never disagree.
	_sr_down_list="$(printf '%s\n' "${_sr_down}" | tr '\n' ',' | sed 's/,$//')"
	_sr_started=0
	_sr_failed=""
	# shellcheck disable=SC2086  # deliberate word splitting: one service name per line
	for _sr_service in ${_sr_down}; do
		if "${AB_BOOT_INITD_DIR}/${_sr_service}" start >/dev/null 2>&1; then
			_sr_started=$((_sr_started + 1))
			console_say "ab-boot: started ${_sr_service}, which procd lost during this boot"
		else
			_sr_failed="${_sr_failed}${_sr_failed:+,}${_sr_service}"
			console_say "ab-boot: ${_sr_service} is still down, its own start refused"
		fi
	done
	_sr_result=ok
	[ -z "${_sr_failed}" ] || _sr_result=partial
	log_append "stage=services-reconciled slot=${_sr_slot} result=${_sr_result} started=${_sr_started} failed=${_sr_failed:-none} down=${_sr_down_list:-none}"
	return 0
}

# packages_follow_schedule <slot>: decide now, run later, never block.
packages_follow_schedule() {
	packages_refresh_due "${1:-}" || return 0
	_slot="${1:-?}"
	_version="${AB_PACKAGES_REFRESH_DUE_VERSION:-unknown}"
	log_append "stage=packages-refresh slot=${_slot} result=scheduled version=${_version}"
	console_say "ab-boot: package follow for ${_version} starts when a feed answers"
	# Detached on purpose: stdin, stdout and stderr all point away from the boot, so rc
	# never waits for it and no test or serial log is held open by a child that sleeps.
	(
		if [ -f "${AB_PACKAGES_FOLLOW_LIB}" ]; then
			# One library for both carriers: the first boot and an `ifup` then make the same
			# decision about the network and queue behind the same lock.
			# shellcheck source=platform/lib/ab-net-probe.sh disable=SC1090
			. "${AB_PACKAGES_FOLLOW_LIB}"
			AB_NET_SAY=1
			ab_net_follow_boot "${_slot}"
			# The follow's own status is passed on and not judged here: a worker that could
			# not settle has nothing to reconcile, and one that did settles the question the
			# reconcile asks. The boot never sees either answer.
			services_reconcile "${_slot}" "$?"
			exit 0
		fi
		packages_follow_oneshot "${_slot}" "${_version}"
		services_reconcile "${_slot}" "$?"
	) </dev/null >"${AB_PACKAGES_FOLLOW_LOG:-${AB_PACKAGES_REFRESH_LOG:-/tmp/ab-packages-follow.log}}" 2>&1 &
	return 0
}

start() {
	mount_esp || {
		# Both channels: syslog for the running system, the console for the serial log,
		# which is all a failed CI run has. A silent exit here looked like "our init
		# never ran" and cost a 900 second timeout.
		console_say "ab-boot: stage=boot result=fail reason=esp-unresolved"
		echo "ab-boot: cannot mount the ESP, slot bookkeeping disabled"
		exit 0
	}
	mount_p4 || echo "ab-boot: cannot mount the writable partition, reclamation degraded"

	rotate_logs
	# The initramfs appends nothing to the ring log itself (rotation is this file's job), so
	# the one line it writes about an interrupted candidate boot is published here, right
	# after the rotation and before anything else reads the log.
	publish_interrupted
	# The initramfs buffers its grow decision on p4; publish it next to the ring log.
	publish_grow_log

	# A growth the initramfs could not finish is finished here, where the filesystem is
	# mounted once. Runs before anything reads the record, so the grow line below reports
	# what is actually true.
	clear_stale_lock
	resize_from_record

	status_line="$(ab-slot status 2>/dev/null)"
	field() {
		for kv in ${status_line}; do
			case "${kv}" in
				"$1="*)
					printf '%s' "${kv#*=}"
					return 0
					;;
			esac
		done
		return 1
	}

	slot="$(field slot)"
	upper="$(field upper)"
	pending="$(field pending)"
	committed="$(field committed)"
	generation="$(field generation)"
	p4="$(field p4)"
	rootfs="$(ab-slot rootfs "${slot}" 2>/dev/null)"

	record_disk "${slot:-?}"

	log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=ok"
	console_say "ab-boot: running slot ${slot:-?} (${upper:-?}), generation ${generation:-?}, committed ${committed:-?}, p4=${p4:-?}"

	# The state file is the truth for the menu: rewrite the runtime file before
	# anything else reads it, so a boot after a power cut starts from a consistent pair.
	heal_slot_cfg "${slot:-?}"

	# The initramfs records how the first-boot growth ended; it belongs in the ring
	# log, where the acceptance checklist and CI look for it. Missing means the
	# initramfs of that slot never ran the growth step.
	if grow="$(grow_result "${upper}")"; then
		log_append "stage=grow slot=${slot:-?} ${grow}"
		console_say "ab-boot: first boot growth ${grow}"
	else
		log_append "stage=grow slot=${slot:-?} result=unrecorded"
		console_say "ab-boot: no first boot growth result on ${AB_P4}, recorded as unrecorded"
	fi

	# The ESP was judged before the initramfs mounted it; that verdict belongs in the ring
	# log next to the growth result, where the acceptance checklist and `ab-slot status`
	# look for it. A boot that has no line reports unknown, never ok.
	if esp_health="$(esp_health_result "${upper}")"; then
		log_append "stage=esp-health slot=${slot:-?} ${esp_health}"
		console_say "ab-boot: ESP health at boot ${esp_health}"
	else
		log_append "stage=esp-health slot=${slot:-?} esp=unrecorded"
		console_say "ab-boot: no ESP health record on ${AB_P4}, recorded as unrecorded"
	fi

	if [ "${p4}" = "degraded" ]; then
		log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=fail reason=p4-degraded action=degraded-boot"
		console_say "ab-boot: p4=degraded, writes will not survive a reboot"
	fi

	if [ -n "${pending}" ] && [ "${pending}" != "none" ] && [ "${pending}" = "${slot}" ]; then
		# The initramfs owns the marker now: it writes `<slot> <start-ts> <attempt>` before
		# the root switch so a power cut in the mount window is still counted. Rewriting it
		# here would reset the counter to zero on every boot, which is the loop this
		# counter exists to stop. It is written here only when the initramfs did not.
		_candidate_attempt="$(candidate_attempt)"
		if [ "${_candidate_attempt}" = "0" ]; then
			printf '%s %s 1\n' "${slot}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"${AB_ESP}/ab/candidate"
			sync
			_candidate_attempt=1
		fi
		log_append "stage=boot slot=${slot} upper=${upper} rootfs=${rootfs:-?} result=ok candidate=1 attempt=${_candidate_attempt}"
		console_say "ab-boot: slot ${slot} is the pending slot, a candidate first boot (attempt ${_candidate_attempt})"
	fi

	# The btrfs tool ships in the platform layer; prove it runs before relying on it,
	# because every reclaim, snapshot and rollback path needs it.
	btrfs_ok=0
	if command -v btrfs >/dev/null 2>&1; then
		console_say "ab-boot: btrfs-tool $(btrfs --version 2>&1 | head -n 1)"
		# The merged root is an overlayfs, so the subvolume listing has to be asked of
		# the writable btrfs mount instead.
		_probe_mount="${AB_P4}"
		is_mounted "${_probe_mount}" || _probe_mount="/"
		if btrfs subvolume list "${_probe_mount}" >/dev/null 2>&1; then
			btrfs_ok=1
			log_append "stage=btrfs-check slot=${slot:-?} result=ok"
			console_say "ab-boot: btrfs=ok subvolume-list=ok"
		else
			log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=subvolume-list-failed"
			console_say "ab-boot: btrfs=fail reason=subvolume-list-failed"
		fi
	else
		log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=btrfs-tool-missing"
		console_say "ab-boot: btrfs=fail reason=btrfs-tool-missing"
	fi

	# Reclaim unreachable layers early in the boot. It must never block the boot, so
	# every outcome is logged and the return status is ignored.
	if [ "${p4}" = "ok" ] && [ "${btrfs_ok}" = "1" ]; then
		if ab-slot gc >/tmp/ab-boot-gc.log 2>&1; then
			reclaimed="$(grep -c 'ab-slot: deleting' /tmp/ab-boot-gc.log 2>/dev/null)"
			[ -n "${reclaimed}" ] || reclaimed=0
			log_append "stage=gc slot=${slot:-?} result=ok reclaimed=${reclaimed}"
			console_say "ab-boot: early reclamation removed ${reclaimed} layer(s)"
		else
			gc_reason="$(grep -o 'reason=[a-z-]*' /tmp/ab-boot-gc.log 2>/dev/null | tail -n 1)"
			log_append "stage=gc slot=${slot:-?} result=fail ${gc_reason:-reason=gc-failed}"
			console_say "ab-boot: early reclamation reported problems ${gc_reason:-}"
		fi
	fi

	# One follow for a base an upgrade just aligned. The network is not up yet, so the
	# decision is taken here and the work continues in a detached worker; the boot never
	# waits for it and never runs apk itself (see packages_follow_schedule).
	packages_follow_schedule "${slot:-?}"
}
