#!/bin/sh /etc/rc.common
# ab-boot - early boot bookkeeping for the A/B slots.
#
# Runs before the network comes up. It mounts the two ESP-backed surfaces the A/B
# tooling needs (/boot for the state and the ring log, /mnt/p4 for the writable
# subvolumes), rotates the boot log, records this boot, heals the GRUB hint and marks
# a candidate first boot when the pending slot is the slot we just started.
#
# The running slot comes from the kernel command line (`ab.slot=<a|b>`), which is what
# the GRUB menu entry of that slot sets; without it the committed slot is the honest
# assumption.
#
# The file that tells GRUB which slot to boot (/boot/grub/ab-slot.cfg) is rewritten
# here from ab/state.json on every boot. That is the self-heal path: the state file is
# the truth, and a power cut between the state write and the file write, a hand-edited
# state file, or a file left behind by an older boot all end up consistent again one
# boot later.
#
# Nothing here may block the boot: every failure is logged and reported through the
# exit status of the helper, not by refusing to continue.

# START is consumed by /etc/rc.common, not by this file.
# shellcheck disable=SC2034
START=15

AB_ESP="${AB_ESP:-/boot}"
AB_P4="${AB_P4:-/mnt/p4}"
# Mount table the helpers consult; overridable so a test can describe a system.
AB_MOUNTS="${AB_MOUNTS:-/proc/mounts}"
LOG_MAX=32768
export AB_ESP AB_P4 AB_MOUNTS

# Partition discovery is shared: platform/lib/disk-identity.sh decides which disk this
# machine booted from and platform/lib/ab-partitions.sh turns that into device nodes.
# Neither file is duplicated here, and no device name is hard coded: a machine whose
# disk cannot be identified logs it and boots with the slots it already has.
AB_PARTITIONS_LIB="${AB_PARTITIONS_LIB:-/lib/ab-partitions.sh}"
AB_PARTITIONS_OK=0
if [ -f "${AB_PARTITIONS_LIB}" ]; then
	# shellcheck source=platform/lib/ab-partitions.sh
	. "${AB_PARTITIONS_LIB}"
	AB_PARTITIONS_OK=1
fi

# part_device <partname> <number>: the device to mount, or non-zero with a line on the
# console. The lookup itself belongs to platform/lib/ab-partitions.sh.
part_device() {
	if [ "${AB_PARTITIONS_OK}" != "1" ]; then
		console_say "ab-boot: ${AB_PARTITIONS_LIB} is missing, cannot resolve ${1}"
		return 1
	fi
	_dev="$(ab_find_partition "$1" "$2")" || {
		console_say "ab-boot: cannot identify the ${1} partition on this machine"
		return 1
	}
	ensure_dev "${_dev}" || {
		console_say "ab-boot: ${1} resolved to ${_dev}, which is not a block device"
		return 1
	}
	printf '%s' "${_dev}"
}

# record_disk: the disk this machine booted from, and how it was found, in the ring log
# and on the console. The build writes the same pair into ab/device.json, so a machine
# and an image can be compared without guessing.
record_disk() {
	if [ "${AB_PARTITIONS_OK}" != "1" ]; then
		log_append "stage=device slot=${1:-?} disk=unknown method=unavailable"
		console_say "ab-boot: stage=device slot=${1:-?} disk=unknown method=unavailable"
		return 1
	fi
	_identity="$(ab_disk_identity)" || {
		log_append "stage=device slot=${1:-?} disk=unknown method=unresolved"
		console_say "ab-boot: stage=device slot=${1:-?} disk=unknown method=unresolved"
		return 1
	}
	# "disk=<dev> method=<token>" -> the two values the log and the console report
	_disk="${_identity#disk=}"
	_disk="${_disk%% *}"
	_method="${_identity#*method=}"
	log_append "stage=device slot=${1:-?} disk=${_disk:-unknown} method=${_method:-unknown}"
	# Same key=values on the console: the serial log is what a failed CI run has, and
	# "our init really ran" is exactly what it has to prove.
	console_say "ab-boot: stage=device slot=${1:-?} disk=${_disk:-unknown} method=${_method:-unknown}"
	return 0
}

is_mounted() {
	awk -v mp="$1" '$2 == mp { found = 1 } END { exit !found }' "${AB_MOUNTS}" 2>/dev/null
}

mount_esp() {
	is_mounted "${AB_ESP}" && return 0
	mkdir -p "${AB_ESP}"
	_dev="$(part_device ab-esp 1)" || return 1
	mount -t vfat -o rw,noatime "${_dev}" "${AB_ESP}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_ESP}"
		return 1
	}
}

# Milestone lines have to reach the serial log and the local screen: the helper lives in
# the platform layer so every hook and tool writes them the same way (see
# platform/lib/ab-console.sh).
AB_CONSOLE_LIB="${AB_CONSOLE_LIB:-/lib/ab-console.sh}"
if [ ! -f "${AB_CONSOLE_LIB}" ]; then
	AB_CONSOLE_LIB="$(dirname "$0")/../../lib/ab-console.sh"
fi
if [ -f "${AB_CONSOLE_LIB}" ]; then
	# shellcheck source=platform/lib/ab-console.sh
	. "${AB_CONSOLE_LIB}"
else
	# Degraded: the platform layer is incomplete. Still say something on the console.
	console_say() {
		printf '%s\n' "$*" >/dev/console 2>/dev/null || :
	}
fi

# ensure_dev <path>: procd may start these hooks before devtmpfs carries every node.
ensure_dev() {
	[ -b "$1" ] && return 0
	mdev -s 2>/dev/null || :
	[ -b "$1" ]
}

mount_p4() {
	is_mounted "${AB_P4}" && return 0
	mkdir -p "${AB_P4}"
	_dev="$(part_device ab-data 4)" || return 1
	mount -o rw,noatime "${_dev}" "${AB_P4}" 2>/dev/null || {
		console_say "ab-boot: could not mount ${_dev} on ${AB_P4}"
		return 1
	}
}

# log_append <line...>: one full-file write with the documented truncation rule.
log_append() {
	_log="${AB_ESP}/ab/log/boot-0.log"
	_tmp="${_log}.tmp.$$"
	mkdir -p "${AB_ESP}/ab/log"
	[ -f "${_log}" ] && cat "${_log}" >"${_tmp}"
	printf '%s\n' "$*" >>"${_tmp}"
	if [ "$(wc -c <"${_tmp}")" -gt "${LOG_MAX}" ]; then
		_tail="${_tmp}.tail"
		tail -c $((LOG_MAX - 512)) "${_tmp}" >"${_tail}"
		printf 'TRUNCATED=1\n' >>"${_tail}"
		mv "${_tail}" "${_tmp}"
	fi
	sync
	mv "${_tmp}" "${_log}"
	sync
}

rotate_logs() {
	mkdir -p "${AB_ESP}/ab/log"
	rm -f "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-1.log" ] && mv "${AB_ESP}/ab/log/boot-1.log" "${AB_ESP}/ab/log/boot-2.log"
	[ -f "${AB_ESP}/ab/log/boot-0.log" ] && mv "${AB_ESP}/ab/log/boot-0.log" "${AB_ESP}/ab/log/boot-1.log"
}

# heal_slot_cfg: point GRUB at the slot ab/state.json names, and report which one.
#
# The rule and the file writer live in ab-slot (`next --write`), so the boot path and
# the state commands cannot disagree about either the format or the value.
heal_slot_cfg() {
	if _heal="$(ab-slot next --write 2>/dev/null)"; then
		log_append "stage=slot-cfg slot=${1:-?} result=ok ${_heal}"
		console_say "ab-boot: next boot runs ${_heal}"
		return 0
	fi
	log_append "stage=slot-cfg slot=${1:-?} result=fail reason=slot-cfg-not-written"
	console_say "ab-boot: could not rewrite /boot/grub/ab-slot.cfg, the menu keeps its previous entry"
	return 1
}

# resize_from_record: finish a filesystem growth the initramfs could not do.
#
# The initramfs grows p4 while the filesystem is mounted more than once, which makes
# `btrfs filesystem resize` fail with EBUSY and record `result=fail:btrfs-resize` in
# .ab/grow. Here the same filesystem is mounted exactly once, on /mnt/p4, which is the
# exclusive state btrfs-progs needs, so the growth can be finished from the running
# system. The record stays the single truth: on success it is rewritten to `done`, and
# the boot hook's own grow line then reports that.
#
# Never blocks a boot: btrfs' own output goes to ab/log/resize.log (the device can be
# asked what happened), the ring log gets one line, and every failure only logs.
# clear_stale_lock: a lock directory that no live writer can own any more, left behind by
# a power cut, a watchdog reset or a hard kill. ab-slot takes such a lock over on demand;
# clearing it here puts the fact in the ring log and keeps the first state write of this
# boot cheap. A lock of *this* boot is not touched here: it belongs to something that may
# well be running right now, and ab-slot decides that case with the owner's pid.
clear_stale_lock() {
	_lock="${AB_ESP}/ab/.lock"
	[ -d "${_lock}" ] || return 0
	if [ -f "${_lock}/owner" ]; then
		_lock_boot="$(head -n 1 "${_lock}/owner" 2>/dev/null | sed 's/ .*//')"
		_lock_now="$(cat "${AB_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}" 2>/dev/null)"
		[ -n "${_lock_now}" ] || _lock_now="unknown"
		if [ -n "${_lock_boot}" ] && [ "${_lock_boot}" = "${_lock_now}" ]; then
			return 0
		fi
	fi
	rm -rf "${_lock}" 2>/dev/null || return 0
	log_append "stage=lock action=stale-lock-taken source=ab-boot"
	console_say "ab-boot: removed a state lock left behind by an earlier boot"
}

resize_from_record() {
	is_mounted "${AB_P4}" || return 0
	_resize_grow="${AB_P4}/.ab/grow"
	[ -f "${_resize_grow}" ] || return 0
	grep -q 'result=fail:btrfs-resize' "${_resize_grow}" 2>/dev/null || return 0
	mkdir -p "${AB_ESP}/ab/log" 2>/dev/null
	if btrfs filesystem resize max "${AB_P4}" >>"${AB_ESP}/ab/log/resize.log" 2>&1; then
		_resize_lba="$(sed -n 's/.*last_lba=//p' "${_resize_grow}" | head -n 1)"
		if printf 'result=done last_lba=%s\n' "${_resize_lba}" >"${_resize_grow}.tmp" 2>/dev/null &&
			mv "${_resize_grow}.tmp" "${_resize_grow}" 2>/dev/null; then
			sync 2>/dev/null || :
		else
			rm -f "${_resize_grow}.tmp" 2>/dev/null || :
		fi
		log_append "stage=resize result=ok source=ab-boot"
		console_say "ab-boot: filesystem grown to the partition size, the initramfs left it for us"
		return 0
	fi
	log_append "stage=resize result=fail:btrfs-resize source=ab-boot"
	console_say "ab-boot: filesystem growth still failing, see ab/log/resize.log"
	return 0
}

# grow_result: the first-boot growth result that the initramfs recorded on p4.
#
# The initramfs writes p4's subvolume root, so `.ab/grow` is either directly on the
# mount (subvolume mounted at /mnt/p4) or under the running slot's layer (the
# partition mounted at /mnt/p4). Both places are accepted; a missing file is the
# documented "not recorded" case and is never an error.
grow_result() {
	for _candidate in "${AB_P4}/.ab/grow" "${AB_P4}/$1/.ab/grow"; do
		case "${_candidate}" in
			"${AB_P4}//.ab/grow") continue ;;
		esac
		if [ -f "${_candidate}" ]; then
			_line="$(head -n 1 "${_candidate}" 2>/dev/null)"
			case "${_line}" in
				result=*) printf '%s' "${_line}" ;;
				*) printf 'result=unreadable' ;;
			esac
			return 0
		fi
	done
	return 1
}

start() {
	mount_esp || {
		# Both channels: syslog for the running system, the console for the serial log,
		# which is all a failed CI run has. A silent exit here looked like "our init
		# never ran" and cost a 900 second timeout.
		console_say "ab-boot: stage=boot result=fail reason=esp-unresolved"
		echo "ab-boot: cannot mount the ESP, slot bookkeeping disabled"
		exit 0
	}
	mount_p4 || echo "ab-boot: cannot mount the writable partition, reclamation degraded"

	rotate_logs

	# A growth the initramfs could not finish is finished here, where the filesystem is
	# mounted once. Runs before anything reads the record, so the grow line below reports
	# what is actually true.
	clear_stale_lock
	resize_from_record

	status_line="$(ab-slot status 2>/dev/null)"
	field() {
		for kv in ${status_line}; do
			case "${kv}" in
				"$1="*)
					printf '%s' "${kv#*=}"
					return 0
					;;
			esac
		done
		return 1
	}

	slot="$(field slot)"
	upper="$(field upper)"
	pending="$(field pending)"
	committed="$(field committed)"
	generation="$(field generation)"
	p4="$(field p4)"
	rootfs="$(ab-slot rootfs "${slot}" 2>/dev/null)"

	record_disk "${slot:-?}"

	log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=ok"
	console_say "ab-boot: running slot ${slot:-?} (${upper:-?}), generation ${generation:-?}, committed ${committed:-?}, p4=${p4:-?}"

	# The state file is the truth for the menu: rewrite the runtime file before
	# anything else reads it, so a boot after a power cut starts from a consistent pair.
	heal_slot_cfg "${slot:-?}"

	# The initramfs records how the first-boot growth ended; it belongs in the ring
	# log, where the acceptance checklist and CI look for it. Missing means the
	# initramfs of that slot never ran the growth step.
	if grow="$(grow_result "${upper}")"; then
		log_append "stage=grow slot=${slot:-?} ${grow}"
		console_say "ab-boot: first boot growth ${grow}"
	else
		log_append "stage=grow slot=${slot:-?} result=unrecorded"
		console_say "ab-boot: no first boot growth result on ${AB_P4}, recorded as unrecorded"
	fi

	if [ "${p4}" = "degraded" ]; then
		log_append "stage=boot slot=${slot:-?} upper=${upper:-?} rootfs=${rootfs:-?} result=fail reason=p4-degraded action=degraded-boot"
		console_say "ab-boot: p4=degraded, writes will not survive a reboot"
	fi

	if [ -n "${pending}" ] && [ "${pending}" != "none" ] && [ "${pending}" = "${slot}" ]; then
		printf '%s %s\n' "${slot}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"${AB_ESP}/ab/candidate"
		sync
		log_append "stage=boot slot=${slot} upper=${upper} rootfs=${rootfs:-?} result=ok candidate=1"
		console_say "ab-boot: slot ${slot} is the pending slot, marking a candidate first boot"
	fi

	# The btrfs tool ships in the platform layer; prove it runs before relying on it,
	# because every reclaim, snapshot and rollback path needs it.
	btrfs_ok=0
	if command -v btrfs >/dev/null 2>&1; then
		console_say "ab-boot: btrfs-tool $(btrfs --version 2>&1 | head -n 1)"
		# The merged root is an overlayfs, so the subvolume listing has to be asked of
		# the writable btrfs mount instead.
		_probe_mount="${AB_P4}"
		is_mounted "${_probe_mount}" || _probe_mount="/"
		if btrfs subvolume list "${_probe_mount}" >/dev/null 2>&1; then
			btrfs_ok=1
			log_append "stage=btrfs-check slot=${slot:-?} result=ok"
			console_say "ab-boot: btrfs=ok subvolume-list=ok"
		else
			log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=subvolume-list-failed"
			console_say "ab-boot: btrfs=fail reason=subvolume-list-failed"
		fi
	else
		log_append "stage=btrfs-check slot=${slot:-?} result=fail reason=btrfs-tool-missing"
		console_say "ab-boot: btrfs=fail reason=btrfs-tool-missing"
	fi

	# Reclaim unreachable layers early in the boot. It must never block the boot, so
	# every outcome is logged and the return status is ignored.
	if [ "${p4}" = "ok" ] && [ "${btrfs_ok}" = "1" ]; then
		if ab-slot gc >/tmp/ab-boot-gc.log 2>&1; then
			reclaimed="$(grep -c 'ab-slot: deleting' /tmp/ab-boot-gc.log 2>/dev/null)"
			[ -n "${reclaimed}" ] || reclaimed=0
			log_append "stage=gc slot=${slot:-?} result=ok reclaimed=${reclaimed}"
			console_say "ab-boot: early reclamation removed ${reclaimed} layer(s)"
		else
			gc_reason="$(grep -o 'reason=[a-z-]*' /tmp/ab-boot-gc.log 2>/dev/null | tail -n 1)"
			log_append "stage=gc slot=${slot:-?} result=fail ${gc_reason:-reason=gc-failed}"
			console_say "ab-boot: early reclamation reported problems ${gc_reason:-}"
		fi
	fi
}
