#!/bin/sh
# ab-slot - inspect and advance the A/B slot state.
#
# The state file lives on the ESP at ab/state.json and is the single source of truth
# for which slot is committed, which slot is pending and which writable layer each
# slot uses:
#
#   {
#     "generation": 2,
#     "committed": "b",
#     "pending": null,
#     "slots": {
#       "a": { "rootfs": "25.12.3", "upper": "@overlay-25.12.3" },
#       "b": { "rootfs": "25.12.2", "upper": "@overlay-25.12.2" }
#     }
#   }
#
# `generation` is an integer that only grows: it orders writable layers and drives
# reclamation, because version names do not sort correctly. The layer name is never
# derived from it.
#
# Every write is atomic: render to a temporary file in the same directory, sync, then
# rename over the state file. Concurrent invocations are excluded by an ESP directory
# lock (mkdir is atomic on vfat).
#
# The lock cannot be a bare directory: a power cut, a watchdog reset or a hard kill
# leaves it behind, and every later write would refuse with "state is locked" - an
# upgrade that can never commit. So the directory carries an owner line
# `<boot_id> <pid> <started_at>`, and a lock is taken over when no live process can be
# holding it:
#
#   * no owner file (an older layout, or a write cut short)         -> stale
#   * an owner from another boot_id (the writer died with that boot) -> stale
#   * an owner from this boot whose pid is gone (killed while writing) -> stale
#   * an owner from this boot whose pid is alive                      -> a real writer,
#                                                                       refused as before
#
# Taking over is logged, and releasing is idempotent, so the state is never left locked
# by a machine that is not running.
#
# GRUB does not read this file. It reads /boot/grub/ab-slot.cfg, a two-line GRUB
# script (`set default=<n>`, `set fallback=<m>`) that grub.cfg sources after its menu
# entries. Its value is the slot to try on the next boot: the pending slot when there
# is one, the committed slot otherwise. It is written here, through the same helper
# ab-boot uses to heal it, so the two cannot drift apart:
#
#   pending b   -> next=b, the next boot runs the candidate
#   commit b    -> next=b, the slot is no longer a candidate but it is the one to run
#   abandon     -> next=<committed>, the candidate is not tried again
#   rollback    -> next=<the other slot>, the next boot runs it
#
# The state file is the truth and the file is a hint: between the two writes the
# machine can lose power, and `ab-boot` rewrites the hint from the state file on every
# boot, so a stale file costs one boot, not a wrong slot.
#
# Subcommands:
#   status                 one machine readable line plus a human summary on stderr
#                          (boot= and esp= are the two facts a machine cannot claim without
#                          evidence: how this boot started, and what the initramfs thought
#                          of the ESP it started from)
#   commit [slot]          set committed, clear pending (default: the running slot)
#   pending <slot>         set pending, after checking the slot payload exists
#   abandon                clear pending, leave committed alone
#   rollback               commit the other slot
#   next [--write]         show which slot GRUB will boot, or rewrite it from the state
#   gc [--dry-run]         reap writable layers that nothing references
#   rootfs [slot]          print the upstream version that slot carries
#   layer <slot> <ver> <layer>  record a new version and layer for one slot
#   conflicts              print the conflict report of the last upgrade
#   log [--prev|--upgrade] print the ESP ring log
#
# Environment:
#   AB_ESP           ESP mount point            (default /boot)
#   AB_P4            writable partition mount   (default /mnt/p4)
#   AB_CMD           /proc/cmdline equivalent   (default /proc/cmdline, for tests)
#   AB_MOUNTS        mount table                (default /proc/mounts, for tests)
#   AB_SLOT_CFG      runtime slot file as this system sees it
#                    (default $AB_ESP/boot/grub/ab-slot.cfg)
#   AB_SLOT_CFG_LIB  shared writer of that file (default /lib/ab-slot-cfg.sh)
#   AB_PARTITIONS_LIB  shared partition discovery (default /lib/ab-partitions.sh)
#   AB_PACKAGES_FILE   the package-alignment verdict the last upgrade published
#                      (default $AB_ESP/ab/packages)

set -u
# Keep whatever PATH we were given in front: the running system already supplies
# these directories, and a test or a chroot can provide its own btrfs.
PATH="${PATH:+${PATH}:}/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

# The btrfs binary. Named because the PATH below ends with the system directories on
# purpose (a chroot or a test has to be able to supply its own), which also means a test
# cannot hide the tool by trimming PATH: on a machine with btrfs-progs installed it is
# found again behind any prefix. Pointing this at a path that does not exist is how the
# "no tool" branch gets exercised on a machine that has the tool.
AB_BTRFS="${AB_BTRFS:-btrfs}"

AB_ESP="${AB_ESP:-/boot}"
AB_P4="${AB_P4:-/mnt/p4}"
AB_CMD="${AB_CMD:-/proc/cmdline}"
AB_MOUNTS="${AB_MOUNTS:-/proc/mounts}"
AB_SLOT_CFG="${AB_SLOT_CFG:-${AB_ESP}/boot/grub/ab-slot.cfg}"
AB_SLOT_CFG_LIB="${AB_SLOT_CFG_LIB:-/lib/ab-slot-cfg.sh}"
AB_PARTITIONS_LIB="${AB_PARTITIONS_LIB:-/lib/ab-partitions.sh}"
AB_PACKAGES_FILE="${AB_PACKAGES_FILE:-${AB_ESP}/ab/packages}"
STATE="${AB_ESP}/ab/state.json"
LOGDIR="${AB_ESP}/ab/log"
LOCKDIR="${AB_ESP}/ab/.lock"
LOCK_OWNER="${LOCKDIR}/owner"
# Where the kernel publishes the id of this boot. Overridable so tests can describe a
# machine that has restarted.
AB_BOOT_ID_FILE="${AB_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
# Mount points the running system provides next to the overlay root.
DATA_MOUNT=/data
DOCKER_MOUNT=/opt/docker
SWAP_MOUNT=/swap

# The file writer is shared with ab-boot, the boot initramfs and the image build. A
# platform layer without it is a broken installation: the hint would silently stop
# moving, which is the failure this whole mechanism exists to prevent, so the callers
# say so.
#
# The installed path is tried first. When this tool runs from somewhere else - a mounted
# image, a chroot, the CI fixtures that drive the shipped binary against an image - the
# copy that ships next to it inside the platform layer is used instead, so the tool
# works where it is and no caller has to know the layout.
slot_cfg_lib_path() {
    _lib_base="$(basename "${AB_SLOT_CFG_LIB}")"
    _lib_self="$(dirname "$0")"
    for _lib_candidate in "${AB_SLOT_CFG_LIB}" \
        "${_lib_self}/../../lib/${_lib_base}" \
        "${_lib_self}/../lib/${_lib_base}"; do
        [ -f "${_lib_candidate}" ] || continue
        printf '%s' "${_lib_candidate}"
        return 0
    done
    return 1
}

SLOT_CFG_LIB_OK=0
if SLOT_CFG_LIB="$(slot_cfg_lib_path)"; then
    # shellcheck source=platform/lib/ab-slot-cfg.sh
    . "${SLOT_CFG_LIB}"
    SLOT_CFG_LIB_OK=1
fi

# Partition discovery is shared with ab-boot, ab-commit and the upgrade adapter. status
# reports what it found; nothing here invents a device name.
PARTITIONS_LIB_OK=0
if [ -f "${AB_PARTITIONS_LIB}" ]; then
    # shellcheck source=platform/lib/ab-partitions.sh
    . "${AB_PARTITIONS_LIB}"
    PARTITIONS_LIB_OK=1
fi

say() {
    printf '%s\n' "$*" >&2
}

die() {
    say "ab-slot: $*"
    exit 1
}

usage() {
    say "usage: ab-slot status|commit [slot]|pending <slot>|abandon|rollback|next [--write]|gc [--dry-run]|rootfs [slot]|layer <slot> <ver> <layer>|conflicts|log [--prev|--upgrade]|packages [list|snapshot|upgrade|revert [--to <id>]]"
    exit 2
}

# --------------------------------------------------------------------------- #
# State reading
#
# Same sed-on-squeezed-JSON approach as the boot initramfs, so one format has one
# parser. Every reader returns non-zero instead of guessing.
# --------------------------------------------------------------------------- #

squeeze() {
    tr -d ' \t\r\n' <"${STATE}"
}

state_field() {
    squeeze | sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p"
}

state_slot_field() {
    _obj="$(squeeze | sed -n "s/.*\"$1\":{\\([^}]*\\)}.*/\\1/p")"
    [ -n "${_obj}" ] || return 1
    printf '%s' "${_obj}" | sed -n "s/.*\"$2\":\"\\([^\"]*\\)\".*/\\1/p"
}

state_number() {
    squeeze | sed -n "s/.*\"$1\":\\([0-9][0-9]*\\).*/\\1/p"
}

state_committed() {
    _v="$(state_field committed)" || return 1
    [ -n "${_v}" ] || return 1
    printf '%s' "${_v}"
}

# state_pending: "none" when the pending field is null.
state_pending() {
    _raw="$(squeeze)"
    case "${_raw}" in
        *'"pending":null'*) printf 'none' ;;
        *'"pending":"'*)
            printf '%s' "${_raw}" | sed -n 's/.*"pending":"\([^"]*\)".*/\1/p'
            ;;
        *) return 1 ;;
    esac
}

state_generation() {
    _v="$(state_number generation)" || return 1
    [ -n "${_v}" ] || return 1
    printf '%s' "${_v}"
}

state_upper() {
    _v="$(state_slot_field "$1" upper)" || return 1
    [ -n "${_v}" ] || return 1
    printf '%s' "${_v}"
}

state_rootfs() {
    _v="$(state_slot_field "$1" rootfs)" || return 1
    [ -n "${_v}" ] || return 1
    printf '%s' "${_v}"
}

require_state() {
    [ -f "${STATE}" ] || die "state file not found: ${STATE}"
}

# --------------------------------------------------------------------------- #
# State writing
# --------------------------------------------------------------------------- #

# boot_id: the kernel's name for this boot, or "unknown" where there is none.
boot_id() {
    _bid="$(cat "${AB_BOOT_ID_FILE}" 2>/dev/null)"
    [ -n "${_bid}" ] || _bid="unknown"
    printf '%s' "${_bid}"
}

# lock_is_stale: no live process can be holding this lock any more.
lock_is_stale() {
    [ -d "${LOCKDIR}" ] || return 1
    [ -f "${LOCK_OWNER}" ] || return 0
    _owner_line="$(head -n 1 "${LOCK_OWNER}" 2>/dev/null)"
    [ -n "${_owner_line}" ] || return 0
    _owner_boot="${_owner_line%% *}"
    _owner_rest="${_owner_line#* }"
    _owner_pid="${_owner_rest%% *}"
    if [ "${_owner_boot}" != "$(boot_id)" ]; then
        return 0
    fi
    case "${_owner_pid}" in
        '' | *[!0-9]*) return 0 ;;
    esac
    # Same boot: the writer is still there, or it was killed mid-write.
    kill -0 "${_owner_pid}" 2>/dev/null || return 0
    return 1
}

# release_lock: idempotent, safe to call twice or from a trap.
release_lock() {
    rm -rf "${LOCKDIR}" 2>/dev/null || :
    return 0
}

lock_state() {
    mkdir -p "${AB_ESP}/ab" || die "cannot create ${AB_ESP}/ab"
    _lock_try=0
    while :; do
        if mkdir "${LOCKDIR}" 2>/dev/null; then
            printf '%s %s %s\n' "$(boot_id)" "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
                >"${LOCK_OWNER}" 2>/dev/null || :
            sync 2>/dev/null || :
            # Whatever happens next - a normal exit, an error, a signal - the lock goes
            # with this process. A killed writer is still covered by lock_is_stale.
            trap 'release_lock' EXIT INT TERM
            return 0
        fi
        _lock_try=$((_lock_try + 1))
        if lock_is_stale; then
            say "ab-slot: taking over a stale lock (action=stale-lock-taken)"
            release_lock
            [ "${_lock_try}" -lt 5 ] || die "cannot take over the stale lock at ${LOCKDIR}"
            continue
        fi
        die "state is locked by another process"
    done
}

# write_state <generation> <committed> <pending|none> [<slot> <rootfs> <upper>]
# The optional triple replaces one slot's recorded version and layer.
write_state() {
    _gen="$1"
    _committed="$2"
    _pending="$3"
    _rootfs_a="$(state_rootfs a)" || die "state has no rootfs for slot a"
    _rootfs_b="$(state_rootfs b)" || die "state has no rootfs for slot b"
    _upper_a="$(state_upper a)" || die "state has no layer for slot a"
    _upper_b="$(state_upper b)" || die "state has no layer for slot b"
    if [ "$#" -ge 6 ]; then
        case "$4" in
            a) _rootfs_a="$5"; _upper_a="$6" ;;
            b) _rootfs_b="$5"; _upper_b="$6" ;;
            *) die "invalid slot override: $4" ;;
        esac
    fi

    _tmp="${STATE}.tmp.$$"
    {
        printf '{\n'
        printf '  "generation": %s,\n' "${_gen}"
        printf '  "committed": "%s",\n' "${_committed}"
        if [ "${_pending}" = "none" ]; then
            printf '  "pending": null,\n'
        else
            printf '  "pending": "%s",\n' "${_pending}"
        fi
        printf '  "slots": {\n'
        printf '    "a": { "rootfs": "%s", "upper": "%s" },\n' "${_rootfs_a}" "${_upper_a}"
        printf '    "b": { "rootfs": "%s", "upper": "%s" }\n' "${_rootfs_b}" "${_upper_b}"
        printf '  }\n'
        printf '}\n'
    } >"${_tmp}" || die "cannot write ${_tmp}"
    sync
    mv "${_tmp}" "${STATE}" || die "cannot replace ${STATE}"
    sync
}

# --------------------------------------------------------------------------- #
# Next boot
#
# One rule, one place: the next boot runs the pending slot when there is one, the
# committed slot otherwise. Everything that needs to know which slot GRUB should try
# asks here, so the four state commands and ab-boot's self-heal cannot disagree.
# --------------------------------------------------------------------------- #

next_slot() {
    _next_pending="$(state_pending)" || return 1
    case "${_next_pending}" in
        a | b) printf '%s' "${_next_pending}" ;;
        none) state_committed ;;
        *) return 1 ;;
    esac
}

# slot_cfg_sync: rewrite the runtime file from the state file and read it back.
# Prints the slot it points at. Non-zero means the file and the state may disagree.
#
# The committed slot is written as the fallback and the slot to try as the default, so
# a file cut short after its first line still falls back to the committed slot.
slot_cfg_sync() {
    [ "${SLOT_CFG_LIB_OK}" = "1" ] || return 1
    _sync_committed="$(state_committed)" || return 1
    _sync_slot="$(next_slot)" || return 1
    ab_slot_cfg_write "${AB_SLOT_CFG}" "${_sync_committed}" "${_sync_slot}" || return 1
    _sync_pair="$(ab_slot_cfg_check_pair "${AB_SLOT_CFG}" "${_sync_committed}")" || return 1
    [ "${_sync_pair%% *}" = "${_sync_slot}" ] || return 1
    printf '%s' "${_sync_slot}"
}

# sync_or_die: the state is already written, so a failure here is reported but the
# state stays authoritative; ab-boot heals the file on the next boot.
sync_or_die() {
    if ! _sync_value="$(slot_cfg_sync)"; then
        say "ab-slot: the state file was updated but ${AB_SLOT_CFG} was not (writer: ${SLOT_CFG_LIB:-${AB_SLOT_CFG_LIB}, not found}); the next boot keeps the committed entry until ab-boot heals it${AB_SLOT_CFG_REASON:+ (${AB_SLOT_CFG_REASON})}"
        exit 1
    fi
    say "ab-slot: the next boot runs slot ${_sync_value}"
}

# --------------------------------------------------------------------------- #
# Helpers
# --------------------------------------------------------------------------- #

# running_slot: the slot the kernel command line says we booted, falling back to the
# committed slot. GRUB passes ab.slot=<a|b>; without it the committed slot is the
# honest assumption.
running_slot() {
    _committed="$(state_committed)" || die "state has no committed slot"
    _from_cmd=""
    for _arg in $(cat "${AB_CMD}" 2>/dev/null); do
        case "${_arg}" in
            ab.slot=*) _from_cmd="${_arg#ab.slot=}" ;;
        esac
    done
    case "${_from_cmd}" in
        a | b) printf '%s' "${_from_cmd}" ;;
        "") printf '%s' "${_committed}" ;;
        *) die "invalid ab.slot=${_from_cmd} on the kernel command line" ;;
    esac
}

other_slot() {
    case "$1" in
        a) printf 'b' ;;
        b) printf 'a' ;;
        *) die "invalid slot: $1" ;;
    esac
}

# slot_payload_present <slot>: the ESP carries the kernel and initrd for that slot.
slot_payload_present() {
    [ -f "${AB_ESP}/vmlinuz-$1" ] && [ -f "${AB_ESP}/initrd-$1" ]
}

# mount_state <mount point>: ok when that mount point carries a mount, missing when it
# does not. The running system provides /data, /opt/docker and /swap next to the
# overlay root; a missing one is reported, never fatal.
mount_state() {
    if awk -v mp="$1" '$2 == mp { found = 1 } END { exit !found }' "${AB_MOUNTS}" 2>/dev/null; then
        printf 'ok'
    else
        printf 'missing'
    fi
}

# p4_state: ok when the writable partition is mounted, degraded otherwise.
p4_state() {
    if awk -v mp="${AB_P4}" '$2 == mp { found = 1 } END { exit !found }' "${AB_MOUNTS}" 2>/dev/null; then
        printf 'ok'
    else
        printf 'degraded'
    fi
}

# boot_state: how this boot started, as the ring log recorded it.
#
# `ab-boot` writes one `stage=boot` line per boot, and the line for a boot that came up
# without the writable partition carries `action=degraded-boot`: the upper is a tmpfs and
# every write is lost on the next reboot. boot-0.log is the ring the running boot writes
# (rotate_logs moves it to boot-1.log at the start of the next one), so it is the only
# file that can answer for *this* boot.
#
# A missing or unreadable log is `unknown`, never `ok`. The field exists so that a
# machine cannot claim a healthy boot it has no evidence for - a silent `ok` after a
# boot that never wrote a line is exactly the failure this reports.
boot_state() {
    _boot_log="${LOGDIR}/boot-0.log"
    [ -f "${_boot_log}" ] || {
        printf 'unknown'
        return 0
    }
    [ -r "${_boot_log}" ] || {
        printf 'unknown'
        return 0
    }
    while IFS= read -r _boot_line; do
        case "${_boot_line}" in
            *stage=boot*) ;;
            *) continue ;;
        esac
        case "${_boot_line}" in
            *action=degraded-boot*)
                printf 'degraded'
                return 0
                ;;
        esac
    done <"${_boot_log}"
    printf 'ok'
}

# esp_health_state: the initramfs' read-only verdict on the ESP, as this boot recorded it.
#
# The initramfs judges the volume before mounting it and leaves one line on p4; ab-boot
# republishes it as `stage=esp-health ... esp=<token>` in the ring log. This boot's ring log
# is the only file that can answer for *this* boot, so it is read the same way boot_state
# reads it, and the value is restricted to the three tokens the probe produces: a line that
# says `esp=unrecorded`, or a log written by an older image, is reported as `unknown` rather
# than passed on as if it were a verdict. A missing log is `unknown`, never `ok`.
esp_health_state() {
	_esp_log="${LOGDIR}/boot-0.log"
	[ -r "${_esp_log}" ] || {
		printf 'unknown'
		return 0
	}
	while IFS= read -r _esp_line; do
		case "${_esp_line}" in
			*stage=esp-health*) ;;
			*) continue ;;
		esac
		for _esp_kv in ${_esp_line}; do
			case "${_esp_kv}" in
				esp=ok | esp=dirty | esp=unreadable)
					printf '%s' "${_esp_kv#esp=}"
					return 0
					;;
			esac
		done
	done <"${_esp_log}"
	printf 'unknown'
}

# packages_state: whether the running slot's package metadata describes the version it
# runs, as the last upgrade published it (platform/lib/upgrade/packages.sh). `aligned`
# means "world pins this kernel and distfeeds name this release", not "the feeds are
# reachable": the alignment is offline on purpose, so a machine that upgrades without a
# network is still aligned. A missing or unreadable record is `unknown`, never `aligned`,
# for the same reason boot= and esp= refuse to claim a boot nothing recorded.
packages_state() {
    _pkg_file="${AB_PACKAGES_FILE}"
    [ -r "${_pkg_file}" ] || {
        printf 'unknown'
        return 0
    }
    # The record describes the slot an upgrade was aiming at. Until that slot is committed
    # and running, its verdict says nothing about this boot, so a record for another slot is
    # reported as unknown rather than as this slot's state.
    _pkg_slot="$(sed -n 's/^packages=[a-z]* .* slot=\([ab]\).*/\1/p' "${_pkg_file}" 2>/dev/null | tail -n 1)"
    if [ -n "${_pkg_slot}" ]; then
        _pkg_running="$(running_slot 2>/dev/null)" || _pkg_running=""
        [ "${_pkg_slot}" = "${_pkg_running}" ] || {
            printf 'unknown'
            return 0
        }
    fi
    _pkg_state="$(sed -n 's/^packages=\([a-z]*\).*/\1/p' "${_pkg_file}" 2>/dev/null | tail -n 1)"
    case "${_pkg_state}" in
        aligned | limited) printf '%s' "${_pkg_state}" ;;
        *) printf 'unknown' ;;
    esac
}

# packages_reason: why the state is `limited` (a token from the aligner), `none` when the
# metadata is aligned and `unknown` when there is no record at all.
packages_reason() {
    _pkg_file="${AB_PACKAGES_FILE}"
    [ -r "${_pkg_file}" ] || {
        printf 'unknown'
        return 0
    }
    _pkg_slot="$(sed -n 's/^packages=[a-z]* .* slot=\([ab]\).*/\1/p' "${_pkg_file}" 2>/dev/null | tail -n 1)"
    if [ -n "${_pkg_slot}" ]; then
        _pkg_running="$(running_slot 2>/dev/null)" || _pkg_running=""
        if [ "${_pkg_slot}" != "${_pkg_running}" ]; then
            printf 'other-slot'
            return 0
        fi
    fi
    _pkg_reason="$(sed -n 's/^packages=[a-z]* reason=\([^ ]*\).*/\1/p' "${_pkg_file}" 2>/dev/null | tail -n 1)"
    [ -n "${_pkg_reason}" ] || _pkg_reason="unknown"
    printf '%s' "${_pkg_reason}"
}

# --------------------------------------------------------------------------- #
# Subcommands
# --------------------------------------------------------------------------- #

cmd_status() {
    require_state
    _slot="$(running_slot)"
    _committed="$(state_committed)" || die "state has no committed slot"
    _pending="$(state_pending)" || die "state has no pending field"
    _generation="$(state_generation)" || die "state has no generation"
    _upper="$(state_upper "${_slot}")" || die "state has no layer for slot ${_slot}"
    _p4="$(p4_state)"
    _boot="$(boot_state)"
    _esp="$(esp_health_state)"
    # boot= is one token; the human line says what the token means, so nobody has to
    # look up that a degraded boot is a tmpfs upper.
    _boot_hint=""
    [ "${_boot}" = "degraded" ] && _boot_hint=", the writable layer is a tmpfs and writes will not survive a reboot"
    [ "${_boot}" = "unknown" ] && _boot_hint=", no readable ring log, so nothing here proves it came up clean"
    _packages="$(packages_state)"
    _packages_reason="$(packages_reason)"
    _data="$(mount_state "${DATA_MOUNT}")"
    _docker="$(mount_state "${DOCKER_MOUNT}")"
    _swap="$(mount_state "${SWAP_MOUNT}")"
    # What GRUB will do next, read back from the file it sources.
    _next="$(ab_slot_cfg_get "${AB_SLOT_CFG}" 2>/dev/null)" || _next="unknown"
    # Which disk this machine is, and how that was established: the shared discovery
    # answer, never a guess made here. A missing helper and an unresolved disk are
    # reported differently, because they call for different fixes.
    if [ "${PARTITIONS_LIB_OK}" = "1" ] && [ "${AB_DISK_IDENTITY_OK:-0}" = "1" ]; then
        _identity="$(ab_disk_identity 2>/dev/null)" || _identity="disk=unknown method=unresolved"
    else
        _identity="disk=unknown method=unavailable"
    fi

    # esp= is appended after boot=, never inserted: the fields before it are parsed by
    # pattern elsewhere (platform/lib/upgrade/platform.sh takes upper= by regex) and the
    # human line below reads as one sentence about this boot.
    printf 'slot=%s upper=%s generation=%s committed=%s pending=%s p4=%s data=%s docker=%s swap=%s next=%s %s boot=%s esp=%s packages=%s packages_reason=%s\n' \
        "${_slot}" "${_upper}" "${_generation}" "${_committed}" "${_pending}" "${_p4}" \
        "${_data}" "${_docker}" "${_swap}" "${_next}" "${_identity}" "${_boot}" "${_esp}" \
        "${_packages}" "${_packages_reason}"
    say "ab-slot: running slot ${_slot} (${_upper}), generation ${_generation}"
    say "ab-slot: committed ${_committed}, pending ${_pending}, writable layer ${_p4}"
    say "ab-slot: mounts data=${_data} docker=${_docker} swap=${_swap}"
    say "ab-slot: this boot is ${_boot}${_boot_hint}"
    say "ab-slot: the ESP was ${_esp} when the initramfs mounted it"
    # One sentence the user can act on: "aligned" is what makes `apk add <kmod>` work for
    # the kernel this slot runs; a limited slot boots fine and cannot install matched
    # packages.
    _packages_hint=""
    case "${_packages}" in
        aligned) _packages_hint=", packages matched to this kernel" ;;
        limited) _packages_hint=", package metadata is limited (${_packages_reason}): installing packages for this kernel needs it fixed first" ;;
        *) _packages_hint=", no upgrade recorded package metadata, so nothing here proves it matches" ;;
    esac
    say "ab-slot: packages ${_packages}${_packages_hint}"
    say "ab-slot: the next boot runs slot ${_next}, ${_identity}"
}

cmd_commit() {
    require_state
    _slot="${1:-$(running_slot)}"
    case "${_slot}" in
        a | b) : ;;
        *) die "invalid slot: ${_slot}" ;;
    esac
    lock_state
    _generation="$(state_generation)" || die "state has no generation"
    # A pending slot that is not the one being committed is a staged upgrade for the
    # next boot; committing the running slot must not erase that marker. The name is
    # distinct on purpose: write_state sets its own _pending.
    _keep_pending="$(state_pending 2>/dev/null || printf 'none')"
    [ "${_keep_pending}" = "${_slot}" ] && _keep_pending="none"
    write_state "${_generation}" "${_slot}" "${_keep_pending}"
    if [ "${_keep_pending}" = "none" ]; then
        say "ab-slot: committed slot ${_slot}, pending cleared"
    else
        say "ab-slot: committed slot ${_slot}, pending ${_keep_pending} kept"
    fi
    sync_or_die
}

cmd_pending() {
    require_state
    [ "$#" -ge 1 ] || die "pending needs a slot"
    _slot="$1"
    case "${_slot}" in
        a | b) : ;;
        *) die "invalid slot: ${_slot}" ;;
    esac
    slot_payload_present "${_slot}" \
        || die "slot ${_slot} has no kernel or initrd on ${AB_ESP}, refusing to mark it pending"
    lock_state
    _generation="$(state_generation)" || die "state has no generation"
    _committed="$(state_committed)" || die "state has no committed slot"
    write_state "${_generation}" "${_committed}" "${_slot}"
    say "ab-slot: slot ${_slot} is pending, next boot will try it"
    sync_or_die
}

cmd_abandon() {
    require_state
    lock_state
    _generation="$(state_generation)" || die "state has no generation"
    _committed="$(state_committed)" || die "state has no committed slot"
    write_state "${_generation}" "${_committed}" "none"
    say "ab-slot: pending cleared, slot ${_committed} stays committed"
    sync_or_die
}

cmd_rollback() {
    require_state
    lock_state
    _generation="$(state_generation)" || die "state has no generation"
    _committed="$(state_committed)" || die "state has no committed slot"
    _target="$(other_slot "${_committed}")"
    _from="${_committed}"
    write_state "${_generation}" "${_target}" "none"
    say "ab-slot: rolled back from slot ${_from} to slot ${_target}"
    sync_or_die
}

# cmd_next [--write]: show which slot GRUB will boot, or rewrite the runtime file from
# the state file. ab-boot calls --write on every boot, which is the self-heal path:
# the state file is the truth, so a file left behind by a power cut is corrected here.
cmd_next() {
    require_state
    _write=0
    for _arg in "$@"; do
        case "${_arg}" in
            --write) _write=1 ;;
            *) die "unknown argument: ${_arg}" ;;
        esac
    done
    if [ "${_write}" = "1" ]; then
        if ! _next="$(slot_cfg_sync)"; then
            die "cannot write ${AB_SLOT_CFG}${AB_SLOT_CFG_REASON:+ (${AB_SLOT_CFG_REASON})}"
        fi
        printf 'next=%s\n' "${_next}"
        return 0
    fi
    [ "${SLOT_CFG_LIB_OK}" = "1" ] || die "runtime slot file helper not found: ${AB_SLOT_CFG_LIB}"
    _now="$(ab_slot_cfg_get "${AB_SLOT_CFG}" 2>/dev/null)" || _now="unknown"
    printf 'next=%s\n' "${_now}"
}

# cmd_gc [--dry-run]
#
# Reference set: the layers named by both slots plus the pending slot. Anything else
# on the writable partition is unreachable and gets deleted. Four safety rules:
#   1. never delete a layer that is currently mounted
#   2. never delete the layer referenced by pending
#   3. delete with -C and follow with a sync, so space actually comes back
#   4. never run a balance here; it needs free space it may not have
cmd_gc() {
    require_state
    _dry_run=0
    for _arg in "$@"; do
        case "${_arg}" in
            --dry-run) _dry_run=1 ;;
            *) die "unknown argument: ${_arg}" ;;
        esac
    done
    [ -d "${AB_P4}" ] || die "writable partition is not mounted at ${AB_P4}"
    # Without the tool there is nothing to reclaim *with*: say so instead of
    # reporting an empty, successful pass.
    command -v "${AB_BTRFS}" >/dev/null 2>&1 || {
        say "ab-slot: btrfs tool not found, reclamation skipped"
        say "reason=btrfs-tool-missing"
        exit 1
    }

    _keep_a="$(state_upper a)" || die "state has no layer for slot a"
    _keep_b="$(state_upper b)" || die "state has no layer for slot b"
    _pending="$(state_pending)" || die "state has no pending field"

    _layers="$("${AB_BTRFS}" subvolume list "${AB_P4}" 2>/dev/null | sed -n 's/.* path @overlay-.*/&/p' | sed -n 's/.* path //p' | sort)"
    [ -n "${_layers}" ] || { say "ab-slot: no writable layers found"; return 0; }

    for _layer in ${_layers}; do
        _referenced=0
        [ "${_layer}" = "${_keep_a}" ] && _referenced=1
        [ "${_layer}" = "${_keep_b}" ] && _referenced=1
        if [ "${_pending}" != "none" ] && [ "${_layer}" = "$(state_upper "${_pending}" 2>/dev/null)" ]; then
            _referenced=1
        fi
        if [ "${_referenced}" = "1" ]; then
            say "ab-slot: keep ${_layer} (referenced)"
            continue
        fi
        if awk -v want="${_layer}" 'index($0, "/" want) { found = 1 } END { exit !found }' /proc/mounts; then
            say "ab-slot: keep ${_layer} (mounted)"
            continue
        fi
        if [ "${_dry_run}" = "1" ]; then
            say "ab-slot: would delete ${_layer}"
            continue
        fi
        say "ab-slot: deleting ${_layer}"
        "${AB_BTRFS}" subvolume delete -C "${AB_P4}/${_layer}" >/dev/null || die "cannot delete ${_layer}"
        "${AB_BTRFS}" subvolume sync "${AB_P4}" >/dev/null 2>&1
    done
}

# cmd_layer <slot> <rootfs> <upper>: record a new version and layer for one slot and
# bump the generation, which only orders layers; it never names them.
cmd_layer() {
    require_state
    [ "$#" -ge 3 ] || die "layer needs <slot> <rootfs> <upper>"
    _slot="$1"
    _rootfs="$2"
    _upper="$3"
    case "${_slot}" in
        a | b) : ;;
        *) die "invalid slot: ${_slot}" ;;
    esac
    case "${_upper}" in
        @overlay-?*) : ;;
        *) die "layer name must start with @overlay-: ${_upper}" ;;
    esac
    lock_state
    _generation="$(state_generation)" || die "state has no generation"
    _committed="$(state_committed)" || die "state has no committed slot"
    _pending="$(state_pending)" || die "state has no pending field"
    write_state "$((_generation + 1))" "${_committed}" "${_pending}" "${_slot}" "${_rootfs}" "${_upper}"
    say "ab-slot: slot ${_slot} now carries ${_rootfs} on ${_upper} (generation $((_generation + 1)))"
}

# cmd_conflicts: print the conflict report of the last upgrade.
cmd_conflicts() {
    _report="${LOGDIR}/conflicts.log"
    [ -f "${_report}" ] || {
        say "ab-slot: no ${_report}"
        exit 1
    }
    cat "${_report}"
}

# cmd_rootfs [slot]: the upstream version a slot carries.
cmd_rootfs() {
    _slot="${1:-}"
    if [ -z "${_slot}" ]; then
        _slot="$(running_slot)"
    fi
    case "${_slot}" in
        a | b) : ;;
        *) die "invalid slot: ${_slot}" ;;
    esac
    state_rootfs "${_slot}" || die "state has no rootfs for slot ${_slot}"
}

# cmd_log [--prev|--upgrade]
cmd_log() {
    _target="boot-0.log"
    for _arg in "$@"; do
        case "${_arg}" in
            --prev) _target="boot-1.log" ;;
            --upgrade) _target="upgrade.log" ;;
            *) die "unknown argument: ${_arg}" ;;
        esac
    done
    [ -f "${LOGDIR}/${_target}" ] || {
        say "ab-slot: no ${_target} in ${LOGDIR}"
        exit 1
    }
    cat "${LOGDIR}/${_target}"
}

# --------------------------------------------------------------------------- #
# Packages: the writable layer's package world, as a thing you can snapshot,
# re-resolve and roll back - separately from the slot generation.
#
# The slot is the unit of a system update: rolling one back means booting the other
# slot. Packages need their own unit, because a package rollback is a same-base
# operation: it replays versions apk can still fetch. `ab-slot packages upgrade` never
# touches ab/state.json and never switches slots, and `revert` refuses to cross a base,
# where those versions would be built against a different kernel and libc.
# --------------------------------------------------------------------------- #

packages_lib() {
    _lib="${AB_PACKAGES_LIB:-/lib/upgrade/packages.sh}"
    [ -f "${_lib}" ] || die "packages-library-missing"
    # shellcheck source=platform/lib/upgrade/packages.sh
    . "${_lib}"
}

packages_layer() {
    _slot="$(running_slot)" || die "state has no running slot"
    _upper="$(state_upper "${_slot}")" || die "state has no layer for slot ${_slot}"
    printf '%s/%s' "${AB_P4}" "${_upper}"
}

# packages_alignment: the same function `status` prints, called directly so the gate
# cannot drift from what the operator sees and no other probe has to run first.
packages_alignment() {
    packages_state
}

# packages_apk_supported: apk exists *and* answers like apk-tools. The distinction
# matters: `name=version` installs and `apk info` output are apk-tools shapes, and a
# different `apk` on PATH would fail later with a message nobody can act on.
packages_apk_supported() {
    command -v apk >/dev/null 2>&1 || return 1
    _apkver=$(apk --version 2>/dev/null | head -n 1)
    case "${_apkver}" in
        apk-tools*) return 0 ;;
        *) return 1 ;;
    esac
}

packages_log() {
    mkdir -p "${LOGDIR}" 2>/dev/null || :
    printf '%s packages-upgrade %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"${LOGDIR}/upgrade.log" 2>/dev/null || :
}

packages_release_value() {
    _rel="${AB_PLATFORM_RELEASE:-/etc/platform-release}"
    [ -f "${_rel}" ] || return 1
    sed -n "s/^$1=//p" "${_rel}" | head -n 1
}

cmd_packages() {
    _sub=${1:-list}
    [ "$#" -gt 0 ] && shift
    require_state
    packages_lib
    case "${_sub}" in
        list)
            ab_packages_list "$(packages_layer)"
            ;;
        snapshot)
            _layer="$(packages_layer)"
            _up=$(packages_release_value UPSTREAM_VERSION) || _up=unknown
            _pv=$(packages_release_value PLATFORM_VERSION) || _pv=unknown
            _snap=$(ab_packages_snapshot "${_layer}" "${_up}" "${_pv}") || die "snapshot-failed"
            _id=${_snap##*/snapshot-}
            _id=${_id%.txt}
            _n=$(grep -c '^pkg ' "${_snap}" 2>/dev/null || true)
            say "snapshot ${_id} written (${_n:-0} packages, base ${_up})"
            ;;
        upgrade) cmd_packages_upgrade "$@" ;;
        revert) cmd_packages_revert "$@" ;;
        *) say "ab-slot: unknown packages subcommand ${_sub}"; usage ;;
    esac
}

cmd_packages_upgrade() {
    _align=$(packages_alignment)
    if [ "${_align}" != "aligned" ]; then
        say "ab-slot: refused, reason=packages-not-aligned"
        say "  The writable layer's package metadata does not describe this release."
        say "  Next: ab-slot status | grep packages=    then re-run the upgrade that aligned it"
        exit 74
    fi
    if ! packages_apk_supported; then
        say "ab-slot: refused, reason=apk-unsupported"
        say "  apk-tools is not available on this system."
        say "  Next: upgrade the slot with ab-upgrade, or manage packages by hand"
        exit 74
    fi
    _layer="$(packages_layer)"
    _up=$(packages_release_value UPSTREAM_VERSION) || _up=unknown
    _pv=$(packages_release_value PLATFORM_VERSION) || _pv=unknown
    _snap=$(ab_packages_snapshot "${_layer}" "${_up}" "${_pv}") || die "snapshot-failed"
    _id=${_snap##*/snapshot-}
    _id=${_id%.txt}
    _n=$(grep -c '^pkg ' "${_snap}" 2>/dev/null || true)
    say "snapshot ${_id} written (${_n:-0} packages)"

    _timeout=""
    command -v timeout >/dev/null 2>&1 && _timeout="timeout 600"
    _start=$(date +%s)
    say "apk update"
    _rc=0
    # shellcheck disable=SC2086
    ${_timeout} apk update >>"${LOGDIR}/upgrade.log" 2>&1 || _rc=$?
    if [ "${_rc}" -eq 0 ]; then
        say "apk upgrade"
        # shellcheck disable=SC2086
        ${_timeout} apk upgrade >>"${LOGDIR}/upgrade.log" 2>&1 || _rc=$?
    fi
    _elapsed=$(( $(date +%s) - _start ))
    if [ "${_rc}" -eq 0 ]; then
        say "packages-upgrade result=ok elapsed=${_elapsed}s"
        packages_log "result=ok elapsed=${_elapsed}s"
        return 0
    fi
    _reason="apk-${_rc}"
    [ "${_rc}" -eq 124 ] && _reason="timeout"
    say "packages-upgrade result=fail reason=${_reason} elapsed=${_elapsed}s"
    packages_log "result=fail reason=${_reason} elapsed=${_elapsed}s"
    exit 1
}

cmd_packages_revert() {
    _to=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --to) _to=${2:?--to needs a snapshot id}; shift 2 ;;
            -*) say "ab-slot packages revert: unknown option $1"; usage ;;
            *) _to=$1; shift ;;
        esac
    done
    _layer="$(packages_layer)"
    _dir="${_layer}/apk/snapshots"
    if [ -z "${_to}" ]; then
        _to=$(ls -1 "${_dir}" 2>/dev/null | grep '^snapshot-.*\.txt$' | sort | tail -n 1 | sed 's/^snapshot-//; s/\.txt$//')
    fi
    [ -n "${_to}" ] || {
        say "ab-slot: refused, reason=revert-no-snapshot"
        say "  There is no snapshot to go back to on this layer."
        say "  Next: ab-slot packages snapshot"
        exit 74
    }
    _snap="${_dir}/snapshot-${_to}.txt"
    [ -f "${_snap}" ] || {
        say "ab-slot: refused, reason=revert-no-snapshot"
        say "  No snapshot ${_to} on this layer."
        say "  Next: ab-slot packages list"
        exit 74
    }
    if ! packages_apk_supported; then
        say "ab-slot: refused, reason=apk-unsupported"
        say "  apk-tools is not available on this system."
        say "  Next: upgrade the slot with ab-upgrade, or manage packages by hand"
        exit 74
    fi
    _snap_base=$(_packages_snapshot_field "${_snap}" upstream)
    _run_base=$(packages_release_value UPSTREAM_VERSION) || _run_base=unknown
    if [ "${_snap_base}" != "${_run_base}" ]; then
        say "ab-slot: refused, reason=revert-across-base"
        say "  Snapshot base ${_snap_base}, running base ${_run_base}."
        say "  Next: ab-slot rollback to return to the previous slot instead"
        exit 74
    fi
    say "revert from ${_to} (base ${_snap_base}, platform $(_packages_snapshot_field "${_snap}" platform))"
    _failed=0
    _changed=0
    while IFS=' ' read -r _name _version; do
        [ -n "${_name}" ] || continue
        _changed=$((_changed + 1))
        if apk add "${_name}=${_version}" >>"${LOGDIR}/upgrade.log" 2>&1; then
            say "  ok      ${_name} ${_version}"
        else
            # What apk said is in upgrade.log. Naming a cause here ("not in the feed")
            # would be a guess: the same line appears for an unreachable source and for a
            # version the source no longer carries.
            say "  failed  ${_name} ${_version}"
            _failed=$((_failed + 1))
        fi
    done <<EOF
$(sed -n 's/^pkg      //p' "${_snap}")
EOF
    if [ "${_changed}" -eq 0 ]; then
        say "revert result=empty (no packages in the snapshot)"
        packages_log "revert result=empty snapshot=${_to}"
        exit 1
    fi
    if [ "${_failed}" -eq 0 ]; then
        say "revert result=ok (${_changed} packages)"
        packages_log "revert result=ok changed=${_changed} snapshot=${_to}"
        return 0
    fi
    if [ "${_failed}" -eq "${_changed}" ]; then
        say "revert result=fail (${_failed} of ${_changed} failed)"
        packages_log "revert result=fail failed=${_failed} changed=${_changed} snapshot=${_to}"
        exit 1
    fi
    say "revert result=partial (${_failed} of ${_changed} failed)"
    packages_log "revert result=partial failed=${_failed} changed=${_changed} snapshot=${_to}"
    return 0
}


main() {
    [ "$#" -ge 1 ] || usage
    _cmd="$1"
    shift
    case "${_cmd}" in
        status) cmd_status "$@" ;;
        commit) cmd_commit "$@" ;;
        pending) cmd_pending "$@" ;;
        abandon) cmd_abandon "$@" ;;
        rollback) cmd_rollback "$@" ;;
        next) cmd_next "$@" ;;
        gc) cmd_gc "$@" ;;
        rootfs) require_state; cmd_rootfs "$@" ;;
        layer) cmd_layer "$@" ;;
        conflicts) require_state; cmd_conflicts "$@" ;;
        log) cmd_log "$@" ;;
        packages) cmd_packages "$@" ;;
        -h | --help | help) usage ;;
        *) say "ab-slot: unknown command ${_cmd}"; usage ;;
    esac
}

main "$@"
