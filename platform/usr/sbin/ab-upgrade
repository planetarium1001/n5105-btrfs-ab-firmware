#!/bin/sh
# ab-upgrade - install a payload into the inactive slot.
#
#   ab-upgrade [--bootloader|--no-bootloader] [--force] <payload.tar>
#       install and mark the target slot pending
#   ab-upgrade --check [flags] <payload.tar>
#       validate only, change nothing
#   ab-upgrade --version
#       print PLATFORM_VERSION / UPSTREAM_VERSION / PLATFORM_STAGE, read from the same
#       helper ab-slot uses; needs no root, no payload and no config
#   ab-upgrade --help
#       every option, including the update-feed ones
#
# The update-feed path (`--feed-check`, `--feed`, `--pin`, `--unpin`, `--feed-url`,
# `--release-repo`, `--release-base`) is documented where it is implemented, further down:
# it decides which source answers "is there something newer" before any of it is written.
#
# Payload layout (see docs/conflicts-payload.md):
#
#   payload.tar
#     manifest.json        {"format": ..., "rootfs": "<version>", "members": {...},
#                           "bootloader": {...} | null}
#     rootfs.tar.gz        upstream root filesystem
#     kernel.bin           kernel for the target slot
#     initramfs.cpio.gz    boot initramfs for the target slot
#     platform.tar         platform layer for the target slot (wf.tar is the old name)
#     boot.tar             optional: EFI/BOOT/BOOTX64.EFI + boot/grub/grub.cfg
#
# Bootloader flags:
#   (default)        update the ESP's bootloader from the payload when it carries one,
#                    and say so when it does not
#   --bootloader     require the payload to carry one: without boot.tar the payload is
#                    refused with 74 instead of being installed without it
#   --no-bootloader  never touch the ESP's bootloader (escape hatch: the write is the one
#                    operation a machine cannot recover from on its own)
#   --force          install even when the running slot already carries this version
#                    (default is a 74 refusal; reinstalling is how a slot is repaired)
#
# Validation follows the documented order and nothing is written before all of it
# passes: manifest shape, member digests, the btrfs module vermagic against the
# kernel, free space on the writable partition, and the conflict report.
#
# Exit status:
#   0   installed (or validated, with --check)
#   1   an execution step failed after validation
#   74  the payload was refused before anything was written
#
# The state file is only mutated through ab-slot, never written here.

set -u
PATH="${PATH:+${PATH}:}/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

AB_ESP="${AB_ESP:-/boot}"
AB_P4="${AB_P4:-/mnt/p4}"
LIB="${AB_LIB:-/lib/upgrade/platform.sh}"
LOG_MAX=32768

usage_text() {
    cat <<'USAGE'
usage: ab-upgrade [options] <payload.tar>
       ab-upgrade --feed-check [options]
       ab-upgrade --feed [options]
       ab-upgrade --pin <version> | --unpin
       ab-upgrade --version

Install a payload into the inactive slot:
  --check                       validate only, change nothing
  --bootloader                  require the payload to carry a bootloader
  --no-bootloader               never touch the ESP's bootloader
  --force                       install even when the running slot already carries it

Ask the update source:
  --feed-check                  report what is available; writes nothing
  --feed                        download, verify and install the newest release
  --feed-url <url>              use this feed for one run
  --release-repo <owner/name>   follow this repository's releases for one run
  --release-base <url>          build the release URL from this prefix for one run
  --direct                      with --feed: install the newest release in one step
  --stepwise                    with --feed: install the next release only

Packages:
  --system-only, --no-follow    replace the system only, follow no package
  --prefetch                    download the follow before the switch (default)
  --no-prefetch                 let the first boot use the network instead

Other:
  --yes                         accept the confirmation without a terminal
  --dry-run                     the same as --check
  --pin <version>               hold this machine at or below <version>
  --unpin                       remove the pin
  --version                     print PLATFORM_VERSION, UPSTREAM_VERSION, PLATFORM_STAGE
  --help                        this text

Every question is `Proceed? [y/N] `: Enter, n and no decline and write nothing; only
y, Y, yes and YES go ahead (docs/update.md).
USAGE
}

usage() {
    usage_text >&2
    exit 2
}

say() {
    printf '%s\n' "$*"
}

# Milestone lines have to reach the serial log and the local screen: the helper lives in
# the platform layer so every hook and tool writes them the same way (see
# platform/lib/ab-console.sh).
AB_CONSOLE_LIB="${AB_CONSOLE_LIB:-/lib/ab-console.sh}"
if [ ! -f "${AB_CONSOLE_LIB}" ]; then
    AB_CONSOLE_LIB="$(dirname "$0")/../../lib/ab-console.sh"
fi
if [ -f "${AB_CONSOLE_LIB}" ]; then
    # shellcheck source=platform/lib/ab-console.sh
    . "${AB_CONSOLE_LIB}"
else
    # Degraded: the platform layer is incomplete. Still say something on the console.
    console_say() {
        printf '%s\n' "$*" >/dev/console 2>/dev/null || :
    }
fi

# refuse <reason>: a pre-write refusal, documented as exit status 74.
refuse() {
    say "ab-upgrade: refused, reason=${1}"
    console_say "ab-upgrade: refused, reason=${1}"
    exit 74
}

# console_milestone <line...>: the console copy of a milestone that is not a refusal.
# console_say itself tolerates a missing console, but a shell that cannot open
# /dev/console prints the redirection error itself, and that line lands in the log of
# whoever invoked this script (a CI checker, a test). A milestone is therefore mirrored
# only when the console can take it; on a device running as root it always can.
console_milestone() {
    [ -w "${AB_CONSOLE_DEV:-/dev/console}" ] || return 0
    console_say "$@"
}

fail() {
    say "ab-upgrade: failed, reason=${1}"
    console_say "ab-upgrade: failed, reason=${1}"
    exit 1
}

# --- update feed ---------------------------------------------------------------
# The feed modes answer two questions and then hand the payload to the installer below:
#   --feed-check   what is out there, and how risky is it to take it
#   --feed         the same, then download it, verify it, and install it
#
# Two libraries do the work (platform/lib/ab-version.sh and ab-feed.sh); this section is
# the prompt, because every word of it is a contract with the user (docs/update.md).
# Nothing here writes a slot: `--feed` ends by setting payload_tar and falling through to
# the same validation and installation path a local `ab-upgrade <payload>` takes.
AB_VERSION_LIB="${AB_VERSION_LIB:-/lib/ab-version.sh}"
if [ ! -f "${AB_VERSION_LIB}" ]; then
    AB_VERSION_LIB="$(dirname "$0")/../../lib/ab-version.sh"
fi
AB_FEED_LIB="${AB_FEED_LIB:-/lib/ab-feed.sh}"
if [ ! -f "${AB_FEED_LIB}" ]; then
    AB_FEED_LIB="$(dirname "$0")/../../lib/ab-feed.sh"
fi
AB_PLATFORM_RELEASE="${AB_PLATFORM_RELEASE:-/etc/platform-release}"
UPDATE_CONF="${UPDATE_CONF:-/etc/ab/update.conf}"

feed_load_libs() {
    [ -f "${AB_VERSION_LIB}" ] || fail "feed-library-missing"
    [ -f "${AB_FEED_LIB}" ] || fail "feed-library-missing"
    # shellcheck source=platform/lib/ab-version.sh
    . "${AB_VERSION_LIB}"
    # shellcheck source=platform/lib/ab-feed.sh
    . "${AB_FEED_LIB}"
}

# platform_release_value <key>: PLATFORM_VERSION / UPSTREAM_VERSION, or empty.
platform_release_value() {
    [ -f "${AB_PLATFORM_RELEASE}" ] || return 1
    sed -n "s/^$1=//p" "${AB_PLATFORM_RELEASE}" | head -n 1
}

# installed_kernel: the kernel package version this slot runs, from the apk database when
# it is readable, from the release file otherwise. It is shown, never inferred.
installed_kernel() {
    _k=$(uname -r 2>/dev/null || :)
    [ -n "${_k}" ] || _k="unknown"
    printf '%s' "${_k}"
}

feed_entry_field() {
    printf '%s\n' "$1" | cut -d'|' -f"$2"
}

# feed_answer_accepts <answer>: the whole contract of the question, in one place. Only an
# explicit yes goes ahead; everything else, including a word that merely starts with a y, is
# an answer to "no".
feed_answer_accepts() {
    case "${1:-}" in
        y | Y | yes | YES) return 0 ;;
    esac
    return 1
}

# feed_declined: the documented "nothing was written". Declining is not an error - the
# person answered the question - so it leaves with 0.
feed_declined() {
    say "ab-upgrade: declined, nothing was written reason=declined"
    exit 0
}

# feed_confirm <level>: the tiers that only need a yes.
#
# One shape for every question, `Proceed? [y/N] `, because a firmware write that starts
# because somebody pressed Enter is a bug. Enter, n, N, no and anything unrecognised decline.
#
# AB_UPGRADE_ASSUME_TTY=1 makes the prompt read stdin as if a terminal were attached. It
# exists because the test suite has no terminal to answer on; it changes nothing about which
# answers accept, so a machine cannot be made to install by setting it.
feed_confirm() {
    if [ "${yes_mode}" = "1" ]; then
        return 0
    fi
    if [ -z "${AB_UPGRADE_ASSUME_TTY:-}" ] && [ ! -t 0 ]; then
        say "ab-upgrade: refused, reason=feed-noninteractive (no terminal; pass --yes to accept)"
        console_say "ab-upgrade: refused, reason=feed-noninteractive"
        exit 74
    fi
    printf 'Proceed? [y/N] ' >&2
    _answer=""
    read -r _answer || _answer=""
    feed_answer_accepts "${_answer}" || feed_declined
}

# show_version: the identity this machine was built as, from the same helper ab-slot uses.
# Answered before the command line is parsed: no root, no payload, no config, no slot.
show_version() {
    [ -f "${AB_VERSION_LIB}" ] || fail "feed-library-missing"
    # shellcheck source=platform/lib/ab-version.sh
    . "${AB_VERSION_LIB}"
    ab_version_identity
    exit 0
}

# feed_show_update <level> <entry>: the three-line identity plus Change/Tested/Risk.
feed_show_update() {
    _level=$1 _entry=$2
    _cand=$(feed_entry_field "${_entry}" 1)
    _cand_base=$(feed_entry_field "${_entry}" 2)
    _cand_kernel=$(feed_entry_field "${_entry}" 3)
    _delta=$(ab_version_delta "${installed_base}" "${_cand_base}")
    case "${_delta}" in
        none) _change="NONE" ;;
        patch\ *) _change="PATCH ×${_delta#patch }" ;;
        minor\ *) _change="MINOR +${_delta#minor }" ;;
        major\ *) _change="MAJOR +${_delta#major }" ;;
        *) _change="UNKNOWN" ;;
    esac
    _base_line="base     ${installed_base_show} -> ${_cand_base}"
    [ "${installed_base_show}" = "${_cand_base}" ] && _base_line="base     ${installed_base_show} (unchanged)"
    _kernel_line="kernel   ${installed_kernel_show} -> ${_cand_kernel}"
    [ "${installed_kernel_show}" = "${_cand_kernel}" ] && _kernel_line="kernel   ${installed_kernel_show} (unchanged)"
    say "Update  ${_base_line}"
    say "        ${_kernel_line}"
    say "        platform ${installed} -> ${_cand}"
    case "${_level}" in
        Z1)
            if [ "${_change}" = "NONE" ]; then
                say "  Change  NONE       · platform layer only; base and kernel left as they are"
                say "  Tested  YES        · same-base update covered in CI"
                say "  Risk    LOW        · no kernel or package base change"
            else
                say "  Change  ${_change}   · the entries above are what this update brings"
                say "  Tested  YES        · patch range covered in CI"
                say "  Risk    LOW        · running system replaced; previous slot is the way back"
            fi
            ;;
        Z2)
            say "  Change  ${_change}   · the entries above are what this update brings"
            say "  Tested  NO         · span outside the covered range"
            say "  Risk    LOW        · patches rarely change behaviour, but uncovered"
            say "Backup    ab-backup --help   (recommended)"
            ;;
        Y1)
            say "  Change  ${_change}   · a new release line; the entries above are what this update brings"
            say "  Tested  PARTLY     · neighbouring lines built together; one cross-line upgrade in CI"
            say "  Risk    REAL       · installed packages may need rebuilding for the new base"
            ;;
        Y2)
            say "  Change  ${_change}   · the entries above are what this update brings"
            say "  Tested  NO         · lines this far apart are not built together"
            say "  Risk    HIGHER     · compatibility is less certain than a neighbouring line"
            say "Backup    ab-backup --help   (recommended)"
            ;;
        X1)
            say "  Change  ${_change}   · a new major line; the entries above are what this update brings"
            say "  Tested  NO         · nothing here crosses a major line"
            say "  Risk    UNKNOWN    · the package base may not be compatible"
            say "Backup    ab-backup --help   (recommended)"
            ;;
    esac
}

feed_main() {
    feed_load_libs
    ab_feed_config_load "${UPDATE_CONF}" || refuse "${AB_FEED_REASON}"
    if [ -n "${feed_url_override}" ]; then
        AB_FEED_URL="${feed_url_override}"
        AB_FEED_SOURCE=feed
        # The override goes through the same check as the file: one https-only rule, one
        # place that enforces it (docs/update.md).
        case "${AB_FEED_URL}" in
            https://*) : ;;
            *) refuse "feed-conf-url" ;;
        esac
    elif [ -n "${release_repo_override}" ] || [ -n "${release_base_override}" ]; then
        # A fork or a proxy for one run, the same way --feed-url is a mirror for one run.
        # Both flags build the release root, so either one selects that source; the value the
        # file carries fills the half that was not given.
        ab_feed_release_source \
            "${release_repo_override:-${AB_FEED_RELEASE_REPO}}" \
            "${release_base_override:-${AB_FEED_RELEASE_BASE}}" \
            || refuse "${AB_FEED_REASON}"
        AB_FEED_SOURCE=release
    fi

    # Where the answer came from, printed before the answer. A refusal and a comparison must
    # never be read as each other, and the URL is what the operator needs to see when a
    # machine answers with a page instead of an index.
    if [ "${feed_check}" = "1" ]; then
        say "source=${AB_FEED_SOURCE} feed=${AB_FEED_URL}"
    fi

    installed=$(platform_release_value PLATFORM_VERSION) || installed=""
    installed_base=$(platform_release_value UPSTREAM_VERSION) || installed_base=""
    [ -n "${installed}" ] || refuse "platform-release-missing"
    [ -n "${installed_base}" ] || refuse "platform-release-missing"
    # A version this code cannot compare is not a machine it can advise. Guessing would
    # print an empty span and skip the whole Change/Tested/Risk block.
    ab_version_valid "${installed}" || refuse "platform-release-invalid"
    ab_version_valid "${installed_base}" || refuse "platform-release-invalid"
    installed_base_show=${installed_base}
    installed_kernel_show=$(installed_kernel)

    work="${work:-/tmp/ab-upgrade.$$}"
    mkdir -p "${work}" || fail "cannot-create-workdir"
    index_file="${work}/index.txt"
    if ! ab_feed_fetch "${AB_FEED_URL%/}/index.txt" "${index_file}"; then
        # A release published before this project had a feed index answers 404 here, which a
        # fetcher reports the same way it reports a dead network. The reason stays honest
        # (nothing was fetched); the extra line says where to look first when the source is
        # this project's own releases.
        if [ "${AB_FEED_SOURCE}" = "release" ]; then
            say "  Next: check https://github.com/${AB_FEED_RELEASE_REPO}/releases - a release"
            say "  published before the feed index existed carries no index.txt, and the next"
            say "  release will. A fork or a proxy goes in UPDATE_RELEASE_REPO / UPDATE_RELEASE_BASE."
        fi
        refuse "${AB_FEED_REASON}"
    fi
    # Before parsing: a source that answered with a page is not a source with a broken
    # field, and it is not an unreachable source either.
    ab_feed_index_check "${index_file}" || refuse "${AB_FEED_REASON}"
    entries="${work}/entries.txt"
    ab_feed_index_parse "${index_file}" "${AB_FEED_CHANNEL}" >"${entries}" || refuse "${AB_FEED_REASON}"

    candidate=$(ab_feed_pick "${entries}" "${installed}")
    if [ -z "${candidate}" ]; then
        _newest=$(head -n 1 "${entries}" | cut -d'|' -f1)
        if [ -n "${_newest}" ] && [ "$(ab_version_cmp "${_newest}" "${installed}")" -lt 0 ]; then
            _newest_entry=$(head -n 1 "${entries}")
            _newest_base=$(feed_entry_field "${_newest_entry}" 2)
            _newest_kernel=$(feed_entry_field "${_newest_entry}" 3)
            say "platform=${installed} platform_available=${_newest} base=${installed_base} base_available=${_newest_base} kernel=${installed_kernel_show} kernel_available=${_newest_kernel} span=$(ab_version_delta "${installed_base}" "${_newest_base}") level=downgrade status=downgrade"
            if [ "${feed_check}" = "1" ]; then
                exit 0
            fi
            if [ "${force_mode}" != "1" ]; then
                say "${_newest} is older than ${installed}"
                say "Install it anyway? ab-upgrade --feed --force"
                refuse "feed-would-downgrade"
            fi
            candidate=${_newest}
            entry=${_newest_entry}
            cand_base=${_newest_base}
            cand_kernel=${_newest_kernel}
            level=downgrade
        else
            say "${installed} is the newest release (base ${installed_base})"
            say "status=current"
            exit 0
        fi
    fi
    entry=$(awk -F'|' -v want="${candidate}" '$1 == want { print; exit }' "${entries}")
    cand_base=$(feed_entry_field "${entry}" 2)
    cand_kernel=$(feed_entry_field "${entry}" 3)
    level=$(ab_version_level "${installed_base}" "${cand_base}")
    # The level is a statement about the base, so an equal base reads as "current".
    # Here the platform version still moves, which is the Z1 same-base case.
    [ "${level}" = "current" ] && level="Z1"
    # A base that does not move cannot reveal a platform downgrade: the candidate is an
    # older release on the same base, and calling that Z1/LOW would tell the user the
    # opposite of what is happening.
    _platform_cmp=$(ab_version_cmp "${candidate}" "${installed}")
    [ "${_platform_cmp}" -lt 0 ] && level="downgrade"

    if [ -n "${AB_FEED_PIN:-}" ]; then
        _pin_cmp=$(ab_version_cmp "${candidate}" "${AB_FEED_PIN}")
        if [ "${_pin_cmp}" -gt 0 ]; then
            say "${candidate} is available, but UPDATE_PIN=${AB_FEED_PIN} holds this machine"
            if [ "${feed_check}" = "1" ]; then
                say "platform=${installed} platform_available=${candidate} base=${installed_base} base_available=${cand_base} kernel=${installed_kernel_show} kernel_available=${cand_kernel} span=$(ab_version_delta "${installed_base}" "${cand_base}") level=$(ab_version_level "${installed_base}" "${cand_base}") pin=${AB_FEED_PIN} status=pinned"
                exit 0
            fi
            refuse "feed-pinned"
        fi
        _pin_cmp=$(ab_version_cmp "${AB_FEED_PIN}" "${installed}")
        [ "${_pin_cmp}" -lt 0 ] && say "warning pin-below-installed (UPDATE_PIN=${AB_FEED_PIN}, running ${installed})"
    fi

    if [ "${route}" = "stepwise" ]; then
        _step=$(ab_feed_stepwise "${entries}" "${installed}")
        if [ -z "${_step}" ]; then
            refuse "feed-no-such-release"
        fi
        if [ "${_step}" != "${candidate}" ]; then
            say "stepwise: installing ${_step} first (${candidate} is the newest)"
            candidate=${_step}
            entry=$(awk -F'|' -v want="${candidate}" '$1 == want { print; exit }' "${entries}")
            cand_base=$(feed_entry_field "${entry}" 2)
            cand_kernel=$(feed_entry_field "${entry}" 3)
            level=$(ab_version_level "${installed_base}" "${cand_base}")
            [ "${level}" = "current" ] && level="Z1"
        fi
    fi

    _span=$(ab_version_delta "${installed_base}" "${cand_base}")
    say "platform=${installed} platform_available=${candidate} base=${installed_base} base_available=${cand_base} kernel=${installed_kernel_show} kernel_available=${cand_kernel} span=${_span} level=${level} status=update"

    if [ "${feed_check}" = "1" ]; then
        exit 10
    fi

    case "${level}" in
        downgrade)
            if [ "${force_mode}" != "1" ]; then
                say "${candidate} is older than ${installed}"
                say "Install it anyway? ab-upgrade --feed --force"
                refuse "feed-would-downgrade"
            fi
            ;;
    esac

    feed_show_update "${level}" "${entry}"
    case "${level}" in
        X1)
            if [ -z "${route}" ]; then
                say "Route     --stepwise   install the next release, one at a time   [recommended]"
                say "          --direct     install the newest release in one step"
                refuse "feed-route-required"
            fi
            feed_confirm "${level}"
            ;;
        *)
            feed_confirm "${level}"
            ;;
    esac

    payload_url=$(feed_entry_field "${entry}" 6)
    payload_size=$(feed_entry_field "${entry}" 4)
    payload_path="${AB_FEED_DIR:-/tmp/ab-feed}/$(basename "${payload_url}")"
    mkdir -p "$(dirname "${payload_path}")" || fail "cannot-create-feed-dir"
    ab_feed_space_ok "$(dirname "${payload_path}")" "${payload_size}" || refuse "${AB_FEED_REASON}"
    ab_feed_fetch "${payload_url}" "${payload_path}" || refuse "${AB_FEED_REASON}"
    if ! ab_feed_verify_member "${payload_path}" "${entry}"; then
        _feed_reason=${AB_FEED_REASON}
        rm -f "${payload_path}"
        refuse "${_feed_reason}"
    fi
    say "ab-upgrade: ${candidate} verified, installing"
    # A platform-only update carries the same rootfs as the slot it is installed into,
    # because the base did not move. The installer refuses an identical rootfs version
    # unless it is told the reinstall is intended, which here it is.
    if [ "${cand_base}" = "${installed_base}" ] && [ "${_platform_cmp}" -gt 0 ]; then
        say "ab-upgrade: base unchanged; this updates the platform layer only"
        force_mode=1
    fi
    payload_tar="${payload_path}"
}


# `--version` is answered here, before anything below looks at the command line or the
# machine: a support script asks this of a box that may have no config, no payload and no
# writable slot, and it must get an answer.
case "${1:-}" in
    --version | -V) show_version ;;
esac

check_mode=0
force_mode=0
# update (default) | skip. "update" still degrades to "no bootloader in this payload"
# with a line on the console; "skip" never touches the ESP's bootloader.
bootloader_mode="update"
bootloader_required=0
saw_no_bootloader=0
# Options are accepted anywhere on the command line. Parsing stops at the first positional
# argument is how `ab-upgrade payload.tar --no-bootloader` silently wrote the ESP and
# `ab-upgrade payload.tar --check` really installed: an operator who put the path first got
# the opposite of what they asked for. Anything after the payload is therefore parsed too,
# and a second positional argument is a usage error instead of being ignored.
payload_tar=""
feed_check=0
feed_mode=0
route=""
yes_mode=0
feed_url_override=""
release_repo_override=""
release_base_override=""
pin_version=""
unpin_mode=0
# The package plan answers one question and has three exits, so the flags that skip the
# question are the ones the plan block has to name when it holds a package back
# (design.md §5/§7, docs/update.md).
system_only_mode=0
prefetch_mode=1
while [ "$#" -gt 0 ]; do
    case "$1" in
        --check | --dry-run) check_mode=1; shift ;;
        --system-only | --no-follow) system_only_mode=1; shift ;;
        --prefetch) prefetch_mode=1; shift ;;
        --no-prefetch) prefetch_mode=0; shift ;;
        --feed-check) feed_check=1; shift ;;
        --feed) feed_mode=1; shift ;;
        --direct) route="direct"; shift ;;
        --stepwise) route="stepwise"; shift ;;
        --yes) yes_mode=1; shift ;;
        --feed-url) feed_url_override=${2:?--feed-url needs a value}; shift 2 ;;
        --release-repo) release_repo_override=${2:?--release-repo needs owner/name}; shift 2 ;;
        --release-base) release_base_override=${2:?--release-base needs a url}; shift 2 ;;
        --version | -V) show_version ;;
        --help | -h) usage_text; exit 0 ;;
        --pin) pin_version=${2:?--pin needs a version}; shift 2 ;;
        --unpin) unpin_mode=1; shift ;;
        --bootloader) bootloader_required=1; bootloader_mode="update"; shift ;;
        --no-bootloader) saw_no_bootloader=1; bootloader_mode="skip"; shift ;;
        --force) force_mode=1; shift ;;
        --) shift; break ;;
        -*) say "ab-upgrade: unknown option ${1}"; usage ;;
        *)
            if [ -n "${payload_tar}" ]; then
                say "ab-upgrade: unexpected argument ${1} (the payload is already ${payload_tar})"
                usage
            fi
            payload_tar="$1"
            shift
            ;;
    esac
done
# Everything after `--` is positional.
while [ "$#" -gt 0 ]; do
    if [ -n "${payload_tar}" ]; then
        say "ab-upgrade: unexpected argument ${1} (the payload is already ${payload_tar})"
        usage
    fi
    payload_tar="$1"
    shift
done
# pin_main: hold this machine on a release. It edits one line of the config file and
# never talks to the network, so an operator can pin on a machine with no feed at all.
pin_main() {
    feed_load_libs
    [ -f "${UPDATE_CONF}" ] || refuse "no-feed-config"
    if [ "${pin_version}" != "" ]; then
        ab_version_valid "${pin_version}" || refuse "pin-invalid-version"
    fi
    _tmp="${UPDATE_CONF}.new.$$"
    # The reader trims blanks around the key, so the writer has to recognise the same
    # shape; otherwise a hand-edited `UPDATE_PIN = 0.0.8` survives an --unpin that says
    # it removed the pin.
    awk -v keep="${pin_version}" -v unpin="${unpin_mode}" '
        /^[[:space:]]*UPDATE_PIN[[:space:]]*=/ { next }
        { print }
        END {
            if (unpin != "1" && keep != "") printf "UPDATE_PIN=%s\n", keep
        }
    ' "${UPDATE_CONF}" >"${_tmp}" || refuse "pin-write-failed"
    # Keep the mode and owner the file had: a pin edit must not widen the permissions of
    # a file the operator may have tightened.
    chmod --reference="${UPDATE_CONF}" "${_tmp}" 2>/dev/null || \
        chmod "$(ls -l "${UPDATE_CONF}" | cut -c1-10 | tr 'rwx-' '7550' | cut -c2-10)" "${_tmp}" 2>/dev/null || :
    mv "${_tmp}" "${UPDATE_CONF}" || refuse "pin-write-failed"
    _after=$(sed -n 's/^[[:space:]]*UPDATE_PIN[[:space:]]*=[[:space:]]*//p' "${UPDATE_CONF}" | head -n 1)
    if [ "${unpin_mode}" = "1" ] && [ -n "${_after}" ]; then
        refuse "pin-write-failed"
    fi
    if [ "${unpin_mode}" != "1" ] && [ "${_after}" != "${pin_version}" ]; then
        refuse "pin-write-failed"
    fi
    if [ "${unpin_mode}" = "1" ]; then
        say "ab-upgrade: pin removed"
    else
        say "ab-upgrade: pinned to ${pin_version}"
    fi
}

work="${work:-/tmp/ab-upgrade.$$}"
cleanup() {
    rm -rf "${work}"
}
if [ -n "${route}" ] && [ "${feed_mode}" != "1" ] && [ "${feed_check}" != "1" ]; then
    say "ab-upgrade: --direct and --stepwise only apply to --feed"
    usage
fi
if [ "${pin_version}" != "" ] && [ "${unpin_mode:-0}" = "1" ]; then
    say "ab-upgrade: --pin and --unpin contradict each other"
    usage
fi
if [ "${pin_version}" != "" ] || [ "${unpin_mode:-0}" = "1" ]; then
    pin_main
    exit 0
fi
if [ "${feed_check}" = "1" ] || [ "${feed_mode}" = "1" ]; then
    trap cleanup EXIT INT TERM
    feed_main
    [ "${feed_mode}" = "1" ] || exit 0
fi
[ -n "${payload_tar}" ] || usage
# Both flags mean opposite things and either order has to be rejected: "carry one, but do
# not write it" is not a state this tool can be in.
if [ "${bootloader_required}" = "1" ] && [ "${saw_no_bootloader}" = "1" ]; then
    say "ab-upgrade: --bootloader and --no-bootloader contradict each other"
    usage
fi
# The adapter reads this; keeping it in one variable means `--no-bootloader` is enforced
# in one place instead of at every call into the library.
AB_UPGRADE_BOOTLOADER="${bootloader_mode}"
export AB_UPGRADE_BOOTLOADER
[ -f "${payload_tar}" ] || refuse "payload-not-found"

work="/tmp/ab-upgrade.$$"
mkdir -p "${work}" || fail "cannot-create-workdir"
cleanup() {
    rm -rf "${work}"
}
trap cleanup EXIT INT TERM

tar -xf "${payload_tar}" -C "${work}" 2>/dev/null || refuse "payload-not-a-tar"

# --------------------------------------------------------------------------- #
# 1. Manifest shape
# --------------------------------------------------------------------------- #

manifest="${work}/manifest.json"
[ -f "${manifest}" ] || refuse "manifest-missing"
squeezed="$(tr -d ' \t\r\n' <"${manifest}")"
case "${squeezed}" in
    *'"format":"'*) : ;;
    *) refuse "manifest-without-format" ;;
esac
format="$(printf '%s' "${squeezed}" | sed -n 's/.*"format":"\([^"]*\)".*/\1/p')"
case "${format}" in
    ab-payload/1 | wf-ab-payload/1) : ;;
    *) refuse "manifest-format-${format}" ;;
esac
rootfs_version="$(printf '%s' "${squeezed}" | sed -n 's/.*"rootfs":"\([^"]*\)".*/\1/p')"
[ -n "${rootfs_version}" ] || refuse "manifest-without-rootfs"
# The version becomes a directory name (the writable layer, the bootloader backup) and a
# literal in the feeds files, so it is restricted here, once: a `../` would write outside
# the layer directory and an `&` would be expanded inside a sed replacement.
case "${rootfs_version}" in
    .* | *[!A-Za-z0-9._~+-]*) refuse "manifest-rootfs-invalid-${rootfs_version}" ;;
esac

# The platform layer's own version, optional in the format: payloads built before the field
# existed carry none, and those still have to install. It is read here, in the same parse of
# the same manifest, because the "already installed" guard needs it next to the base version
# and re-reading the file would let the two answers come from different bytes.
platform_version="$(printf '%s' "${squeezed}" | sed -n 's/.*"platform":"\([^"]*\)".*/\1/p')"
case "${platform_version}" in
    "") : ;;
    .* | *[!A-Za-z0-9._~+-]*) refuse "manifest-platform-invalid-${platform_version}" ;;
esac

# --------------------------------------------------------------------------- #
# 2. Members and digests
# --------------------------------------------------------------------------- #

# member_sha <name>: the digest the manifest claims for that member.
member_sha() {
    _block="$(printf '%s' "${squeezed}" | sed -n 's/.*"'"$1"'":{\([^}]*\)}.*/\1/p')"
    [ -n "${_block}" ] || return 1
    printf '%s' "${_block}" | sed -n 's/.*"sha256":"\([0-9a-f]*\)".*/\1/p'
}

platform_member=""
if [ -f "${work}/platform.tar" ]; then
    platform_member="platform.tar"
elif [ -f "${work}/wf.tar" ]; then
    platform_member="wf.tar"
fi
[ -n "${platform_member}" ] || refuse "payload-without-platform-layer"

members="rootfs.tar.gz kernel.bin initramfs.cpio.gz ${platform_member}"
member_count=4
# The bootloader is optional in the format and mandatory when the caller says so: a
# payload from before this member existed still has to install on a machine whose
# firmware is fine, while `--bootloader` states that this release is supposed to carry
# one. Either way the member is digest checked like every other one.
boot_member=""
if [ -f "${work}/boot.tar" ]; then
    boot_member="boot.tar"
    members="${members} boot.tar"
    member_count=5
elif [ "${bootloader_required}" = "1" ]; then
    refuse "payload-without-bootloader"
fi

for member in ${members}; do
    [ -f "${work}/${member}" ] || refuse "member-missing-${member}"
    want="$(member_sha "${member}")" || refuse "manifest-without-${member}"
    [ -n "${want}" ] || refuse "manifest-without-${member}"
    have="$(sha256sum "${work}/${member}" 2>/dev/null | cut -d' ' -f1)"
    [ "${have}" = "${want}" ] || refuse "digest-mismatch-${member}"
done
say "ab-upgrade: manifest ok, ${format}, rootfs ${rootfs_version}, ${member_count} members verified"

# --------------------------------------------------------------------------- #
# 3. The initramfs must be built for the kernel in the payload
# --------------------------------------------------------------------------- #

# The upstream kernel is an EFI stub, so its vermagic sits inside the compressed image
# and cannot be read here. What can be checked is that the payload is internally
# consistent: every module in its initramfs must come from one kernel build.
# The initramfs carries the kernel's modules together with `modules.*` metadata, and
# that metadata has a `vermagic=` line with nothing after it. Keeping the empty line in
# the list is what once made the evidence line print "modules agree on " - the check
# itself was right (two different versions are still refused) but the line was useless
# to whoever read the log. Empty values are therefore dropped here, before the count:
# the guarantee is still "every module comes from one build", the evidence names it.
module_vermagi="$(gzip -dc "${work}/initramfs.cpio.gz" 2>/dev/null \
    | grep -a -o 'vermagic=[[:print:]]*' | sed 's/^vermagic=//' | sed '/^[[:space:]]*$/d' | sort -u)"
module_count="$(printf '%s\n' "${module_vermagi}" | grep -c . || true)"
[ "${module_count}" -ge 1 ] || refuse "initramfs-without-module-vermagic"
[ "${module_count}" -eq 1 ] || refuse "initramfs-mixed-module-vermagic-${module_count}"
module_version="$(printf '%s\n' "${module_vermagi}" | head -n 1)"
module_short="${module_version%% *}"
say "ab-upgrade: modules agree on ${module_short}"

# --------------------------------------------------------------------------- #
# 4. Free space on the writable partition
# --------------------------------------------------------------------------- #

# upgrade_reason and the UPGRADE_* values come from the library.
upgrade_reason=""
UPGRADE_NEW_LAYER=""
UPGRADE_NEW_VERSION=""

# --------------------------------------------------------------------------- #
# 3b. The upgrade adapter, loaded from a source a package cannot shadow
# --------------------------------------------------------------------------- #
# ${LIB} is a merged-overlay path, and `/lib/upgrade/platform.sh` is the name upstream's
# sysupgrade interface uses too. An `apk upgrade` that rewrites that file leaves an upper
# copy in the writable layer, the upper copy wins over the platform layer, and the
# library that gets sourced is upstream's: every validation step passes and then the
# install dies with `platform_upgrade_begin: not found`. The content is therefore
# checked before it is sourced, and when it is not this project's adapter the loader
# falls back to an immutable copy - the running slot's read-only @platform subvolume,
# then the platform layer the payload carries - and refuses with a recovery path only
# when none of them is usable.
#
# What the loader settled on is logged as `upgrade: platform adapter source=<token>`:
#   running    the path ${LIB} names (AB_LIB or the default /lib/upgrade/platform.sh)
#   immutable  the running slot's @platform subvolume, mounted read-only
#   payload    the platform layer inside the payload

# The partition lookup the immutable fallback needs. A path set by the caller is used as
# given (the boot environment and the tests pin it); a checkout falls back to the in-tree
# copy, the same way the other libraries above do.
ADAPTER_SOURCE=""
ADAPTER_PATH=""
adp_partitions_pinned=0
if [ -n "${AB_PARTITIONS_LIB:-}" ]; then
    adp_partitions_pinned=1
else
    AB_PARTITIONS_LIB=/lib/ab-partitions.sh
    [ -f "${AB_PARTITIONS_LIB}" ] || AB_PARTITIONS_LIB="$(dirname "$0")/../../lib/ab-partitions.sh"
fi

# adapter_is_ours <file>: the file is this project's adapter, not upstream's. The marker
# is the entry point the rest of this script calls; upstream's platform.sh does not
# define it, which is exactly what makes a shadowed copy unusable.
adapter_is_ours() {
    [ -f "$1" ] || return 1
    grep -q '^platform_upgrade_begin()' "$1" 2>/dev/null
}

# adapter_from_file <source-token> <file>: source one verified candidate.
adapter_from_file() {
    adp_token="$1"
    adp_file="$2"
    adapter_is_ours "${adp_file}" || return 1
    # shellcheck source=platform/lib/upgrade/platform.sh disable=SC1090
    . "${adp_file}" || return 1
    # Checked again after sourcing: a file that only mentions the entry point in a
    # comment or inside a branch that did not run is not an adapter either.
    command -v platform_upgrade_begin >/dev/null 2>&1 || return 1
    ADAPTER_SOURCE="${adp_token}"
    ADAPTER_PATH="${adp_file}"
    return 0
}

# adapter_running_platform: source the adapter from the running slot's @platform
# subvolume, mounted read-only. That subvolume is the platform layer itself; a package
# can only write into the writable layer, so its copy cannot shadow this one. The device
# node comes from the shared lookup (platform/lib/ab-partitions.sh); when the disk cannot
# be identified the fallback is skipped instead of mounting a guessed partition.
adapter_running_platform() {
    adp_slot="$(ab-slot status 2>/dev/null | sed -n 's/^slot=\([ab]\) .*/\1/p')"
    [ -n "${adp_slot}" ] || return 1
    case "${adp_slot}" in
        a) adp_part=2 ;;
        b) adp_part=3 ;;
        *) return 1 ;;
    esac
    [ -f "${AB_PARTITIONS_LIB}" ] || return 1
    # shellcheck source=platform/lib/ab-partitions.sh disable=SC1090
    . "${AB_PARTITIONS_LIB}" 2>/dev/null || return 1
    command -v ab_find_partition >/dev/null 2>&1 || return 1
    adp_dev="$(ab_find_partition "ab-slot-${adp_slot}" "${adp_part}")" || return 1
    [ -n "${adp_dev}" ] || return 1
    adp_mnt="${work}/adapter-platform"
    mkdir -p "${adp_mnt}" || return 1
    adp_root=""
    if mount -o ro,subvol=/@platform "${adp_dev}" "${adp_mnt}" 2>/dev/null; then
        adp_root="${adp_mnt}"
    elif mount -o ro "${adp_dev}" "${adp_mnt}" 2>/dev/null; then
        # A mount that cannot name the subvolume still exposes it as a directory of the
        # filesystem root.
        adp_root="${adp_mnt}/@platform"
    else
        rmdir "${adp_mnt}" 2>/dev/null || true
        return 1
    fi
    adp_ok=0
    adapter_from_file immutable "${adp_root}/lib/upgrade/platform.sh" && adp_ok=1
    umount "${adp_mnt}" 2>/dev/null || say "ab-upgrade: warning: could not release ${adp_mnt}"
    rmdir "${adp_mnt}" 2>/dev/null || true
    [ "${adp_ok}" = "1" ]
}

# adapter_from_payload: extract the payload's platform layer into the work directory and
# source the adapter from that copy. The whole layer is extracted, not just lib/upgrade:
# the adapter sources its helpers from lib/, and half a layer is the same failure in a
# new place. When the caller did not pin them, the helper paths are pointed at the
# extracted tree too, so the adapter never mixes the version being installed with the
# one that happens to be running.
adapter_from_payload() {
    [ -n "${platform_member}" ] || return 1
    [ -f "${work}/${platform_member}" ] || return 1
    adp_root="${work}/adapter-payload"
    rm -rf "${adp_root}" 2>/dev/null || true
    mkdir -p "${adp_root}" || return 1
    tar -xf "${work}/${platform_member}" -C "${adp_root}" 2>/dev/null || return 1
    if [ "${adp_partitions_pinned}" = "0" ]; then
        if [ -f "${adp_root}/lib/ab-partitions.sh" ]; then
            AB_PARTITIONS_LIB="${adp_root}/lib/ab-partitions.sh"
            export AB_PARTITIONS_LIB
        fi
        if [ -f "${adp_root}/lib/disk-identity.sh" ] && [ -z "${AB_DISK_IDENTITY_LIB:-}" ]; then
            AB_DISK_IDENTITY_LIB="${adp_root}/lib/disk-identity.sh"
            export AB_DISK_IDENTITY_LIB
        fi
    fi
    adapter_from_file payload "${adp_root}/lib/upgrade/platform.sh"
}

# adapter_recovery: what an operator can do when no copy can be loaded. Printed before
# the refusal so it reaches the same console log the refusal reaches; the two documented
# ways out are removing the upper copies and pointing the loader at a clean copy.
adapter_recovery() {
    adp_upper="$(ab-slot status 2>/dev/null | sed -n 's/^.*upper=\([^ ]*\) .*/\1/p')"
    [ -n "${adp_upper}" ] || adp_upper="@overlay-<version>"
    if [ -f "${LIB}" ]; then
        say "ab-upgrade: recovery: ${LIB} is not this project's adapter: a package wrote"
        say "ab-upgrade: recovery: the upstream copy into the writable layer and it wins over the platform layer."
        say "ab-upgrade: recovery: remove the shadowing copies and retry:"
        say "ab-upgrade: recovery:   rm -f ${AB_P4}/${adp_upper}/upper/lib/upgrade/platform.sh"
        say "ab-upgrade: recovery:   rm -f ${AB_P4}/${adp_upper}/upper/lib/upgrade/fwtool.sh"
        say "ab-upgrade: recovery:   rm -f ${AB_P4}/${adp_upper}/upper/lib/upgrade/stage2"
        say "ab-upgrade: recovery:   rm -f ${AB_P4}/${adp_upper}/upper/lib/upgrade/tar.sh"
        say "ab-upgrade: recovery: or install this run from a copy that is not shadowed:"
        say "ab-upgrade: recovery:   AB_LIB=<path-to>/lib/upgrade/platform.sh ab-upgrade <payload.tar>"
    else
        say "ab-upgrade: recovery: ${LIB} is missing and the payload carries no usable copy."
        say "ab-upgrade: recovery: the platform layer was removed or is shadowed; pass one explicitly:"
        say "ab-upgrade: recovery:   AB_LIB=<path-to>/lib/upgrade/platform.sh ab-upgrade <payload.tar>"
    fi
}

# adapter_load: try the three sources in order. The reason token is one value for every
# way the load can fail, because what the operator has to do is the same: the machine
# cannot start an upgrade from what it has, and the recovery lines say how.
adapter_load() {
    if [ -f "${LIB}" ] && ! adapter_is_ours "${LIB}"; then
        say "ab-upgrade: warning: ${LIB} is not this project's adapter (shadowed by a package); looking for an immutable copy"
        console_milestone "ab-upgrade: warning adapter-shadowed path=${LIB}"
    elif [ ! -f "${LIB}" ]; then
        say "ab-upgrade: warning: ${LIB} is missing; looking for the running slot's platform layer"
        console_milestone "ab-upgrade: warning adapter-missing path=${LIB}"
    fi
    if adapter_from_file running "${LIB}"; then
        :
    elif adapter_running_platform; then
        :
    elif adapter_from_payload; then
        :
    else
        adapter_recovery
        refuse "platform-layer-shadowed"
    fi
    say "upgrade: platform adapter source=${ADAPTER_SOURCE} path=${ADAPTER_PATH}"
    console_milestone "upgrade: platform adapter source=${ADAPTER_SOURCE}"
}

adapter_load

# ab-slot status is the single source for both the layer name and the writable partition
# state; a failure here used to be indistinguishable from a degraded partition.
if ! status_out="$(ab-slot status 2>&1)"; then
    say "ab-upgrade: ab-slot status failed: ${status_out}"
    refuse "slot-status-failed"
fi
p4_state="$(printf '%s' "${status_out}" | sed -n 's/^.*p4=\([a-z]*\).*/\1/p')"
[ "${p4_state}" = "ok" ] || refuse "writable-layer-degraded"
total="$(df -k "${AB_P4}" 2>/dev/null | awk 'NR == 2 { print $2 }')"
avail="$(df -k "${AB_P4}" 2>/dev/null | awk 'NR == 2 { print $4 }')"
[ -n "${total}" ] && [ -n "${avail}" ] || refuse "free-space-unknown"
[ "${total}" -gt 0 ] || refuse "free-space-unknown"
pct=$((avail * 100 / total))
[ "${pct}" -ge 5 ] || refuse "low-space-${pct}pct"
say "ab-upgrade: ${pct}% free on ${AB_P4}"

# A slot can only be upgraded to something it is not already running. Without this
# guard a payload left behind on the machine would silently rewrite the healthy slot
# from the failed-update slot on the next boot, and the result would look like a clean
# "no conflict" install because the baseline already equals the payload.
running="$(printf '%s' "${status_out}" | sed -n 's/^slot=\([ab]\) .*/\1/p')"
case "${running}" in
    a) other=b ;;
    b) other=a ;;
    *) refuse "no-running-slot" ;;
esac
installed="$(ab-slot rootfs "${running}" 2>/dev/null)"
# "Already installed" is an identity of two versions, not one. The base says which upstream
# tree this is; the platform says which release of this project was laid on top of it. Two
# releases on the same base (0.0.10 -> 0.0.11) share the base exactly, so comparing it alone
# called an ordinary platform-only update a reinstall and refused it with 74 - measured on a
# real N5105, where the only way through was --force, which the message did not name.
# The comparison only runs when the base matches: a payload for a different base is never
# "already installed", and its platform field has no bearing on that.
if [ "${installed}" = "${rootfs_version}" ]; then
    running_platform="$(platform_release_value PLATFORM_VERSION)" || running_platform=""
    install_platform="${platform_version:-}"
    if [ -z "${install_platform}" ] || [ -z "${running_platform}" ]; then
        # Cannot tell "the same release" from "a different release on the same base", and
        # guessing "different" would let a leftover payload rewrite the healthy slot from the
        # slot under test - the failure this guard exists for. Refuse, and name the side that
        # is missing so the operator is not sent looking for a corrupt machine.
        say "ab-upgrade: slot ${running} runs ${installed}, but the platform version is unknown"
        [ -n "${running_platform}" ] ||
            say "ab-upgrade: this machine's release file names no PLATFORM_VERSION"
        [ -n "${install_platform}" ] ||
            say "ab-upgrade: the payload's manifest names no platform"
        refuse "payload-platform-unknown"
    fi
    if [ "${install_platform}" = "${running_platform}" ]; then
        # Reinstalling the same version is how a damaged slot is repaired, but doing it by
        # accident rewrites the healthy slot from the slot being tested, so it needs a flag.
        if [ "${force_mode}" = "1" ]; then
            say "ab-upgrade: forcing reinstall of ${install_platform} into slot ${other} (slot ${running} already runs it)"
        else
            say "ab-upgrade: slot ${running} already runs ${installed} (platform ${running_platform})"
            say "Next: ab-upgrade --force to reinstall the version this slot already runs"
            refuse "payload-already-installed"
        fi
    else
        say "ab-upgrade: base unchanged, platform ${running_platform} -> ${install_platform}"
    fi
fi
say "ab-upgrade: running slot ${running} on ${installed}, installing ${rootfs_version} into slot ${other}"

# The payload's rootfs is unpacked into tmpfs: the conflict comparison needs both
# trees side by side, and nothing is written to the slot yet.
mkdir -p "${work}/rootfs-tree"
tar -xzf "${work}/rootfs.tar.gz" -C "${work}/rootfs-tree" 2>/dev/null || refuse "rootfs-extract-failed"

# --------------------------------------------------------------------------- #
# 5. Conflict report (produced before writing; never blocks the update)
# --------------------------------------------------------------------------- #

# The scan compares three trees: the running slot's @sys (the baseline), the payload's
# rootfs and the user's copy in the writable layer. Both the slot and its layer come
# from the same status snapshot, so they cannot disagree.
running_layer="$(printf '%s' "${status_out}" | sed -n 's/^.*upper=\([^ ]*\) .*/\1/p')"
[ -n "${running_layer}" ] || refuse "slot-status-without-layer"

slots_root="${AB_SLOTS_ROOT:-/mnt/slots}"
running_sys="${slots_root}/${running}/@sys"
baseline="unreadable"
if [ -d "${running_sys}/etc" ]; then
    baseline="ok"
else
    # The boot initramfs mounts the slot subvolumes for itself and those mounts are
    # gone once userspace runs, so the baseline has to be mounted again here. The
    # comparison is only meaningful when it can be read; a missing baseline is
    # reported, never guessed at.
    if running_mp="$(upgrade_slot_mount "${running}" 2>/dev/null)" && [ -d "${running_mp}/@sys/etc" ]; then
        running_sys="${running_mp}/@sys"
        baseline="ok"
    fi
fi
conflicts=0
uci_defaults=0
scanned=0
absent_payload=0
same_payload=0
untouched=0
same_user=0
report="${work}/conflicts.log"

{
    printf 'conflicts rootfs=%s generated=%s running=%s baseline=%s baseline-path=%s\n' \
        "${rootfs_version}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${running}" "${baseline}" "${running_sys}"
} >"${report}"
if [ "${baseline}" != "ok" ]; then
    say "ab-upgrade: warning: cannot read the running slot baseline (${running_sys}), no conflict can be detected"
    console_say "ab-upgrade: warning baseline=unreadable slot=${running}"
fi

if [ "${baseline}" = "ok" ] && [ -d "${running_sys}/etc" ]; then
    upper="${AB_P4}/${running_layer}/upper"
    # Non-uci configuration only; /etc/config is uci's own grammar and is delivered
    # through idempotent uci-defaults scripts instead of being compared.
    for path in $(cd "${running_sys}" && find etc -type f 2>/dev/null | sort); do
        case "${path}" in
            etc/config/*) continue ;;
        esac
        new="${work}/rootfs-tree/${path}"
        scanned=$((scanned + 1))
        if [ ! -f "${new}" ]; then
            absent_payload=$((absent_payload + 1))
            continue
        fi
        if cmp -s "${running_sys}/${path}" "${new}"; then
            same_payload=$((same_payload + 1))
            continue
        fi
        if [ ! -f "${upper}/${path}" ]; then
            untouched=$((untouched + 1))
            continue
        fi
        if cmp -s "${running_sys}/${path}" "${upper}/${path}"; then
            same_user=$((same_user + 1))
            continue
        fi
        printf 'conflict path=/%s result=keep-user action=report\n' "${path}" >>"${report}"
        conflicts=$((conflicts + 1))
    done
fi
if [ -d "${work}/rootfs-tree/etc/uci-defaults" ]; then
    uci_defaults="$(find "${work}/rootfs-tree/etc/uci-defaults" -type f | wc -l | tr -d ' ')"
fi
printf 'scan checked=%s payload-absent=%s payload-same=%s user-untouched=%s user-same=%s upper=%s\n' \
    "${scanned}" "${absent_payload}" "${same_payload}" "${untouched}" "${same_user}" "${upper:-none}" >>"${report}"
printf 'conflicts=%s uci-defaults=%s\n' "${conflicts}" "${uci_defaults}" >>"${report}"

# Publish the report on the ESP with the documented 32 KiB truncation. A dry run publishes
# nothing: "check only, nothing written" has to be true of the ESP too, and a stale report
# from a check would look exactly like the report of the last real upgrade.
if [ "${check_mode}" = "1" ]; then
    say "ab-upgrade: check mode, the conflict report stays in ${report}"
elif [ -d "${AB_ESP}/ab" ]; then
    tmp_report="${AB_ESP}/ab/conflicts.log.tmp.$$"
    if [ "$(wc -c <"${report}")" -gt "${LOG_MAX}" ]; then
        tail -c $((LOG_MAX - 512)) "${report}" >"${tmp_report}"
        printf 'TRUNCATED=1\n' >>"${tmp_report}"
    else
        cat "${report}" >"${tmp_report}"
    fi
    sync
    mv "${tmp_report}" "${AB_ESP}/ab/conflicts.log" || fail "cannot-publish-conflicts"
    sync
fi
say "ab-upgrade: ${conflicts} conflict(s), ${uci_defaults} uci-defaults script(s)"

if [ "${check_mode}" = "1" ]; then
    # A dry run that accepts a payload the install then refuses is a trap. The bootloader
    # member is checked here with the same rules the write applies - member, manifest
    # block, the loader's digest, room on the ESP - and nothing on the ESP is touched.
    if [ -n "${boot_member}" ]; then
        my_loader_sha="$(printf '%s' "${squeezed}" | sed -n 's/.*"loader_sha256":"\([0-9a-f]*\)".*/\1/p')"
        my_loader_bytes="$(printf '%s' "${squeezed}" | sed -n 's/.*"loader_bytes":\([0-9][0-9]*\).*/\1/p')"
        my_menu_sha="$(printf '%s' "${squeezed}" | sed -n 's/.*"menu_sha256":"\([0-9a-f]*\)".*/\1/p')"
        [ -n "${my_loader_sha}" ] && [ -n "${my_loader_bytes}" ] && [ -n "${my_menu_sha}" ] \
            || refuse "bootloader-manifest-incomplete"
        mkdir -p "${work}/boot-check"
        tar -xf "${work}/boot.tar" -C "${work}/boot-check" 2>/dev/null || refuse "payload-not-a-tar"
        [ -f "${work}/boot-check/EFI/BOOT/BOOTX64.EFI" ] || refuse "bootloader-member-incomplete"
        [ -f "${work}/boot-check/boot/grub/grub.cfg" ] || refuse "bootloader-menu-missing"
        checked_loader="$(sha256sum "${work}/boot-check/EFI/BOOT/BOOTX64.EFI" 2>/dev/null | cut -d' ' -f1)"
        [ "${checked_loader}" = "${my_loader_sha}" ] || refuse "bootloader-digest-mismatch"
        checked_menu="$(sha256sum "${work}/boot-check/boot/grub/grub.cfg" 2>/dev/null | cut -d' ' -f1)"
        [ "${checked_menu}" = "${my_menu_sha}" ] || refuse "bootloader-menu-mismatch"
        # The same headroom rule as the write, read the same way, so a dry run and an
        # install cannot disagree about whether the loader fits.
        check_avail="$(df -k "${AB_ESP}" 2>/dev/null \
            | awk 'NR > 1 && $4 ~ /^[0-9]+$/ { print $4; exit }')"
        [ -n "${check_avail}" ] || refuse "bootloader-space-unknown"
        # The same margin the write uses, so the two cannot disagree about whether the
        # loader fits.
        [ "${check_avail}" -ge "$((my_loader_bytes / 1024 + 4096))" ] || refuse "bootloader-no-space"
        check_esp="$(printf '%s' "${status_out}" | sed -n 's/.* esp=\([a-z]*\).*/\1/p')"
        case "${check_esp}" in
            dirty | unreadable)
                say "ab-upgrade: the ESP is ${check_esp}, an install would refuse the bootloader write"
                refuse "bootloader-esp-${check_esp}"
                ;;
        esac
        say "ab-upgrade: bootloader ok (${my_loader_bytes} bytes, 5 member(s) verified)"
    fi
    say "ab-upgrade: check only, nothing written"
    exit 0
fi

# --------------------------------------------------------------------------- #
# 5b. The package plan: predict, ask once, prefetch (design.md §5-§8)
# --------------------------------------------------------------------------- #
# This sits between the conflict report and the first write, and the order is the point: the
# gate, the block and the question are predictions made in /tmp, and the slot is written only
# after a 0 comes back. `apk --root` answers about a tree rather than about the machine
# running the gate, so the tree that will be booted is staged from what already exists:
# the payload's own /etc/apk (the base's pins and feeds), the user's writable layer (their
# world, their custom feeds, their installed database) and the payload's own aligner, which
# pins that copy to this base exactly as the install is about to. Staging costs neither a
# mount nor a slot write, which is what "nothing before the answer" needs.
pkg_question_mode="follow"
if [ "${system_only_mode}" = "1" ]; then
    pkg_question_mode="system-only"
elif [ "${yes_mode}" = "1" ]; then
    pkg_question_mode="yes"
fi

# Every prediction in this section is built here and dropped at exit: staging is a tree that
# never touches a slot, which is what lets the answer come before the first write. The
# override exists for the same reason ${work} has one: a test that must inspect the staging
# tree cannot do it from /tmp/ab-upgrade.$$ after the process has gone.
pkg_stage="${pkg_stage:-${work}/pkgplan}"
# `--system-only` is the exit the plan block has to name when a package is held back, so it
# is decided here and read by platform.sh when it writes the record: a switch the user asked
# to be system-only must not leave `follow=pending` behind it. It is decided before the
# engine check because an older payload carries no plan engine and still has to honour it.
AB_PACKAGES_PLAN_MODE="${pkg_question_mode}"
export AB_PACKAGES_PLAN_MODE
pkg_engine=""
if [ -n "${platform_member}" ] && [ -f "${work}/${platform_member}" ]; then
    rm -rf "${work}/pkgplan-lib" 2>/dev/null || :
    if mkdir -p "${work}/pkgplan-lib" 2>/dev/null &&
        tar -xf "${work}/${platform_member}" -C "${work}/pkgplan-lib" 2>/dev/null &&
        [ -f "${work}/pkgplan-lib/lib/upgrade/packages.sh" ] &&
        [ -f "${work}/pkgplan-lib/lib/ab-plan.sh" ]; then
        pkg_engine="${work}/pkgplan-lib"
    fi
fi

if [ -z "${pkg_engine}" ]; then
    # A payload built before this release has no plan engine. Rendering a block whose counts
    # nobody computed would be the kind of guess this project keeps paying for, so it says so
    # and leaves the follow to the first boot, which reads the record the install writes.
    say "ab-upgrade: this payload carries no package plan; the packages are left to the first boot"
else
    # shellcheck source=/dev/null
    . "${pkg_engine}/lib/upgrade/packages.sh"
    # shellcheck source=/dev/null
    . "${pkg_engine}/lib/ab-plan.sh"
    # The existing switch for tests that answer a question without a terminal; ab-plan.sh
    # spells it with its own name so it can be asked for one block at a time.
    AB_PLAN_ASSUME_TTY="${AB_UPGRADE_ASSUME_TTY:-}"
    export AB_PLAN_ASSUME_TTY

    pkg_sys="${pkg_stage}/sys"
    pkg_layer="${pkg_stage}/layer"
    pkg_target="${pkg_stage}/target"
    pkg_upper="${AB_P4}/${running_layer}/upper"
    rm -rf "${pkg_stage}" 2>/dev/null || :
    mkdir -p "${pkg_sys}/etc/apk" "${pkg_layer}/etc/apk" "${pkg_target}/etc/apk" "${pkg_target}/lib/apk" ||
        refuse "plan-stage-failed"
    cp -a "${work}/rootfs-tree/etc/apk/." "${pkg_sys}/etc/apk/" 2>/dev/null || refuse "plan-stage-failed"
    cp -a "${pkg_upper}/etc/apk/." "${pkg_layer}/etc/apk/" 2>/dev/null || :
    cp -a "${pkg_upper}/lib/apk/." "${pkg_target}/lib/apk/" 2>/dev/null || :
    # The same aligner, on a copy: a staging world pinned any other way would predict a
    # different transaction than the one the first boot runs.
    if ! ab_packages_align "${work}" "${other}" "${pkg_sys}" "${pkg_layer}" >/dev/null 2>&1; then
        say "ab-upgrade: the plan cannot align the staging copy (${AB_PACKAGES_REASON:-failed}); the plan is a system-only switch"
    fi
    cp -a "${work}/rootfs-tree/etc/apk/." "${pkg_target}/etc/apk/" 2>/dev/null || refuse "plan-stage-failed"
    cp -a "${pkg_layer}/etc/apk/." "${pkg_target}/etc/apk/" 2>/dev/null || :

    ab_packages_gate "${pkg_target}" "${pkg_sys}"
    pkg_gate_rc=$?

    # Counts for the block. Held back are the entries the gate could name a reason for; the
    # rest of the world is what the question offers to follow, and the local ones among the
    # held back are the replay candidates (design.md §6).
    pkg_held=0
    pkg_replay=0
    for pkg_item in ${AB_PACKAGES_GATE_SKIPPED:-}; do
        pkg_held=$((pkg_held + 1))
        case "${pkg_item}" in
            local:*) pkg_replay=$((pkg_replay + 1)) ;;
        esac
    done
    # The count the question offers is the set the follow will actually move: the same rule the
    # follow uses, so the number on the block and the work the first boot does cannot differ by
    # the pins, the negations and the tagged entries that are never followed.
    pkg_world_n=$(grep -v '^[[:space:]]*$' "${pkg_target}/etc/apk/world" 2>/dev/null |
        grep -v '^[[:space:]]*[!@]' |
        grep -vc '^kernel=') || pkg_world_n=0
    case "${pkg_world_n}" in
        '' | *[!0-9]*) pkg_world_n=0 ;;
    esac
    pkg_follow_n=$((pkg_world_n - pkg_held))
    [ "${pkg_follow_n}" -ge 0 ] || pkg_follow_n=0
    [ "${pkg_gate_rc}" = "1" ] && pkg_follow_n=0

    pkg_gate_line="feeds answer, every constraint solves"
    case "${AB_PACKAGES_GATE_STATE}" in
        gap) pkg_gate_line="${pkg_held} of ${pkg_world_n} entries are held back; the rest can follow" ;;
        blocked) pkg_gate_line="the follow cannot run: ${AB_PACKAGES_GATE_REASON}" ;;
    esac

    pkg_plan_file="${work}/package-plan.txt"
    {
        printf 'section Update\n'
        printf 'row base %s -> %s\n' "${installed}" "${rootfs_version}"
        printf 'row platform %s -> %s\n' \
            "$(platform_release_value PLATFORM_VERSION 2>/dev/null || echo unknown)" "${platform_version:-unknown}"
        printf 'section Packages\n'
        printf 'row follow %s to follow, %s held back, %s replay from local copies\n' \
            "${pkg_follow_n}" "${pkg_held}" "${pkg_replay}"
        printf 'row gate %s\n' "${pkg_gate_line}"
        # One group per attribution token, in the order design.md §3 names them rather than
        # the order the gate happened to find them. `unreachable` has no per-package token -
        # apk never says which source failed - so its group is whatever apk named as
        # unsolvable, and it is empty unless the gate is blocked.
        for pkg_gap in pinned gone no-copy stale-abi unreachable; do
            case "${pkg_gap}" in
                no-copy) pkg_token="local" ;;
                unreachable) pkg_token="" ;;
                *) pkg_token="${pkg_gap}" ;;
            esac
            pkg_members=""
            if [ -n "${pkg_token}" ]; then
                for pkg_item in ${AB_PACKAGES_GATE_SKIPPED:-}; do
                    case "${pkg_item}" in
                        "${pkg_token}":*) pkg_members="${pkg_members} ${pkg_item#*:}" ;;
                    esac
                done
            else
                pkg_members="${AB_PACKAGES_GATE_BLOCKED:-}"
            fi
            [ -n "$(printf '%s' "${pkg_members}" | tr -d ' ')" ] || continue
            case "${pkg_gap}" in
                pinned)
                    pkg_cause="version held by world"
                    pkg_effect="no action; a base switch rewrites it from the new base"
                    ;;
                gone)
                    pkg_cause="no source offers it for ${rootfs_version}"
                    pkg_effect="world entry removed; the package stays installed"
                    ;;
                no-copy)
                    pkg_cause="local packages with no .apk kept"
                    pkg_effect="kept as installed; reinstall one to keep a copy for replay"
                    ;;
                stale-abi)
                    pkg_cause="built for another kernel than this base"
                    pkg_effect="not replayed; the installed module stays"
                    ;;
                unreachable)
                    pkg_cause="the feed did not answer"
                    pkg_effect="kept as installed; the follow retries them when the feed is back"
                    ;;
            esac
            printf 'gap %s %s\n' "${pkg_gap}" "${pkg_cause}"
            for pkg_name in ${pkg_members}; do
                printf 'member %s\n' "${pkg_name}"
            done
            printf 'effect %s\n' "${pkg_effect}"
        done
        printf 'section Config\n'
        printf 'row files %s files differ from their package\n' "${conflicts}"
        printf 'row keep apk keeps your file and writes the package copy as *.apk-new\n'
        printf 'note apk keeps your configuration; only the package copy changes.\n'
        if [ "${pkg_held}" -gt 0 ]; then
            printf 'warn %s packages keep their current version: --system-only replaces the system alone, --no-follow does the same, and --yes answers this question.\n' \
                "${pkg_held}"
        fi
        printf 'count %s\n' "${pkg_follow_n}"
    } >"${pkg_plan_file}" || refuse "plan-data-failed"

    ab_plan_present "${pkg_plan_file}" "${pkg_question_mode}"
    pkg_plan_rc=$?
    rm -f "${pkg_plan_file}" 2>/dev/null || :
    case "${pkg_plan_rc}" in
        0) : ;;
        # A refusal is exit 0 and no write, because "no" is not a failure of the machine.
        10) say "ab-upgrade: declined, nothing was written"; exit 0 ;;
        74) refuse "noninteractive" ;;
        *) fail "plan-render" ;;
    esac

    # The download happens now, after the answer, into the staging tree: it is the only way
    # the first boot can apply the follow with `apk --network=0`, which is what takes captive
    # portals and home outages off the critical path. A prefetch that fails is not an upgrade
    # that fails - the record falls back to the network fallback at first boot.
    if [ "${pkg_question_mode}" != "system-only" ] && [ "${pkg_gate_rc}" != "1" ] && [ "${prefetch_mode}" = "1" ]; then
        if ab_packages_prefetch "${pkg_target}" "${AB_PACKAGES_GATE_SKIPPED:-}"; then
            say "ab-upgrade: prefetched ${AB_PACKAGES_PREFETCH_COUNT} package(s), ${AB_PACKAGES_PREFETCH_CACHE} bytes, for the first boot"
        else
            say "ab-upgrade: prefetch ${AB_PACKAGES_PREFETCH_STATE:-skipped} (${AB_PACKAGES_PREFETCH_REASON:-unknown}); the first boot will use the network"
        fi
    fi
fi

# --------------------------------------------------------------------------- #
# 6. Copy into the inactive slot
# --------------------------------------------------------------------------- #

packages_state="unknown"
platform_upgrade_begin "${work}" "${other}" || refuse "${upgrade_reason}"
# A `bootloader-*` failure means the ESP write was either never started or already rolled
# back, i.e. nothing changed: that is the documented "refused before anything was written"
# case (74), not the "an execution step failed" one (1). Everything else keeps exit 1.
if ! platform_copy_rootfs "${work}" "${other}"; then
    # The bootloader stage runs before the slot writes, so a failure here may have left the
    # ESP on the new loader. Putting it back is the difference between "the upgrade failed"
    # and "the machine changed".
    # A failed rollback means the ESP may carry the new bootloader while the slot and the
    # state file are still the old ones: that is not the "refused before anything was
    # written" case 74 promises, so it has to leave as a failure and say so loudly.
    if ! upgrade_bootloader_rollback; then
        say "ab-upgrade: the ESP bootloader may carry this payload while slot ${running} still runs ${installed}"
        console_say "ab-upgrade: rollback-failed slot=${other} reason=${upgrade_reason}"
        fail "bootloader-rollback-failed"
    fi
    case "${upgrade_reason}" in
        bootloader-*) refuse "${upgrade_reason}" ;;
        *) fail "${upgrade_reason}" ;;
    esac
fi
if ! platform_upgrade_end "${other}" "${UPGRADE_NEW_VERSION}" "${UPGRADE_NEW_LAYER}"; then
    # The slot is written but not announced; the ESP may already carry the new bootloader.
    # Rolling it back keeps the pair consistent, and the reason says the slot was written.
    upgrade_bootloader_rollback || say "ab-upgrade: warning: the ESP bootloader could not be rolled back"
    fail "${upgrade_reason}"
fi
# One line about what the machine can install afterwards, read back from the file the
# adapter published rather than remembered from the call.
packages_state="$(sed -n 's/^packages=\([a-z]*\).*/\1/p' "${AB_ESP}/ab/packages" 2>/dev/null | tail -n 1)"
[ -n "${packages_state}" ] || packages_state="unknown"

# Reclaim layers nothing references any more; a failed gc must not undo the upgrade.
if ab-slot gc >/tmp/ab-upgrade-gc.log 2>&1; then
    reclaimed="$(grep -c 'ab-slot: deleting' /tmp/ab-upgrade-gc.log 2>/dev/null)"
    [ -n "${reclaimed}" ] || reclaimed=0
else
    reclaimed=0
    say "ab-upgrade: reclamation reported problems, see ab-slot gc"
fi

say "ab-upgrade: installed ${rootfs_version} into slot ${other} (${UPGRADE_NEW_LAYER}), ${conflicts} conflict(s), reclaimed ${reclaimed}"
say "ab-upgrade: bootloader ${UPGRADE_BOOTLOADER_STATE:-unchanged}, package meta ${packages_state:-unknown}"
console_say "ab-upgrade: ok slot=${other} conflicts=${conflicts} reclaimed=${reclaimed} bootloader=${UPGRADE_BOOTLOADER_STATE:-unchanged} packages=${packages_state:-unknown}"
exit 0
