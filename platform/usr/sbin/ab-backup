#!/bin/sh
# ab-backup - export the data a machine can be rebuilt from.
#
# The A/B model rebuilds a machine by installing an image and then pouring the data
# back in, so the backup is not "some files": it is one fixed list, produced the same
# way every time, and restorable by ab-restore without a human deciding what matters.
#
# The list (and nothing outside it):
#
#   data/        the whole of @data (mounted at /data)
#   etc/config/  the running slot's overlay upper etc/config - the files that were
#                changed on this machine and would otherwise be lost with the layer
#   meta/        the bookkeeping that explains the machine: ab/state.json,
#                ab/device.json, ab/image.json from the ESP, and the first-boot growth
#                record (.ab/grow, .ab/grow.log) from the writable partition, plus a
#                manifest written here
#   docker/      @docker (mounted at /opt/docker), only with --with-docker
#
# The prefix a category gets inside the archive is the basename of its mount: the
# running system mounts /data and /opt/docker, so the members are exactly data/... and
# docker/.... etc/config keeps the path it has on disk. Nothing is renamed at restore
# time; ab-restore reads the same three names.
#
# How the archive is built. The target's tar is BusyBox v1.37.0, which is a smaller tar
# than GNU's: no second -C, no --exclude, no --strip-components (measured on the
# device). A symlink farm built with `cp -al` is not an option either - @data, @docker
# and the writable partition are separate btrfs subvolumes and hard links do not cross
# subvolumes. So the member names are produced by assembling one staging root first:
#
#   STAGE/data          read-only snapshot of @data       (btrfs subvolume snapshot -r)
#   STAGE/docker        read-only snapshot of @docker     (with --with-docker)
#   STAGE/etc/config    real copy of the slot's copy-up config
#   STAGE/meta          real copies of the bookkeeping files
#
# then one tar runs over it:
#
#   tar -czf ARCHIVE -C STAGE data docker etc meta
#
# One -C, one tar, and no -h: -h would dereference symlinks and recurse into directory
# symlinks across the whole tree, which changes what the data means. The package is
# supposed to carry the tree as it is. Staging also means the archive can be written
# into the output directory without tar reading its own output back.
#
# Consistency: a category is staged from a read-only snapshot when btrfs can take one,
# so the archive is a point in time. When the snapshot cannot be taken - no btrfs tool,
# a filesystem that is not btrfs, no space - the category is copied for real with
# `cp -a` into the same staging root, the run warns on stderr and reports
# consistency=live, because that copy is not point-in-time. The copy costs a second copy
# of the data while it runs; that is the price of not dereferencing anything and not
# rewriting the tree, and it is paid only on the degraded path.
#
# Space: the size is estimated and compared with the free space of the output directory
# before anything is written. A package that cannot fit is refused, not half written: a
# truncated archive that looks complete is worse than no archive. The copy fallback
# checks the staging filesystem the same way before it starts copying.
#
# The output directory must exist; ab-backup never creates it. `refuse:` means nothing
# was written, and guessing a directory on the caller's behalf is not what a refusal is
# for - `mkdir -p` first, then point --out at it.
#
# Output (stdout, one machine readable line each):
#   backup=<absolute path of the archive>
#   sha256=<path of the .sha256 file>
#   entries data=<n> etc=<n> docker=<n> meta=<n>
#   consistency=snapshot|live
#
# Refusals print `refuse: <reason>` on stderr and exit 3. Usage errors exit 2.
#
# Environment:
#   AB_ESP        ESP mount point            (default /boot)
#   AB_P4         writable partition mount   (default /mnt/p4)
#   AB_DATA       @data mount point          (default /data)
#   AB_DOCKER     @docker mount point        (default /opt/docker)
#   AB_CMD        /proc/cmdline equivalent   (default /proc/cmdline, for tests)
#   AB_BTRFS      the btrfs binary           (default btrfs; point it at a missing path
#                                            to exercise the copy fallback)
#   AB_SLOT_BIN   ab-slot to ask for the running slot and its layer
#   AB_AVAIL_KB   free space to assume, instead of asking df (for tests)

set -u
# Keep whatever PATH we were given in front: the running system already supplies these
# directories, and a test or a chroot can provide its own tools.
PATH="${PATH:+${PATH}:}/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

AB_BTRFS="${AB_BTRFS:-btrfs}"
AB_ESP="${AB_ESP:-/boot}"
AB_P4="${AB_P4:-/mnt/p4}"
AB_DATA="${AB_DATA:-/data}"
AB_DOCKER="${AB_DOCKER:-/opt/docker}"
AB_CMD="${AB_CMD:-/proc/cmdline}"
AB_SLOT_BIN="${AB_SLOT_BIN:-}"
AB_AVAIL_KB="${AB_AVAIL_KB:-}"

DATA_PREFIX=data
DOCKER_PREFIX=docker
ETC_REL=etc/config
META_PREFIX=meta

WITH_DOCKER=0
DRY_RUN=0
PLAIN=0
OUT_DIR=""

# The staging root the archive is assembled in, and the consistency of what went into it.
# Both are globals because the exit trap has to take the staging root back.
STAGE=""
CONSISTENCY="snapshot"

say() {
    printf '%s\n' "$*" >&2
}

die() {
    say "ab-backup: $*"
    exit 1
}

# refuse: the request cannot be honoured and nothing was written. The prefix is the
# contract ab-restore and the docs use, so a caller can tell "no" from "broken".
refuse() {
    say "refuse: $*"
    exit 3
}

usage() {
    say "usage: ab-backup [--with-docker] [--out <dir>] [--dry-run] [--plain]"
    exit 2
}

# --------------------------------------------------------------------------- #
# The machine this runs on
# --------------------------------------------------------------------------- #

# ab_slot_path: the tool that owns the state file format. It is asked rather than
# re-parsed here, so one format keeps one parser.
ab_slot_path() {
    if [ -n "${AB_SLOT_BIN}" ]; then
        printf '%s' "${AB_SLOT_BIN}"
        return 0
    fi
    for _candidate in /usr/sbin/ab-slot "$(dirname "$0")/ab-slot"; do
        if [ -f "${_candidate}" ]; then
            printf '%s' "${_candidate}"
            return 0
        fi
    done
    return 1
}

# read_slot: set SLOT and UPPER from what ab-slot reports for this boot. Both are
# required: the layer name decides which etc/config is exported, and it is never
# derived from a version string here.
read_slot() {
    SLOT=""
    UPPER=""
    _bin="$(ab_slot_path)" || refuse "ab-slot not found, cannot resolve the running slot"
    # Installed, ab-slot is executable; in a checkout or a mounted image it is a plain
    # file, and asking the shell to read it is how every other tool runs it too.
    if [ -x "${_bin}" ]; then
        _line="$("${_bin}" status 2>/dev/null)" \
            || refuse "ab-slot status failed, the slot state is unreadable"
    else
        _line="$(sh "${_bin}" status 2>/dev/null)" \
            || refuse "ab-slot status failed, the slot state is unreadable"
    fi
    for _kv in ${_line}; do
        case "${_kv}" in
            slot=*) SLOT="${_kv#*=}" ;;
            upper=*) UPPER="${_kv#*=}" ;;
        esac
    done
    [ -n "${SLOT}" ] || refuse "ab-slot status reported no slot"
    [ -n "${UPPER}" ] || refuse "ab-slot status reported no writable layer for slot ${SLOT}"
}

# meta_source <relative path>: where a meta file is on this machine, allowing for the
# two layouts of the writable partition. The initramfs writes p4's subvolume root, so
# the record is either directly under the mount or under the running slot's layer.
meta_source() {
    for _candidate in "${AB_P4}/$1" "${AB_P4}/${UPPER}/$1"; do
        if [ -f "${_candidate}" ]; then
            printf '%s' "${_candidate}"
            return 0
        fi
    done
    return 1
}

# host_name: the machine's name, for the archive name and the manifest. `hostname` is not
# in the image the target boots (measured), so the kernel's own answer is asked for next
# and the name is reduced to characters a file name can carry.
host_name() {
    _name="$(hostname 2>/dev/null)" || _name=""
    [ -n "${_name}" ] || _name="$(uname -n 2>/dev/null)"
    [ -n "${_name}" ] || _name="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
    [ -n "${_name}" ] || _name="unknown"
    printf '%s' "${_name}" | tr -c 'A-Za-z0-9._-' '-'
}

# --------------------------------------------------------------------------- #
# Sizes
# --------------------------------------------------------------------------- #

size_kb() { # path...
    _total=0
    for _path in "$@"; do
        [ -e "${_path}" ] || continue
        _kb="$(du -sk "${_path}" 2>/dev/null | awk '{print $1}')"
        _total=$((_total + ${_kb:-0}))
    done
    printf '%s' "${_total}"
}

# avail_kb <dir>: free space of the filesystem <dir> lives on. BusyBox df answers for a
# directory inside a mount, but not for a btrfs subvolume directory that is not itself a
# mount point ("can't find mount point", measured), so the nearest ancestor it does
# answer for is asked instead: that ancestor is on the same filesystem.
avail_kb() { # dir
    if [ -n "${AB_AVAIL_KB}" ]; then
        printf '%s' "${AB_AVAIL_KB}"
        return 0
    fi
    _path="$1"
    while [ -n "${_path}" ]; do
        _kb="$(df -Pk "${_path}" 2>/dev/null | awk 'NR == 2 { print $4 }')"
        if [ -n "${_kb}" ]; then
            printf '%s' "${_kb}"
            return 0
        fi
        _up="$(dirname "${_path}")"
        [ "${_up}" = "${_path}" ] && break
        _path="${_up}"
    done
    printf ''
}

count_entries() { # dir: top level entries, 0 when it is not there
    if [ -d "$1" ]; then
        ls -A "$1" 2>/dev/null | wc -l | tr -d ' '
    else
        printf '0'
    fi
}

# under <path> <root>: the path is the root or inside it.
under() {
    case "$1" in
        "$2" | "$2"/*) return 0 ;;
    esac
    return 1
}

# --------------------------------------------------------------------------- #
# Staging
# --------------------------------------------------------------------------- #

cleanup() {
    [ -n "${STAGE}" ] || return 0
    # The snapshots go first: rm cannot remove a subvolume in one step, and a snapshot
    # left behind on the writable partition would hold its extents forever. A category
    # that was copied rather than snapshotted makes the delete fail silently, and the
    # rm below is what removes it.
    for _prefix in "${DATA_PREFIX}" "${DOCKER_PREFIX}"; do
        [ -d "${STAGE}/${_prefix}" ] || continue
        "${AB_BTRFS}" subvolume delete "${STAGE}/${_prefix}" >/dev/null 2>&1 || :
    done
    rm -rf "${STAGE}" 2>/dev/null || :
    rmdir "${STAGE}" 2>/dev/null || :
    STAGE=""
}

# make_stage: create the staging root the archive is assembled in. The writable
# partition is preferred - it has room and it is not inside the tree being read - then
# the output directory, then /tmp. A candidate inside @data or @docker is skipped: the
# copy of a tree cannot be built inside the tree it copies, so the copy fallback would
# recurse into itself.
make_stage() {
    _stamp="$(date -u +%Y%m%dT%H%M%S)"
    for _cand in \
        "${AB_P4}/@backup-${_stamp}-$$" \
        "${OUT_ABS}/.ab-backup.$$" \
        "${TMPDIR:-/tmp}/.ab-backup.$$"; do
        if under "${_cand}" "${AB_DATA}" || under "${_cand}" "${AB_DOCKER}"; then
            continue
        fi
        _parent="$(dirname "${_cand}")"
        [ -d "${_parent}" ] || continue
        [ -w "${_parent}" ] || continue
        [ -e "${_cand}" ] && continue
        if mkdir "${_cand}" 2>/dev/null; then
            STAGE="${_cand}"
            return 0
        fi
    done
    die "no usable staging directory: ${AB_P4} and ${OUT_ABS} are not writable"
}

# stage_tree <source> <name>: put one category into the staging root under the name it
# must have inside the archive. Returns 0 when it is a read-only snapshot (a point in
# time) and 1 when it had to be copied (not a point in time, reported as live).
stage_tree() {
    _src="$1"
    _name="$2"
    if "${AB_BTRFS}" subvolume snapshot -r "${_src}" "${STAGE}/${_name}" >/dev/null 2>&1; then
        return 0
    fi
    say "ab-backup: warn: cannot snapshot ${_src}, copying it instead (the archive is not a point in time)"
    _need_copy="$(size_kb "${_src}")"
    _free="$(avail_kb "${STAGE}")"
    case "${_free}" in
        '' | *[!0-9]*)
            say "ab-backup: warn: free space of ${STAGE} is unknown, the copy is neither checked nor guaranteed"
            ;;
        *)
            [ "${_free}" -ge "${_need_copy}" ] \
                || refuse "not enough space in ${STAGE} to copy ${_src}: about ${_need_copy} KiB are needed, ${_free} KiB are free"
            ;;
    esac
    mkdir "${STAGE}/${_name}" || die "cannot create ${STAGE}/${_name}"
    cp -a "${_src}/." "${STAGE}/${_name}/" || die "cannot copy ${_src} into ${STAGE}/${_name}"
    return 1
}

# stage_copy <source dir> <relative destination>: a real copy of a directory the archive
# carries as it is on disk (the slot's etc/config, the bookkeeping files). No snapshot:
# these are a handful of small files, they are not a subvolume, and what they have to
# agree with is the slot the manifest names, which is read from the same machine.
stage_copy() {
    _src="$1"
    _dst="${STAGE}/$2"
    mkdir -p "${_dst}" || die "cannot create ${_dst}"
    cp -a "${_src}/." "${_dst}/" || die "cannot copy ${_src} into ${_dst}"
}

# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #

while [ "$#" -gt 0 ]; do
    case "$1" in
        --with-docker) WITH_DOCKER=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --plain) PLAIN=1; shift ;;
        --out)
            [ "$#" -ge 2 ] || usage
            OUT_DIR="$2"
            shift 2
            ;;
        -h | --help) usage ;;
        *) say "ab-backup: unknown argument: $1"; usage ;;
    esac
done

[ -d "${AB_DATA}" ] || refuse "@data is not mounted at ${AB_DATA}"

read_slot

HOST="$(host_name)"

# The output goes next to the data by default: @data is the filesystem that has room,
# and the archive is part of what a rebuild needs.
[ -n "${OUT_DIR}" ] || OUT_DIR="${AB_DATA}"
OUT_ABS="$(cd "${OUT_DIR}" 2>/dev/null && pwd)" || OUT_ABS="${OUT_DIR}"

SUFFIX=.tar.gz
[ "${PLAIN}" = "1" ] && SUFFIX=.tar
NAME="data-${HOST}-$(date -u +%Y%m%dT%H%M)${SUFFIX}"
ARCHIVE="${OUT_ABS}/${NAME}"

UPPER_DIR="${AB_P4}/${UPPER}/upper"
ETC_OK=0
[ -d "${UPPER_DIR}/${ETC_REL}" ] && ETC_OK=1

if [ "${DRY_RUN}" = "1" ]; then
    printf 'plan=%s <- %s (%s entries)\n' "${DATA_PREFIX}" "${AB_DATA}" "$(count_entries "${AB_DATA}")"
    if [ "${ETC_OK}" = "1" ]; then
        printf 'plan=%s <- %s (%s entries)\n' "${ETC_REL}" "${UPPER_DIR}/${ETC_REL}" \
            "$(count_entries "${UPPER_DIR}/${ETC_REL}")"
    else
        printf 'plan=%s <- none (slot %s has no copy-up config)\n' "${ETC_REL}" "${SLOT}"
    fi
    if [ "${WITH_DOCKER}" = "1" ]; then
        printf 'plan=%s <- %s (%s entries)\n' "${DOCKER_PREFIX}" "${AB_DOCKER}" "$(count_entries "${AB_DOCKER}")"
    fi
    printf 'plan=%s <- %s/ab + %s/.ab (bookkeeping and growth record)\n' "${META_PREFIX}" "${AB_ESP}" "${AB_P4}"
    printf 'would-write=%s\n' "${ARCHIVE}"
    printf 'dry-run=1\n'
    exit 0
fi

[ -d "${OUT_ABS}" ] || refuse "output directory ${OUT_ABS} does not exist"
[ -w "${OUT_ABS}" ] || refuse "output directory ${OUT_ABS} is not writable"
[ -e "${ARCHIVE}" ] && refuse "${ARCHIVE} already exists"

# What the same sources are worth now, before a snapshot or a tar is started. The
# estimate is the source size, so it is an upper bound for a compressed package and the
# right figure for a plain one; either way nothing is written that cannot fit.
_need="$(size_kb "${AB_DATA}")"
[ "${ETC_OK}" = "1" ] && _need=$((_need + $(size_kb "${UPPER_DIR}/${ETC_REL}")))
[ "${WITH_DOCKER}" = "1" ] && _need=$((_need + $(size_kb "${AB_DOCKER}")))
_avail="$(avail_kb "${OUT_ABS}")"
case "${_avail}" in
    '' | *[!0-9]*) say "ab-backup: warn: free space of ${OUT_ABS} is unknown, neither checked nor guaranteed" ;;
    *)
        [ "${_avail}" -ge "${_need}" ] \
            || refuse "not enough space in ${OUT_ABS}: the sources need about ${_need} KiB, ${_avail} KiB are free"
        ;;
esac

if [ "${WITH_DOCKER}" = "1" ]; then
    [ -d "${AB_DOCKER}" ] || refuse "@docker is not mounted at ${AB_DOCKER}, cannot honour --with-docker"
fi

make_stage
trap 'cleanup' EXIT
trap 'exit 130' INT TERM HUP

# --- the categories ---------------------------------------------------------
# The counts are taken from the live machine, before staging: they describe what is
# being exported, and a staging root inside the output directory must not be counted.
_meta_data="$(count_entries "${AB_DATA}")"
_meta_etc="$(count_entries "${UPPER_DIR}/${ETC_REL}")"
_meta_docker="$(count_entries "${AB_DOCKER}")"
[ "${WITH_DOCKER}" = "1" ] || _meta_docker=0

# A mixed export - one category snapshotted, one copied live - is reported as live: the
# weaker claim is the true one.
if stage_tree "${AB_DATA}" "${DATA_PREFIX}"; then :; else CONSISTENCY=live; fi
if [ "${WITH_DOCKER}" = "1" ]; then
    if stage_tree "${AB_DOCKER}" "${DOCKER_PREFIX}"; then :; else CONSISTENCY=live; fi
fi

if [ "${ETC_OK}" = "1" ]; then
    stage_copy "${UPPER_DIR}/${ETC_REL}" "${ETC_REL}"
fi

mkdir -p "${STAGE}/${META_PREFIX}" || die "cannot create ${STAGE}/${META_PREFIX}"

for _pair in "state.json:ab/state.json" "device.json:ab/device.json" "image.json:ab/image.json"; do
    _dst="${_pair%%:*}"
    _src_rel="${_pair#*:}"
    [ -f "${AB_ESP}/${_src_rel}" ] || continue
    cp "${AB_ESP}/${_src_rel}" "${STAGE}/${META_PREFIX}/${_dst}" \
        || die "cannot copy ${AB_ESP}/${_src_rel}"
done
for _rel in .ab/grow .ab/grow.log; do
    _dst="$(basename "${_rel}")"
    if _src="$(meta_source "${_rel}")"; then
        cp "${_src}" "${STAGE}/${META_PREFIX}/${_dst}" || die "cannot copy ${_src}"
    fi
done

{
    printf 'archive=%s\n' "${NAME}"
    printf 'created=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'hostname=%s\n' "${HOST}"
    printf 'slot=%s upper=%s\n' "${SLOT}" "${UPPER}"
    printf 'with_docker=%s plain=%s consistency=%s\n' "${WITH_DOCKER}" "${PLAIN}" "${CONSISTENCY}"
    printf 'entries data=%s etc=%s docker=%s\n' "${_meta_data}" "${_meta_etc}" "${_meta_docker}"
} >"${STAGE}/${META_PREFIX}/manifest.txt"

{
    printf '{\n'
    printf '  "archive": "%s",\n' "${NAME}"
    printf '  "created": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "slot": "%s",\n' "${SLOT}"
    printf '  "upper": "%s",\n' "${UPPER}"
    printf '  "with_docker": %s,\n' "$([ "${WITH_DOCKER}" = "1" ] && printf 'true' || printf 'false')"
    printf '  "consistency": "%s",\n' "${CONSISTENCY}"
    printf '  "entries": { "data": %s, "etc": %s, "docker": %s }\n' \
        "${_meta_data}" "${_meta_etc}" "${_meta_docker}"
    printf '}\n'
} >"${STAGE}/${META_PREFIX}/ab-backup.json"

# Counted last: the manifest and the summary above are meta entries too.
_meta_count="$(count_entries "${STAGE}/${META_PREFIX}")"

# --- the archive ------------------------------------------------------------
# One tar, one -C, the categories named as they must appear in the package. The staging
# root is complete before tar starts, so the archive does not contain or read itself,
# and nothing is dereferenced.
set -- "${DATA_PREFIX}"
[ "${WITH_DOCKER}" = "1" ] && set -- "$@" "${DOCKER_PREFIX}"
[ "${ETC_OK}" = "1" ] && set -- "$@" etc
set -- "$@" "${META_PREFIX}"

if [ "${PLAIN}" = "1" ]; then
    tar -cf "${ARCHIVE}" -C "${STAGE}" "$@" || {
        rm -f "${ARCHIVE}" 2>/dev/null || :
        die "tar failed, no package was written"
    }
else
    tar -czf "${ARCHIVE}" -C "${STAGE}" "$@" || {
        rm -f "${ARCHIVE}" 2>/dev/null || :
        die "tar failed, no package was written"
    }
fi

if command -v sha256sum >/dev/null 2>&1; then
    _digest="$(sha256sum "${ARCHIVE}" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
    _digest="$(shasum -a 256 "${ARCHIVE}" | awk '{print $1}')"
else
    rm -f "${ARCHIVE}" 2>/dev/null || :
    die "no sha256sum or shasum, cannot verify the package"
fi
# The digest file carries the absolute path, so `sha256sum -c <file>` works from any
# working directory - which is how the device check runs it.
printf '%s  %s\n' "${_digest}" "${ARCHIVE}" >"${ARCHIVE}.sha256" \
    || die "cannot write ${ARCHIVE}.sha256"

cleanup
sync 2>/dev/null || :

printf 'backup=%s\n' "${ARCHIVE}"
printf 'sha256=%s\n' "${ARCHIVE}.sha256"
printf 'entries data=%s etc=%s docker=%s meta=%s\n' \
    "${_meta_data}" "${_meta_etc}" "${_meta_docker}" "${_meta_count}"
printf 'consistency=%s\n' "${CONSISTENCY}"
say "ab-backup: ${ARCHIVE} (${_meta_data} data, ${_meta_etc} config, ${_meta_docker} docker entries, ${CONSISTENCY})"
