#!/bin/sh
# ab-packages - the package side of an upgrade: what the record says, where a package comes
# from, retry the follow, replay a kept body, and the cache.
#
# A system update replaces a slot; packages are a second transaction with its own way back.
# This command is the human entry point to that second transaction. It owns no state of its
# own: the facts live in
#
#   /boot/ab/packages                  the one-line record (platform/lib/upgrade/packages.sh)
#   /etc/apk/ab/local/<name>-<ver>.apk  bodies kept for a replay (platform/lib/ab-pkgs-assets.sh)
#   /etc/apk/ab/cache/                  one follow's downloads (consumed when it ends)
#
# and every subcommand reads or writes exactly one of them. Two rules hold everywhere:
#
#   * `status`, `sources` and `cache status` write nothing. A question must be answerable on a
#     machine whose upgrade is broken.
#   * nothing that changes the machine runs before a 0 from ab-plan: the plan block is printed,
#     the question is asked, and only a `y` (or `--yes`) starts a transaction. Before that
#     point the only writes are in /tmp, which is why a decline leaves no trace at all.
#
# Subcommands:
#   status                      the record, the gaps it names and how old the last attempt is.
#                               One line of key=value facts on stdout, the explanation on stderr.
#                               It reports the record as written, including the slot it names;
#                               whether that record speaks for *this* boot is `ab-slot status`'s
#                               question, and answering it twice would be two answers.
#   sources [<name>...]         every feed this machine reads, or - for a name - every source
#                               that offers it: `feed`, `customfeeds`, `installed` (a local
#                               package) or `plugin:<label>`. This is where the full URLs are,
#                               because the plan block truncates them. apk answers, and a
#                               plugin's feeds live in no /etc/apk file: when one contributes,
#                               the question is asked again against the file a transaction
#                               would read (_plugins_policy_sources), or the label could never
#                               be named on a real machine.
#   update [--yes] [--only <name>]
#                               retry the follow. Without --only: judge the tree (the gate),
#                               show the plan, ask, then run one `apk upgrade` over the world
#                               and publish the record. With --only: retry that one package with
#                               `apk upgrade <name>`, measure whether it moved, and leave the
#                               record alone - the record describes the whole world, and a
#                               partial transaction must not publish a verdict for it.
#   replay [--yes] [<file.apk>...]
#                               install kept bodies again with `apk add --allow-untrusted`.
#                               With no argument: every kept body. With a file: keep that body
#                               and install it - this is how a local package's body is kept,
#                               because apk keeps nothing by itself (/var is a tmpfs). The
#                               name comes from the package's own metadata; --name/--version
#                               is the last resort for a file no tool here can read, and the
#                               declaration is checked against the package before it is kept.
#   cache status | cache clean  the follow cache: what is in it, or empty it (kept bodies stay).
#   plugins list                every declared plugin on one line: label kind enabled checked
#                               reason feeds packages. `plugins=none` when nothing is declared.
#   plugins repos               the repositories file a transaction would read, printed as it
#                               would be written: the machine's own feeds first, then the feeds
#                               of every enabled, checked, unchanged plugin. Read only.
#   plugins check [<label>...]  the one place this tool goes to the network: is each declared
#                               feed there, and does it offer a higher version of something the
#                               world holds? Writes the verdict the transaction layer reads.
#                               ok = 0, blocked = 74.
#   plugins apply <label> [--yes]
#                               install the packages a plugin declares, in one apk transaction
#                               behind the usual question. Never writes the world record; the
#                               world entry each name gets is written by the apk it runs.
#   --version, -V               the identity this machine was built as, from
#                               /etc/platform-release. Answered before anything else is read.
#
# Environment:
#   AB_ESP              ESP mount point                      (default /boot)
#   AB_PACKAGES_FILE    the published record                 (default $AB_ESP/ab/packages)
#   AB_PACKAGES_ROOT    the tree to read and install into     (default /; a test passes a
#                       fixture so that nothing is installed into the machine running it)
#   AB_PACKAGES_LIB     the record/gate/follow library        (default /lib/upgrade/packages.sh)
#   AB_PKGS_ASSETS_LIB  the kept-body library                 (default /lib/ab-pkgs-assets.sh)
#   AB_PLAN_LIB         the plan block and the one question   (default /lib/ab-plan.sh)
#   AB_VERSION_LIB      version identity                      (default /lib/ab-version.sh)
#   AB_PKGS_CACHE_MAX   the store bound, in bytes             (default 268435456, 256 MiB)
#   AB_PLUGINS_LIB      the plugin library                    (default /lib/ab-plugins.sh)
#   AB_PLUGINS_ROOT     the tree the declarations live in     (default /; they are upper layer,
#                       so this is never the tree being installed into - a test points it at a
#                       fixture the way AB_PACKAGES_ROOT does for the world)
#   AB_PLUGINS_CHECK_TIMEOUT  the wall-clock cap on `plugins check` (default 180)
#
# The plugin subcommands are the only ones that can reach the network, and only `check` does:
# `list` and `repos` read files, `apply` is one apk transaction the person asked for. The
# verdict `check` writes is what lets every *transaction* stay offline (design.md §5).
#
# Exit status: 0 done or nothing to do - a declined question is not a failure and writes nothing,
# which is the same answer ab-upgrade gives; 1 a transaction failed or a question could not be
# answered; 2 usage; 74 refused before anything was written. The refusals name their token on one
# line, `ab-packages: refused, reason=<token>`, like ab-slot and ab-upgrade do.

set -u
# Keep whatever PATH we were given in front: a chroot or a test supplies its own tools, and the
# system directories are appended so the real ones are still found behind any prefix.
PATH="${PATH:+${PATH}:}/usr/sbin:/usr/bin:/sbin:/bin"
export PATH

AB_ESP="${AB_ESP:-/boot}"
AB_PACKAGES_FILE="${AB_PACKAGES_FILE:-${AB_ESP}/ab/packages}"
AB_PACKAGES_ROOT="${AB_PACKAGES_ROOT:-/}"
AB_PACKAGES_LIB="${AB_PACKAGES_LIB:-/lib/upgrade/packages.sh}"
AB_PKGS_ASSETS_LIB="${AB_PKGS_ASSETS_LIB:-/lib/ab-pkgs-assets.sh}"
AB_PLAN_LIB="${AB_PLAN_LIB:-/lib/ab-plan.sh}"
AB_VERSION_LIB="${AB_VERSION_LIB:-/lib/ab-version.sh}"
AB_PLUGINS_LIB="${AB_PLUGINS_LIB:-/lib/ab-plugins.sh}"
AB_PLUGINS_ROOT="${AB_PLUGINS_ROOT:-/}"
AB_PLUGINS_CHECK_TIMEOUT="${AB_PLUGINS_CHECK_TIMEOUT:-180}"

say() {
    printf '%s\n' "$*" >&2
}

die() {
    say "ab-packages: $*"
    exit 1
}

# refuse <token> [<line>...]: the same shape ab-slot uses - one machine-readable line, then the
# sentences a person needs. 74 means "nothing was written", which is true of every caller.
refuse() {
    say "ab-packages: refused, reason=$1"
    shift
    for _rf_line in "$@"; do
        say "  ${_rf_line}"
    done
    exit 74
}

usage() {
    say "usage: ab-packages status|sources [<name>...]|update [--yes] [--only <name>]|replay [--yes] [--name <n> --version <v>] [<file.apk>...]|cache status|clean|plugins list|repos|check [<label>...]|apply <label> [--yes]|--version|-V"
    exit 2
}

# lib_path <configured-path>: the installed path when it exists, otherwise the copy that ships
# beside this tool inside the platform layer. A tool run from a checkout, a mounted image or a
# fixture has to work where it is, and no caller should have to know the layout.
lib_path() {
    _lp_base="$(basename "$1")"
    _lp_self="$(dirname "$0")"
    for _lp_candidate in "$1" \
        "${_lp_self}/../../lib/${_lp_base}" \
        "${_lp_self}/../lib/${_lp_base}" \
        "${_lp_self}/../../lib/upgrade/${_lp_base}"; do
        [ -f "${_lp_candidate}" ] || continue
        printf '%s' "${_lp_candidate}"
        return 0
    done
    return 1
}

# --- the record -------------------------------------------------------------

# _record_field <key>: one single-word field of the published record, or empty. `hint=` is not
# read here: its value holds a space and it is the last field, so it has a reader of its own.
_record_field() {
    [ -r "${AB_PACKAGES_FILE}" ] || return 0
    # Field by field, not by regex: `packages=` is the first field and has no space in front of
    # it, and `reason=` must not be found inside `packages_reason=` of some other writer's line.
    tail -n 1 "${AB_PACKAGES_FILE}" 2>/dev/null | awk -v k="$1" '
        {
            for (i = 1; i <= NF; i++) {
                if (index($i, k "=") == 1) { print substr($i, length(k) + 2); exit }
            }
        }'
}

_record_hint() {
    [ -r "${AB_PACKAGES_FILE}" ] || return 0
    tail -n 1 "${AB_PACKAGES_FILE}" 2>/dev/null | sed -n 's/^.* hint=//p'
}

# _record_age: how long ago the record was last written, in seconds.
#
# The record has no timestamp field and it must not grow one: its vocabulary belongs to the
# library that writes it (design.md §2), and "when did we last try" is a property of the file,
# which every file system keeps. A vfat timestamp is coarse (2 s) and that is fine for a
# question about minutes and hours.
_record_age() {
    _ra_mtime=$(stat -c %Y "${AB_PACKAGES_FILE}" 2>/dev/null) \
        || _ra_mtime=$(stat -f %m "${AB_PACKAGES_FILE}" 2>/dev/null) \
        || _ra_mtime=""
    case "${_ra_mtime}" in
        '' | *[!0-9]*) return 1 ;;
    esac
    [ "${_ra_mtime}" -gt 0 ] || return 1
    _ra_now=$(date -u +%s 2>/dev/null) || return 1
    case "${_ra_now}" in
        '' | *[!0-9]*) return 1 ;;
    esac
    _ra_age=$((_ra_now - _ra_mtime))
    [ "${_ra_age}" -lt 0 ] && _ra_age=0
    printf '%s %s\n' "${_ra_mtime}" "${_ra_age}"
}

# _human_age <seconds>: the same number a person can read at a glance.
_human_age() {
    _ha=$1
    if [ "${_ha}" -lt 90 ]; then
        printf '%ss' "${_ha}"
    elif [ "${_ha}" -lt 5400 ]; then
        printf '%sm' "$((_ha / 60))"
    elif [ "${_ha}" -lt 172800 ]; then
        printf '%sh' "$((_ha / 3600))"
    else
        printf '%sd' "$((_ha / 86400))"
    fi
}

# _iso_utc <epoch>: the moment as a time a log or a bug report can carry.
_iso_utc() {
    date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || printf 'epoch=%s' "$1"
}

# --- status -----------------------------------------------------------------

# _gap_detail <token> <name>: what one attribution token means for the person reading it. The
# tokens are the record's vocabulary (design.md §3), not a second one invented here.
_gap_detail() {
    case "$1" in
        local)
            say "ab-packages:   ${2}: no body was kept, so it cannot be replayed; it stays installed at its version"
            say "ab-packages:     keep it next time: ab-packages replay <file.apk> installs the file and keeps the body"
            ;;
        stale-abi)
            say "ab-packages:   ${2}: built against another kernel; replaying it would install a module that cannot load"
            ;;
        unreachable)
            say "ab-packages:   ${2}: its source did not answer; the world entry is kept for the next attempt"
            ;;
        pinned)
            say "ab-packages:   ${2}: pinned in the world with =, so it is left alone on purpose"
            ;;
        gone)
            say "ab-packages:   ${2}: no source offers it any more; the world entry was removed, the package stays installed"
            ;;
        *)
            say "ab-packages:   ${2}: held back (${1})"
            ;;
    esac
}

cmd_status() {
    _st_packages="unknown"
    # `unknown`, not empty: the record is the only place a follow state can come from, and a
    # machine without one has not "no follow" - it has an answer nobody can give.
    _st_follow="unknown"
    _st_reason="unknown"
    _st_skipped=""
    _st_dropped=""
    _st_upgraded=""
    _st_kept=""
    _st_cache=""
    _st_hint=""
    _st_version=""
    _st_kernel=""
    _st_slot=""
    _st_attempt="unknown"
    if [ -r "${AB_PACKAGES_FILE}" ]; then
        _st_packages="$(_record_field packages)"
        [ -n "${_st_packages}" ] || _st_packages="unknown"
        _st_follow="$(_record_field follow)"
        _st_reason="$(_record_field reason)"
        [ -n "${_st_reason}" ] || _st_reason="unknown"
        _st_skipped="$(_record_field skipped)"
        _st_dropped="$(_record_field dropped)"
        _st_upgraded="$(_record_field upgraded)"
        _st_kept="$(_record_field kept)"
        _st_cache="$(_record_field cache)"
        _st_hint="$(_record_hint)"
        _st_version="$(_record_field version)"
        _st_kernel="$(_record_field kernel)"
        _st_slot="$(_record_field slot)"
        # The record exists but says nothing about a follow: a record written before the field
        # existed. Saying `follow=` nothing would read as "no follow needed"; `unknown` is the
        # honest answer, and a boot worker treats it as due exactly once.
        [ -n "${_st_follow}" ] || _st_follow="unknown"
        if _st_age=$(_record_age); then
            _st_attempt=${_st_age%% *}
            _st_age_secs=${_st_age#* }
        else
            _st_age_secs=""
        fi
    fi

    # The store and the cache are facts of their own: a record can be days old and the bodies it
    # never knew about can still be there.
    _st_assets_line="$(ab_pkgs_assets_report "${AB_PACKAGES_ROOT}")"
    _st_cache_line="$(ab_pkgs_cache_report "${AB_PACKAGES_ROOT}")"
    printf 'packages=%s follow=%s reason=%s upgraded=%s kept=%s skipped=%s cache=%s hint=%s last-attempt=%s\n' \
        "${_st_packages}" "${_st_follow}" "${_st_reason}" "${_st_upgraded:-0}" \
        "${_st_kept:-0}" "${_st_skipped:-none}" "${_st_cache:-0}" "${_st_hint:-none}" \
        "${_st_attempt}"
    printf '%s %s\n' "${_st_assets_line}" "${_st_cache_line}"

    say "ab-packages: record ${AB_PACKAGES_FILE}"
    if [ -r "${AB_PACKAGES_FILE}" ]; then
        say "ab-packages: packages ${_st_packages}, follow ${_st_follow}, reason ${_st_reason} (slot ${_st_slot:-unknown}, base ${_st_version:-unknown}, kernel ${_st_kernel:-unknown})"
    else
        say "ab-packages: no record: nothing here proves a follow was ever attempted (unknown is never aligned)"
    fi
    if [ -n "${_st_skipped}" ] && [ "${_st_skipped}" != "none" ]; then
        say "ab-packages: held back by the last follow (${_st_skipped}):"
        # The list is `kind:name,...`; the kind decides what the person has to do.
        _st_rest=${_st_skipped}
        while :; do
            case "${_st_rest}" in
                *,*) _st_item=${_st_rest%%,*}; _st_rest=${_st_rest#*,} ;;
                *) _st_item=${_st_rest}; _st_rest="" ;;
            esac
            [ -n "${_st_item}" ] || break
            _gap_detail "${_st_item%%:*}" "${_st_item#*:}"
            [ -n "${_st_rest}" ] || break
        done
    elif [ "${_st_packages}" = "unknown" ]; then
        :
    else
        say "ab-packages: the last follow held nothing back"
    fi
    if [ -n "${_st_dropped}" ] && [ "${_st_dropped}" != "none" ]; then
        say "ab-packages: dropped from the world by the prune (${_st_dropped}); the packages stay installed"
    fi
    # A body a feed took back over is no longer in the store, so the journal is the only place
    # its deletion can still be read. Printing it here is what keeps "this package stopped being
    # replayable from a kept body" from becoming a silent narrowing of what the machine can do.
    _st_journal="$(ab_pkgs_assets_dir "${AB_PACKAGES_ROOT}")/superseded"
    if [ -r "${_st_journal}" ]; then
        while IFS= read -r _st_entry; do
            [ -n "${_st_entry}" ] || continue
            say "ab-packages: ${_st_entry} (a feed owns this name now; the kept body is gone)"
        done <"${_st_journal}"
    fi
    if [ -n "${_st_age_secs:-}" ]; then
        say "ab-packages: last attempt $(_human_age "${_st_age_secs}") ago, at $(_iso_utc "${_st_attempt}")"
    else
        say "ab-packages: the last attempt's time is unknown (the record could not be dated)"
    fi
    say "ab-packages: kept bodies: ${_st_assets_line}"
    say "ab-packages: follow cache: ${_st_cache_line}"
    case "${_st_follow}" in
        pending | failed | abandoned)
            say "ab-packages: still owed - retry with: ${_st_hint:-ab-packages update}"
            ;;
        never)
            say "ab-packages: left alone on purpose (follow=never): the last upgrade replaced the system only"
            ;;
    esac
    return 0
}

# --- sources ----------------------------------------------------------------

# _feed_files: every feed file this machine reads, in the order apk reads them.
# `repositories.d/*.list` is the layout of this image; `distfeeds.list` directly under
# /etc/apk is the older one, and a machine upgraded across that change still has it.
_feed_files() {
    _ff_root=$(_root_prefix)
    for _ff_dir in "${_ff_root}/etc/apk/repositories.d" "${_ff_root}/etc/apk"; do
        [ -d "${_ff_dir}" ] || continue
        for _ff_file in "${_ff_dir}"/*.list; do
            [ -f "${_ff_file}" ] || continue
            printf '%s\n' "${_ff_file}"
        done
    done
}

_root_prefix() {
    _rp_root=${AB_PACKAGES_ROOT:-/}
    while [ "${#_rp_root}" -gt 1 ] && [ "${_rp_root%/}" != "${_rp_root}" ]; do
        _rp_root=${_rp_root%/}
    done
    [ "${_rp_root}" = "/" ] && _rp_root=""
    printf '%s' "${_rp_root}"
}

cmd_sources() {
    if [ "$#" -eq 0 ]; then
        _so_any=0
        while IFS= read -r _so_file; do
            [ -n "${_so_file}" ] || continue
            _so_kind=${_so_file##*/}
            _so_kind=${_so_kind%.list}
            while IFS= read -r _so_line; do
                case "${_so_line}" in
                    '' | '#'*) continue ;;
                esac
                printf 'feed=%s url=%s\n' "${_so_kind}" "${_so_line}"
                _so_any=1
            done <<FEED
$(sed 's/[[:space:]]*$//' "${_so_file}" 2>/dev/null)
FEED
        done <<FILES
$(_feed_files)
FILES
        if [ "${_so_any}" -eq 0 ]; then
            printf 'feed=none reason=no-repositories\n'
            say "ab-packages: no feed file on this machine; a package that is not kept locally cannot follow the base"
        fi
        return 0
    fi
    _so_rc=0
    # Best effort: an attribution needs the declarations, and a machine that has none of them
    # is the normal case for everything else here.
    _plugins_load >/dev/null 2>&1 || :
    for _so_name in "$@"; do
        if ! _so_src=$(_plugins_policy_sources "${_so_name}"); then
            printf 'package=%s source=unknown reason=no-answer\n' "${_so_name}"
            _so_rc=1
            continue
        fi
        _so_n=0
        while IFS= read -r _so_url; do
            [ -n "${_so_url}" ] || continue
            _so_n=$((_so_n + 1))
            if [ "${_so_url}" = "lib/apk/db/installed" ]; then
                printf 'package=%s source=installed\n' "${_so_name}"
            else
                printf 'package=%s source=%s url=%s\n' "${_so_name}" \
                    "$(_plugins_source_kind "${_so_url}" || _feed_kind "${_so_url}")" "${_so_url}"
            fi
        done <<SOURCES
${_so_src}
SOURCES
        [ "${_so_n}" -gt 0 ] || {
            printf 'package=%s source=unknown reason=no-answer\n' "${_so_name}"
            _so_rc=1
        }
    done
    return "${_so_rc}"
}

# _feed_kind <url>: which feed list a URL came from, so `sources` can say whether a package comes
# from the release's own feed or from the user's custom one. The distinction matters: the first
# follows the base, the second is somebody's own build.
_feed_kind() {
    while IFS= read -r _fx_file; do
        [ -n "${_fx_file}" ] || continue
        grep -qxF "$1" "${_fx_file}" 2>/dev/null || continue
        _fx_base=${_fx_file##*/}
        printf '%s' "${_fx_base%.list}"
        return 0
    done <<FILES
$(_feed_files)
FILES
    printf 'feed'
}

# _plugins_active: 0 when some declaration contributes a feed right now - enabled, checked ok,
# and unchanged since the check. The same predicate the transaction seam uses, asked of the
# library, because "did a plugin have a say in this machine's feeds" has to have one answer.
_plugins_active() {
    _pac_count=$(ab_plugins_active_count "$(_plugins_root)" 2>/dev/null) || return 1
    case "${_pac_count}" in
        '' | *[!0-9]* | 0) return 1 ;;
    esac
    return 0
}

# _plugins_policy_seam <name>: the `apk policy` answer asked against the file a transaction
# would read - the machine's own feeds, then the feeds of every admitted plugin.
#
# `ab_pkgs_policy_sources` asks apk against /etc/apk, and a plugin's feeds are in no file there
# by design: that question alone can never name one, so `source=plugin:<label>` could not appear
# on a real machine. Here apk is pointed at the same file the follow is given, which is the only
# way the answer describes the sources this machine actually reads. `--no-network` because
# `sources` is a question and only `plugins check` fetches: a feed with no index in the cache
# simply does not appear, exactly as a base feed without one does today.
#
# The directory is private and removed before this returns; the output is read exactly the way
# ab_pkgs_policy_sources reads apk's (header lines end in `:` and are not sources).
_plugins_policy_seam() {
    _pps_tmp=$(_plugins_tmpdir) || return 1
    _pps_file="${_pps_tmp}/repositories"
    if ! _plugins_repos_file "" "${_pps_file}"; then
        _plugins_tmpdrop "${_pps_tmp}"
        return 1
    fi
    _pps_root_args=$(_plugins_apk_root_args)
    # shellcheck disable=SC2086  # --root <dir> as two words, or nothing on the running root
    _pps_out=$(ab_packages_run_bounded "${AB_PLUGINS_CHECK_TIMEOUT:-180}" \
        apk ${_pps_root_args} --no-network --repositories-file "${_pps_file}" \
        policy "$1" 2>/dev/null) || _pps_out=""
    _plugins_tmpdrop "${_pps_tmp}"
    [ -n "${_pps_out}" ] || return 1
    printf '%s\n' "${_pps_out}" | sed 's/^[ \t]*//' | grep -v '^$' | grep -v ':$'
}

# _plugins_policy_sources <name>: every source that offers <name>, in one list.
#
# Two answers merged rather than two commands: the plain one is what this command has always
# printed, the second only exists when a plugin contributes, and it is asked against the file
# that carries the plugin's feeds. Order is "first sighting wins", so the installed database and
# the base stay where apk put them and a plugin's URL is added after. With nothing declared the
# answer is the plain one, byte for byte, and no second apk call is made at all (ac-9).
_plugins_policy_sources() {
    _pqs_name=$1
    _pqs_first=""
    _pqs_have=1
    if _pqs_first=$(ab_pkgs_policy_sources "${AB_PACKAGES_ROOT}" "${_pqs_name}" 2>/dev/null); then
        _pqs_have=0
    fi
    if ! _plugins_active; then
        [ "${_pqs_have}" -eq 0 ] || return 1
        printf '%s\n' "${_pqs_first}"
        return 0
    fi
    _pqs_more=$(_plugins_policy_seam "${_pqs_name}") || _pqs_more=""
    # Deduplicated because both questions name the installed database and every feed in common:
    # one source is one line, whichever question found it first.
    _pqs_all=$(printf '%s\n%s\n' "${_pqs_first}" "${_pqs_more}" | awk 'NF && !seen[$0]++')
    [ -n "${_pqs_all}" ] || return "${_pqs_have}"
    printf '%s\n' "${_pqs_all}"
}

# _plugins_source_kind <url>: `plugin:<label>` when the URL is one a plugin declares, 1 when it
# is not and the caller should fall back to `_feed_kind`.
#
# This cannot be decided from the feed files: a plugin's URLs are in no `/etc/apk` file at all,
# by design, so `_feed_kind` would answer `feed` for them and hide who added the source. The
# question is asked of the declarations instead, and only of the ones that are switched on -
# attribution is a reading aid, but naming a plugin the user disabled would be wrong.
_plugins_source_kind() {
    command -v ab_plugins_validate >/dev/null 2>&1 || return 1
    _psk_url=$1
    _psk_root=$(_plugins_root)
    while IFS= read -r _psk_label; do
        [ -n "${_psk_label}" ] || continue
        ab_plugins_validate "${_psk_root}" "${_psk_label}" || continue
        [ "${AB_PLUGINS_ENABLED}" = "yes" ] || continue
        while IFS= read -r _psk_feed; do
            [ -n "${_psk_feed}" ] || continue
            # A feed is a directory apk appends index files to, so a source can be the URL
            # itself or a path below it.
            case "${_psk_url}" in
                "${_psk_feed}" | "${_psk_feed}"/*)
                    printf 'plugin:%s' "${_psk_label}"
                    return 0
                    ;;
            esac
        done <<FEEDS
$(ab_plugins_feeds "${_psk_root}" "${_psk_label}")
FEEDS
    done <<LABELS
$(ab_plugins_labels "${_psk_root}")
LABELS
    return 1
}

# --- the plan block ---------------------------------------------------------

# _world_entries <root>: the world entries a follow would ask apk for, one per line.
#
# These are the same rules the follow primitive applies (packages.sh `_packages_refresh_world`):
# comments, `@tag` lines and `!constraints` are not packages, and the kernel belongs to ab-slot.
# They are repeated here because the question's number has to describe the transaction, and the
# number is all this file needs - it never builds the transaction itself.
_world_entries() {
    _we_root=$(_root_prefix)
    _we_world="${_we_root}/etc/apk/world"
    [ -f "${_we_world}" ] || return 1
    awk '
        {
            line = $0
            sub(/^[ \t]+/, "", line)
            sub(/[ \t]+$/, "", line)
            if (line == "" || substr(line, 1, 1) == "#") next
            if (substr(line, 1, 1) == "!" || substr(line, 1, 1) == "@") next
            name = line
            sub(/[=<>~].*/, "", name)
            if (name == "kernel") next
            print line
        }
    ' "${_we_world}"
}

# _plan_write <file> <gate-state> <gate-reason> <scope> <gate-skipped>: the plan record
# ab-plan.sh renders.
#
# The block is a prediction and it says so: it is built from the gate (what apk answered about
# the tree this machine runs) and from the record (what the last follow held back). The record
# is the fact; this is the offer.
_plan_write() {
    _pw_file=$1
    _pw_state=$2
    _pw_reason=$3
    _pw_scope=$4
    _pw_gate_skipped=${5:-}
    _pw_total=0
    _pw_gaps=0
    _pw_members=""
    _pw_names=""
    if _pw_world=$(_world_entries); then
        _pw_total=$(printf '%s\n' "${_pw_world}" | grep -c . || true)
        _pw_total=${_pw_total:-0}
    fi
    {
        printf 'section Packages\n'
        printf 'row base %s\n' "$(_record_field version)"
        printf 'row kernel %s\n' "$(_record_field kernel)"
        if [ -n "${_pw_scope}" ]; then
            printf 'row retry %s only\n' "${_pw_scope}"
        fi
        printf 'row judgement %s%s\n' "${_pw_state}" \
            "$([ "${_pw_reason}" = "none" ] && printf '' || printf ' (%s)' "${_pw_reason}")"
        printf 'row world %s entries\n' "${_pw_total}"
    } >"${_pw_file}"
    # The gaps are the attribution of what was held back: the record says what the last follow
    # could not move, and the gate says what it can see about the tree now (a local package
    # installed since the last follow is only in the gate's answer). Both spell the same tokens
    # (design.md §3), so the two lists are merged rather than printed as two groups - and the
    # count the question uses is the world minus what the merged list holds back, never a number
    # that promises more than the block just showed.
    _pw_skipped="$(_record_field skipped)"
    case "${_pw_skipped}" in
        '' | none) _pw_skipped=${_pw_gate_skipped} ;;
        *) [ -z "${_pw_gate_skipped}" ] || _pw_skipped="${_pw_skipped},${_pw_gate_skipped}" ;;
    esac
    if [ -n "${_pw_skipped}" ] && [ "${_pw_skipped}" != "none" ]; then
        _pw_rest=${_pw_skipped}
        while :; do
            case "${_pw_rest}" in
                *,*) _pw_item=${_pw_rest%%,*}; _pw_rest=${_pw_rest#*,} ;;
                *) _pw_item=${_pw_rest}; _pw_rest="" ;;
            esac
            [ -n "${_pw_item}" ] || break
            # A package can be in both lists; it is one member and one line, so the second
            # sighting is skipped without skipping the rest of the list.
            case " ${_pw_names} " in
                *" ${_pw_item} "*)
                    [ -n "${_pw_rest}" ] || break
                    continue
                    ;;
            esac
            _pw_names="${_pw_names} ${_pw_item}"
            _pw_kind=${_pw_item%%:*}
            _pw_name=${_pw_item#*:}
            # One group per kind: ab-plan prints a header per `gap` record, so the kind is
            # opened once and the members are appended under it.
            case " ${_pw_members} " in
                *" ${_pw_kind} "*) ;;
                *)
                    printf 'gap %s held back by the last follow\n' "${_pw_kind}" >>"${_pw_file}"
                    printf 'effect these keep the version they have; the record names why\n' >>"${_pw_file}"
                    _pw_members="${_pw_members} ${_pw_kind}"
                    ;;
            esac
            printf 'member %s\n' "${_pw_name}" >>"${_pw_file}"
            _pw_gaps=$((_pw_gaps + 1))
            [ -n "${_pw_rest}" ] || break
        done
    fi
    _pw_follow=$((_pw_total - _pw_gaps))
    [ "${_pw_follow}" -lt 0 ] && _pw_follow=0
    {
        printf 'count %s\n' "${_pw_follow}"
        printf 'note this is a prediction: the record is what actually happened\n'
        if [ "${_pw_gaps}" -gt 0 ]; then
            printf 'warn %s package(s) keep their current version; the record will name them\n' "${_pw_gaps}"
        fi
    } >>"${_pw_file}"
}

# cmd_update_plan <scope>: the gate, the block, the question. Returns 0 to go ahead.
cmd_update_plan() {
    _up_scope=${1:-}
    _up_state="ok"
    _up_reason="none"
    if ab_packages_gate "${AB_PACKAGES_ROOT}"; then
        _up_state="ok"
    else
        case $? in
            1)
                _up_state="${AB_PACKAGES_GATE_STATE}"
                _up_reason="${AB_PACKAGES_GATE_REASON}"
                # A blocked gate is not a warning: the transaction the first boot would run
                # cannot be solved, so this machine's follow cannot run either. The entries apk
                # named are the whole point of the refusal.
                say "ab-packages: the gate is blocked (reason=${_up_reason})"
                for _up_entry in ${AB_PACKAGES_GATE_BLOCKED}; do
                    say "  could not select: ${_up_entry}"
                done
                refuse "gate-${_up_reason}" \
                    "The packages cannot be resolved against the world this machine runs." \
                    "Next: ab-slot status | grep packages=    then re-run the upgrade that aligned it"
                ;;
            *)
                _up_state="${AB_PACKAGES_GATE_STATE}"
                _up_reason="${AB_PACKAGES_GATE_REASON}"
                ;;
        esac
    fi
    _up_plan="${TMPDIR:-/tmp}/ab-packages-plan.$$"
    _plan_write "${_up_plan}" "${_up_state}" "${_up_reason}" "${_up_scope}" \
        "${AB_PACKAGES_GATE_SKIPPED:-}"
    _up_mode="follow"
    [ "${AB_PACKAGES_ASSUME_YES:-0}" = "1" ] && _up_mode="yes"
    # Rendered straight to stdout, never captured: the block is what the person answers about,
    # and a block swallowed into a variable would leave the question without its context.
    ab_plan_present "${_up_plan}" "${_up_mode}"
    _up_rc=$?
    rm -f "${_up_plan}" 2>/dev/null || :
    return "${_up_rc}"
}

# --- plugins ----------------------------------------------------------------
#
# A plugin is a declaration - extra apk feeds, or a set of package names - and the library that
# judges it (`lib/ab-plugins.sh`) neither runs apk nor reaches the network. What is left for
# this command is the four questions, in the order a person asks them:
#
#   list   what is declared, and what the last check said about it. Reads files only.
#   repos  the repositories file a transaction would read, base lines first. Reads files only.
#   check  is the feed there, and does it shadow what the base offers? The only network stage
#          in this tool, and it writes the verdict every transaction then trusts instead of
#          asking again.
#   apply  install what a plugin names: one apk transaction, behind the usual question.
#
# The verdict is why a transaction stays offline, so a check that cannot answer must say so
# (`unverifiable`) rather than leave "no shadow" behind: a plugin that shadows the base is the
# way a follow silently moves a package the user never asked it to move.

# _plugins_root: the tree the declarations live in. They are upper layer (/etc/ab), replaced by
# no upgrade, so this is never the tree being installed into; AB_PLUGINS_ROOT exists so a test
# can hold them in a temporary tree, exactly as AB_PACKAGES_ROOT does for the world.
_plugins_root() {
    printf '%s' "${AB_PLUGINS_ROOT:-/}"
}

# _plugins_tree_root: the root apk is run against, as a *path* - the tree whose feed files and
# world the questions are about, with no trailing slash and `/` for the running system.
_plugins_tree_root() {
    _ptr=$(_root_prefix)
    [ -n "${_ptr}" ] || _ptr="/"
    printf '%s' "${_ptr}"
}

# _plugins_apk_root_args: the words that name that root to apk.
#
# The running root gets no `--root` at all, which is the discipline every other apk call in
# this project follows (lib/ab-pkgs-assets.sh _ab_pkgs_apk, lib/upgrade/packages.sh
# _packages_follow_apk): `--root` is what makes apk treat a tree as a sandbox, and a
# transaction against the machine the tool is running on must not be one. A fixture root is
# named the only way apk can be told about it. The two words are expanded unquoted by the
# callers, so an empty answer adds nothing and the command line stays the one it always was.
_plugins_apk_root_args() {
    _par_root=$(_root_prefix)
    [ -n "${_par_root}" ] || return 0
    printf '%s %s\n' "--root" "${_par_root}"
}

# _plugins_tmpdir: a private directory for the one file a plugin question needs.
#
# A fixed name under /tmp - `/tmp/repositories`, or any `something.$$` - can be pre-placed by
# another user as a symlink, and this tool truncates what it opens as root. mktemp picks the
# name and the mode (700), so the only thing in the directory is what this process wrote. The
# caller removes it with _plugins_tmpdrop once the file has served its purpose.
_plugins_tmpdir() {
    _ptd_dir=$(mktemp -d "${TMPDIR:-/tmp}/ab-plugins.XXXXXX" 2>/dev/null) || return 1
    printf '%s' "${_ptd_dir}"
}

# _plugins_tmpdrop <path>: remove a directory _plugins_tmpdir made, and nothing else. The name
# is checked rather than trusted: an empty or unexpected answer must never reach `rm -rf`.
_plugins_tmpdrop() {
    _ptdd=${1:-}
    [ -n "${_ptdd}" ] || return 0
    case "${_ptdd}" in
        "${TMPDIR:-/tmp}"/ab-plugins.*) rm -rf "${_ptdd}" 2>/dev/null || : ;;
    esac
    return 0
}

# _plugins_load: read the plugin library once. 1 when this machine has none - the caller decides
# whether that is a refusal (`plugins ...`) or only "no attribution" (`sources`).
_ab_plugins_loaded=""
_plugins_load() {
    [ -n "${_ab_plugins_loaded}" ] && return 0
    _pl_lib=$(lib_path "${AB_PLUGINS_LIB}") || return 1
    # shellcheck source=platform/lib/ab-plugins.sh
    . "${_pl_lib}"
    _ab_plugins_loaded=1
    return 0
}

_plugins_require_lib() {
    _plugins_load && return 0
    refuse plugins-lib-missing \
        "The plugin library is not on this machine: ${AB_PLUGINS_LIB}" \
        "Nothing was changed. Next: re-run the upgrade that installs the platform layer"
}

# _plugins_seam: 0 when the transaction library carries the one repositories seam. A CLI newer
# than its library could still build a repositories file by itself, and that is exactly the
# failure the design forbids: two ways to build it means two views of the feeds on one machine.
_plugins_seam() {
    command -v ab_packages_repos_file >/dev/null 2>&1 \
        && command -v ab_packages_run_bounded >/dev/null 2>&1
}

_plugins_require_seam() {
    _plugins_seam && return 0
    refuse plugins-lib-stale \
        "This ab-packages needs ab_packages_repos_file and ab_packages_run_bounded in ${AB_PACKAGES_LIB}" \
        "Nothing was changed: assembling the repositories file a second way here is how one machine" \
        "ends up with two views of its feeds. Next: re-run the upgrade that installs the platform layer"
}

# _plugins_repos_args: the `--repositories-file <file>` pair the transaction library asks for,
# or nothing. Empty is the answer when no plugin contributes, and then the apk command is the
# one this tool has always run (ac-9); a library older than this CLI has no seam either, and
# `update` must keep working on the machine it is on rather than refuse over a plugin it does
# not have.
#
# The file lives in a directory mktemp made, never in ${TMPDIR} itself: the library makes it, the
# caller removes it once its apk call has returned (_plugins_tmpdrop), and no other user can
# have put anything in it.
_plugins_repos_args() {
    _plugins_load || return 0
    command -v _packages_apk_repos_args >/dev/null 2>&1 || return 0
    # The directory is the library's to make (it makes one only when a plugin contributes), and
    # the caller removes it with _plugins_tmpdrop once its apk call has returned.
    _packages_apk_repos_args "$(_plugins_tree_root)"
}

# _plugins_repos_file <label|""> <out>: the repositories file a transaction would read - the
# machine's own feed files in apk's order, then the feeds of every plugin a transaction may read
# - plus, when a label is named, that plugin's own declared feeds.
#
# The named feeds are what `check` judges and what `apply` installs from: a person naming a
# plugin is the decision, while a *transaction* may only read the feeds a verdict admitted.
# They are appended last and only once, because apk reads a repositories file top to bottom and
# the base must win a tie.
_plugins_repos_file() {
    _prf_label=${1:-}
    _prf_out=$2
    : >"${_prf_out}" 2>/dev/null || return 1
    if ! ab_packages_repos_file "$(_plugins_tree_root)" "${_prf_out}"; then
        # The seam answers 1 for an empty set, and an empty set is a fact about the machine (no
        # feed file and no plugin), not a failure to write one. The file existing is what tells
        # the two apart.
        [ -f "${_prf_out}" ] || return 1
    fi
    [ -n "${_prf_label}" ] || return 0
    while IFS= read -r _prf_url; do
        [ -n "${_prf_url}" ] || continue
        grep -qxF "${_prf_url}" "${_prf_out}" 2>/dev/null && continue
        printf '%s\n' "${_prf_url}" >>"${_prf_out}" || return 1
    done <<FEEDS
$(ab_plugins_feeds "$(_plugins_root)" "${_prf_label}")
FEEDS
    return 0
}

# _plugins_probe <url>: 0 the feed answers, 1 it does not, 2 nothing on this machine can ask.
# One HEAD request with the same tool and the same timeout the follow's own probe uses: "the
# mirror is down" and "the declaration is wrong" must not become the same answer.
_plugins_probe() {
    _ppb_secs="${AB_PACKAGES_REFRESH_PROBE_TIMEOUT:-8}"
    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q --spider -T "${_ppb_secs}" "$1" >/dev/null 2>&1
        return $?
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -q --spider -T "${_ppb_secs}" "$1" >/dev/null 2>&1
        return $?
    fi
    return 2
}

# _plugins_world_names: the bare package names a follow would ask apk about. The same rules
# `_world_entries` applies (comments, `@tag` lines and `!constraints` are not packages, and the
# kernel belongs to ab-slot) minus the version constraints, which `apk policy` takes as names.
#
# Three answers, because two would be a lie: 0 the names, 1 the machine keeps no world file at
# all, 2 the world is there and could not be read. The last one is the case that used to fall
# through as an empty list - "nothing to compare" - which reads as "no shadow" for a question
# that was never answered. A world this tool cannot read is `unverifiable`, never `none`.
_plugins_world_names() {
    _pwn_world="$(_root_prefix)/etc/apk/world"
    if [ ! -e "${_pwn_world}" ]; then
        return 1
    fi
    _pwn_all=""
    if ! _pwn_all=$(_world_entries); then
        return 2
    fi
    printf '%s\n' "${_pwn_all}" | sed 's/[=<>~].*//' | grep -v '^$'
}

# _plugins_src_is_candidate <url>: 0 when apk named one of the candidate plugin's own feeds.
# Read from _sc_feeds, which `_plugins_shadow` fills once for the whole check.
_plugins_src_is_candidate() {
    _psc_in=$1
    while IFS= read -r _psc_feed; do
        [ -n "${_psc_feed}" ] || continue
        # A feed is a directory apk appends index files to, so a source can be that directory
        # or a path below it.
        case "${_psc_in}" in
            "${_psc_feed}" | "${_psc_feed}"/*) return 0 ;;
        esac
    done <<FEEDS
${_sc_feeds:-}
FEEDS
    return 1
}

# _plugins_max_of <tuples-file> <name> <candidate|base>: the highest version offered for <name>
# by that group of sources, in AB_PLUGINS_MAX. Returns 1 when the ordering could not be asked -
# which the caller must read as `unverifiable`, never as "no such version".
_plugins_max_of() {
    _pmo_file=$1
    _pmo_name=$2
    _pmo_group=$3
    AB_PLUGINS_MAX=""
    [ -f "${_pmo_file}" ] || return 1
    while read -r _pmo_n _pmo_v _pmo_s; do
        [ "${_pmo_n}" = "${_pmo_name}" ] || continue
        if [ "${_pmo_group}" = "candidate" ]; then
            _plugins_src_is_candidate "${_pmo_s}" || continue
        else
            _plugins_src_is_candidate "${_pmo_s}" && continue
        fi
        if [ -z "${AB_PLUGINS_MAX}" ]; then
            AB_PLUGINS_MAX=${_pmo_v}
            continue
        fi
        _pmo_ord=$(ab_pkgs_version_cmp "$(_plugins_tree_root)" "${_pmo_v}" "${AB_PLUGINS_MAX}") \
            || return 1
        [ "${_pmo_ord}" = "1" ] && AB_PLUGINS_MAX=${_pmo_v}
    done <"${_pmo_file}"
    return 0
}

# _plugins_shadow_done <token>: the one exit from `_plugins_shadow` - the scratch tree goes, the
# token stays.
_plugins_shadow_done() {
    _plugins_tmpdrop "${_sh_tmp}"
    printf '%s' "$1"
    return 0
}

# _plugins_shadow <label>: the shadow question. Prints one token:
#
#   none          no name the world holds is offered at a higher version by this plugin's feeds
#   shadow:<name> one is, and <name> is the first such name in world order
#   unverifiable  apk, or its output, could not answer - never read as "no shadow"
#
# This is the only place apk is asked a question about sources. One `update` into a cache in
# /tmp (a check must not fill /var, which is a tmpfs on the measured machine), then one `policy`
# over the names the world holds, both under the same wall-clock cap as a transaction. Which
# source wins is apk's own business, so the ordering of two versions is asked of `apk version -t`
# rather than re-implemented here.
_plugins_shadow() {
    _sh_label=$1
    _sh_root=$(_plugins_root)
    # One private directory for the index cache, the repositories file and apk's output. A
    # fixed name here would be a name another user could pre-place; mktemp makes the name
    # unguessable and _plugins_shadow_done is the one exit that removes it.
    _sh_tmp=$(_plugins_tmpdir) || { printf 'unverifiable'; return 0; }
    mkdir -p "${_sh_tmp}/cache" 2>/dev/null || { printf 'unverifiable'; return 0; }
    _sh_repos="${_sh_tmp}/repositories"
    _sh_root_args=$(_plugins_apk_root_args)
    _sh_secs=${AB_PLUGINS_CHECK_TIMEOUT:-180}
    if ! _plugins_repos_file "${_sh_label}" "${_sh_repos}"; then
        say "ab-packages: the repositories file for the check could not be built"
        _plugins_shadow_done unverifiable
        return 0
    fi
    # shellcheck disable=SC2086  # --root <dir> as two words, or nothing on the running root
    ab_packages_run_bounded "${_sh_secs}" apk ${_sh_root_args} \
        --cache-dir "${_sh_tmp}/cache" --repositories-file "${_sh_repos}" update \
        >"${_sh_tmp}/update.log" 2>&1
    _sh_rc=$?
    if [ "${_sh_rc}" -ne 0 ]; then
        say "ab-packages: apk update over the candidate set failed (rc=${_sh_rc}); the index is what the question needs"
        tail -n 3 "${_sh_tmp}/update.log" 2>/dev/null | sed 's/^/ab-packages:   /' >&2
        _plugins_shadow_done unverifiable
        return 0
    fi
    _sh_names=$(_plugins_world_names)
    _sh_world_rc=$?
    if [ "${_sh_world_rc}" -eq 1 ]; then
        # A shadow needs two sources for one name, and here there is no name at all. This is an
        # answer, not a silence: the machine keeps no world, so no follow would move anything.
        say "ab-packages: no world entry to compare, so nothing can be shadowed"
        _plugins_shadow_done none
        return 0
    fi
    if [ "${_sh_world_rc}" -ne 0 ]; then
        say "ab-packages: the world exists and could not be read; the names to compare are unknown"
        say "ab-packages:   that is unverifiable, not 'no shadow'"
        _plugins_shadow_done unverifiable
        return 0
    fi
    if [ -z "${_sh_names}" ]; then
        say "ab-packages: no world entry to compare, so nothing can be shadowed"
        _plugins_shadow_done none
        return 0
    fi
    # shellcheck disable=SC2086  # one name per word: the world is a list of bare names here
    _sh_policy=$(ab_packages_run_bounded "${_sh_secs}" apk ${_sh_root_args} \
        --cache-dir "${_sh_tmp}/cache" --repositories-file "${_sh_repos}" policy ${_sh_names} 2>/dev/null)
    # `apk policy` prints, per name, a `<name> policy:` line, then a version line, then the
    # sources that offer it, each a level deeper. Anything else is not part of an answer.
    printf '%s\n' "${_sh_policy}" | awk '
        /^[^ \t].*:[ \t]*$/ {
            n = $0
            sub(/[ \t]*:$/, "", n)
            sub(/[ \t]+policy$/, "", n)
            name = n
            ver = ""
            next
        }
        /^[ \t]+[^ \t]+:[ \t]*$/ { ver = $1; sub(/:$/, "", ver); next }
        /^[ \t]+[^ \t]/ { if (name != "" && ver != "") print name " " ver " " $1 }
    ' >"${_sh_tmp}/policy.tuples"
    if [ ! -s "${_sh_tmp}/policy.tuples" ]; then
        say "ab-packages: apk policy printed nothing this tool can read (no name, version and source)"
        say "ab-packages:   that is unverifiable, not 'no shadow': the question was never answered"
        _plugins_shadow_done unverifiable
        return 0
    fi
    _sc_feeds=$(ab_plugins_feeds "${_sh_root}" "${_sh_label}")
    # World order, not policy order: the name a user reads about is the one their world lists
    # first, and a check is read as a statement about this machine.
    while IFS= read -r _sh_name; do
        [ -n "${_sh_name}" ] || continue
        _plugins_max_of "${_sh_tmp}/policy.tuples" "${_sh_name}" candidate || {
            say "ab-packages: ${_sh_name}: the version ordering could not be asked of apk"
            _plugins_shadow_done unverifiable
            return 0
        }
        _sh_cmax=${AB_PLUGINS_MAX}
        _plugins_max_of "${_sh_tmp}/policy.tuples" "${_sh_name}" base || {
            say "ab-packages: ${_sh_name}: the version ordering could not be asked of apk"
            _plugins_shadow_done unverifiable
            return 0
        }
        _sh_bmax=${AB_PLUGINS_MAX}
        # Only a name the plugin offers *and* the base offers can be taken from the base: a
        # name no feed offers is not shadowed, it is simply new.
        [ -n "${_sh_cmax}" ] || continue
        [ -n "${_sh_bmax}" ] || continue
        _sh_ord=$(ab_pkgs_version_cmp "$(_plugins_tree_root)" "${_sh_cmax}" "${_sh_bmax}") || {
            say "ab-packages: ${_sh_name}: the version ordering could not be asked of apk"
            _plugins_shadow_done unverifiable
            return 0
        }
        if [ "${_sh_ord}" = "1" ]; then
            say "ab-packages: ${_sh_name}: the plugin offers ${_sh_cmax}, the base ${_sh_bmax}"
            _plugins_shadow_done "shadow:${_sh_name}"
            return 0
        fi
    done <<NAMES
${_sh_names}
NAMES
    _plugins_shadow_done none
    return 0
}

# _plugins_verdict_record <root> <label> <verdict> <reason>: write the verdict, and say so when
# it did not reach the disk.
#
# The verdict is the whole point of a check: every later transaction trusts the file, not this
# run. So a check whose answer could not be recorded has not answered - the next transaction
# reads `never`, or an older verdict that no longer describes this declaration - and a caller
# must not print an `ok` it cannot back with a file. Returns 1 in that case, so each caller
# below can report it in its own line.
_plugins_verdict_record() {
    _pvv_root=$1
    _pvv_label=$2
    _pvv_verdict=$3
    _pvv_reason=$4
    ab_plugins_verdict_write "${_pvv_root}" "${_pvv_label}" "${_pvv_verdict}" "${_pvv_reason}" \
        && return 0
    say "ab-packages: ${_pvv_label}: the verdict could not be written to $(ab_plugins_dir "${_pvv_root}")/${_pvv_label}/.verdict"
    say "ab-packages:   a transaction keeps reading the state it had ($(ab_plugins_verdict_state "${_pvv_root}" "${_pvv_label}")), so this answer is not in force"
    return 1
}

# _plugins_check_one <label>: judge one declaration and record the answer. 0 ok, 74 blocked or
# unrecordable.
_plugins_check_one() {
    _pco_label=$1
    _pco_root=$(_plugins_root)
    if ! ab_plugins_validate "${_pco_root}" "${_pco_label}"; then
        _pco_reason=${AB_PLUGINS_REASON:-plugin-invalid}
        # The declaration is the fault, so the network has nothing to add: a URL apk cannot be
        # given is expensive to discover by fetching it. The verdict is still the answer a
        # later transaction reads, so a write that failed is named on the same line rather
        # than left to look like a blocked verdict that was recorded.
        _pco_note=""
        _plugins_verdict_record "${_pco_root}" "${_pco_label}" blocked "${_pco_reason}" \
            || _pco_note=" verdict-write=failed"
        printf 'plugin=%s verdict=blocked reason=%s%s\n' "${_pco_label}" "${_pco_reason}" "${_pco_note}"
        say "ab-packages: ${_pco_label}: ${_pco_reason} (static check; nothing was fetched)"
        return 74
    fi
    if [ "${AB_PLUGINS_ENABLED}" != "yes" ]; then
        # `enabled = no` is already a complete answer: the switch keeps the plugin out of every
        # transaction, and fetching a feed nobody will read spends the one network stage this
        # tool has on a foregone conclusion.
        printf 'plugin=%s verdict=skipped reason=plugin-disabled\n' "${_pco_label}"
        say "ab-packages: ${_pco_label}: enabled = no, so nothing reads it and nothing was fetched"
        return 0
    fi
    _pco_probe=0
    _pco_bad=""
    while IFS= read -r _pco_url; do
        [ -n "${_pco_url}" ] || continue
        _plugins_probe "${_pco_url}"
        case $? in
            0) ;;
            2) _pco_probe=2 ;;
            *) _pco_probe=1; _pco_bad=${_pco_url} ;;
        esac
        [ "${_pco_probe}" -eq 0 ] || break
    done <<FEEDS
$(ab_plugins_feeds "${_pco_root}" "${_pco_label}")
FEEDS
    case "${_pco_probe}" in
        2)
            _pco_note=""
            _plugins_verdict_record "${_pco_root}" "${_pco_label}" blocked unverifiable \
                || _pco_note=" verdict-write=failed"
            printf 'plugin=%s verdict=blocked reason=unverifiable%s\n' "${_pco_label}" "${_pco_note}"
            say "ab-packages: neither uclient-fetch nor wget is here, so whether a feed answers cannot be asked"
            return 74
            ;;
        1)
            _pco_note=""
            _plugins_verdict_record "${_pco_root}" "${_pco_label}" blocked feed-unreachable \
                || _pco_note=" verdict-write=failed"
            printf 'plugin=%s verdict=blocked reason=feed-unreachable%s url=%s\n' \
                "${_pco_label}" "${_pco_note}" "${_pco_bad}"
            say "ab-packages: ${_pco_bad} did not answer; the plugin contributes nothing until it does"
            return 74
            ;;
    esac
    _pco_token=$(_plugins_shadow "${_pco_label}")
    case "${_pco_token}" in
        shadow:*)
            if [ "${AB_PLUGINS_ALLOW_SHADOW}" = "yes" ]; then
                if ! _plugins_verdict_record "${_pco_root}" "${_pco_label}" ok shadow-allowed; then
                    printf 'plugin=%s verdict=ok reason=verdict-unwritable\n' "${_pco_label}"
                    return 74
                fi
                printf 'plugin=%s verdict=ok reason=shadow-allowed\n' "${_pco_label}"
                say "ab-packages: ${_pco_token#shadow:} comes from this plugin at a higher version than the base offers,"
                say "ab-packages:   and allow-shadow = yes accepts that; a follow will move it"
                return 0
            fi
            _pco_note=""
            _plugins_verdict_record "${_pco_root}" "${_pco_label}" blocked "${_pco_token}" \
                || _pco_note=" verdict-write=failed"
            printf 'plugin=%s verdict=blocked reason=%s%s\n' "${_pco_label}" "${_pco_token}" "${_pco_note}"
            say "ab-packages: ${_pco_token#shadow:} would be taken from this plugin's feed at a higher version than"
            say "ab-packages:   the base offers, which is how a follow moves a package nobody asked it to move."
            say "ab-packages:   Set allow-shadow = yes in the declaration to accept that, or pin the base version."
            return 74
            ;;
        unverifiable)
            _pco_note=""
            _plugins_verdict_record "${_pco_root}" "${_pco_label}" blocked unverifiable \
                || _pco_note=" verdict-write=failed"
            printf 'plugin=%s verdict=blocked reason=unverifiable%s\n' "${_pco_label}" "${_pco_note}"
            say "ab-packages: the shadow question could not be answered; it is recorded as unverifiable rather than as 'no shadow'"
            return 74
            ;;
    esac
    # The one answer a later transaction acts on: an `ok` printed here without the file behind
    # it would be a promise nothing keeps, so it is reported as unwritable and the check fails.
    if ! _plugins_verdict_record "${_pco_root}" "${_pco_label}" ok none; then
        printf 'plugin=%s verdict=ok reason=verdict-unwritable\n' "${_pco_label}"
        return 74
    fi
    printf 'plugin=%s verdict=ok reason=none\n' "${_pco_label}"
    return 0
}

cmd_plugins_list() {
    _pnv_any=0
    while IFS= read -r _pnv_label; do
        [ -n "${_pnv_label}" ] || continue
        # `ab_plugins_describe` builds the row without a newline (a caller may want to put
        # something after it), so the line break is this command's job.
        printf '%s\n' "$(ab_plugins_describe "$(_plugins_root)" "${_pnv_label}")"
        _pnv_any=1
    done <<LABELS
$(ab_plugins_labels "$(_plugins_root)")
LABELS
    if [ "${_pnv_any}" -eq 0 ]; then
        # The token rather than an empty output: a script asking "is anything declared" needs an
        # answer it can test, and no output at all reads as a command that failed.
        printf 'plugins=none\n'
        say "ab-packages: no plugin under $(ab_plugins_dir "$(_plugins_root)")"
    fi
    return 0
}

cmd_plugins_repos() {
    _pnr_dir=$(_plugins_tmpdir) || refuse plugins-repos-unwritable \
        "No private directory could be made under ${TMPDIR:-/tmp}." \
        "Nothing was changed."
    _pnr_file="${_pnr_dir}/repositories"
    if ! _plugins_repos_file "" "${_pnr_file}"; then
        _plugins_tmpdrop "${_pnr_dir}"
        refuse plugins-repos-unwritable \
            "The repositories file could not be built under ${TMPDIR:-/tmp}." \
            "Nothing was changed."
    fi
    cat "${_pnr_file}"
    _pnr_total=$(grep -c . "${_pnr_file}" 2>/dev/null || true)
    _pnr_total=${_pnr_total:-0}
    _plugins_tmpdrop "${_pnr_dir}"
    _pnr_plugin=$(ab_plugins_active_feeds "$(_plugins_root)" | grep -c . || true)
    _pnr_plugin=${_pnr_plugin:-0}
    _pnr_count=$(ab_plugins_active_count "$(_plugins_root)")
    if [ "${_pnr_count}" -eq 0 ]; then
        say "ab-packages: plugins=none; the ${_pnr_total} line(s) above are this machine's own feeds, nothing is added"
    else
        say "ab-packages: ${_pnr_plugin} plugin feed(s) from ${_pnr_count} plugin(s) follow the machine's own ${_pnr_total} line(s)"
    fi
    return 0
}

cmd_plugins_check() {
    _pnc_rc=0
    _pnc_any=0
    if [ "$#" -gt 0 ]; then
        for _pnc_label in "$@"; do
            _pnc_any=1
            _plugins_check_one "${_pnc_label}" || _pnc_rc=74
        done
    else
        while IFS= read -r _pnc_label; do
            [ -n "${_pnc_label}" ] || continue
            _pnc_any=1
            _plugins_check_one "${_pnc_label}" || _pnc_rc=74
        done <<LABELS
$(ab_plugins_labels "$(_plugins_root)")
LABELS
    fi
    [ "${_pnc_any}" -eq 1 ] && return "${_pnc_rc}"
    printf 'plugins=none\n'
    say "ab-packages: no plugin to check under $(ab_plugins_dir "$(_plugins_root)")"
    return 0
}

# cmd_plugins_apply <label> [--yes]: install what a plugin declares.
#
# One apk transaction, the same block-and-question as every other write here, and then nothing
# else: the world record describes "the whole world followed", and one plugin's package list is
# not that sentence (design.md §8). A source-only plugin installs nothing and says so with a
# token, because a plugin with nothing to install is a working plugin, not a failure.
cmd_plugins_apply() {
    _pna_label=""
    _pna_mode="follow"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) _pna_mode="yes"; shift ;;
            -*) say "ab-packages plugins apply: unknown option $1"; usage ;;
            *)
                [ -z "${_pna_label}" ] || { say "ab-packages plugins apply: one label at a time"; usage; }
                _pna_label=$1
                shift
                ;;
        esac
    done
    [ -n "${_pna_label}" ] || { say "ab-packages plugins apply: which plugin?"; usage; }

    _pna_root=$(_plugins_root)
    if ! ab_plugins_validate "${_pna_root}" "${_pna_label}"; then
        refuse "${AB_PLUGINS_REASON:-plugin-invalid}" \
            "The declaration of ${_pna_label} is refused before anything is installed." \
            "Next: ab-packages plugins list    shows the token each declaration is refused with"
    fi
    _pna_pkgs=$(ab_plugins_packages "${_pna_root}" "${_pna_label}")
    if [ -z "${_pna_pkgs}" ]; then
        printf 'plugin=%s result=nothing-to-install reason=plugin-nothing-to-install\n' "${_pna_label}"
        say "ab-packages: ${_pna_label} declares no package; its feeds take part in the next follow instead"
        return 0
    fi
    # The names become the words of one `apk add` line, so they are carried in the positional
    # parameters and expanded as "$@" - never through an unquoted ${...}. The library has
    # already refused anything that is not an apk package name (`plugin-package-invalid`), and
    # this is the second half of the same rule: even a name that slipped past it cannot split
    # into two words or be read as an option at the one place apk is actually called.
    set --
    _pna_count_seen=0
    while IFS= read -r _pna_name; do
        [ -n "${_pna_name}" ] || continue
        _pna_count_seen=$((_pna_count_seen + 1))
        set -- "$@" "${_pna_name}"
    done <<PKGS
${_pna_pkgs}
PKGS
    _pna_count=${_pna_count_seen:-0}
    _pna_plan="${TMPDIR:-/tmp}/ab-packages-plugins-apply.$$"
    {
        printf 'section Packages\n'
        printf 'row plugin %s (%s)\n' "${_pna_label}" "${AB_PLUGINS_KIND}"
        printf 'row packages %s\n' "$(printf '%s\n' "${_pna_pkgs}" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
        printf 'count %s\n' "${_pna_count}"
        printf 'note one apk transaction from the feeds this plugin declares; the world record is not touched (apk writes the world entries)\n'
    } >"${_pna_plan}"
    ab_plan_present "${_pna_plan}" "${_pna_mode}"
    _pna_rc=$?
    rm -f "${_pna_plan}" 2>/dev/null || :
    case "${_pna_rc}" in
        0) : ;;
        10)
            say "ab-packages: declined, nothing was written reason=declined"
            return 0
            ;;
        74) refuse noninteractive "no terminal to ask on; pass --yes to accept" ;;
        *) die "plan-unusable (the block could not be rendered)" ;;
    esac
    _pna_dir=$(_plugins_tmpdir) || refuse plugins-repos-unwritable \
        "No private directory could be made under ${TMPDIR:-/tmp}." \
        "Nothing was installed."
    _pna_repos="${_pna_dir}/repositories"
    if ! _plugins_repos_file "${_pna_label}" "${_pna_repos}"; then
        _plugins_tmpdrop "${_pna_dir}"
        refuse plugins-repos-unwritable \
            "The repositories file could not be built under ${TMPDIR:-/tmp}." \
            "Nothing was installed."
    fi
    _pna_root_args=$(_plugins_apk_root_args)
    # shellcheck disable=SC2086  # --root <dir> as two words, or nothing on the running root
    _pna_out=$(ab_packages_run_bounded "${AB_PLUGINS_CHECK_TIMEOUT:-180}" \
        apk ${_pna_root_args} --repositories-file "${_pna_repos}" add "$@" 2>&1)
    _pna_apk_rc=$?
    _plugins_tmpdrop "${_pna_dir}"
    printf '%s\n' "${_pna_out:-}" | grep . | head -n 5 | sed 's/^/ab-packages:   /' >&2
    if [ "${_pna_apk_rc}" -ne 0 ]; then
        printf 'plugin=%s result=failed reason=apk-%s\n' "${_pna_label}" "${_pna_apk_rc}"
        return 1
    fi
    printf 'plugin=%s result=installed packages=%s\n' "${_pna_label}" "${_pna_count}"
    return 0
}

cmd_plugins() {
    _pnp_sub=${1:-}
    [ "$#" -gt 0 ] && shift
    case "${_pnp_sub}" in
        list) cmd_plugins_list "$@" ;;
        repos) _plugins_require_seam; cmd_plugins_repos "$@" ;;
        check) _plugins_require_seam; cmd_plugins_check "$@" ;;
        apply) _plugins_require_seam; cmd_plugins_apply "$@" ;;
        *) say "ab-packages plugins: unknown subcommand ${_pnp_sub}"; usage ;;
    esac
}

# --- subcommands that change the machine ------------------------------------

cmd_update() {
    _ud_only=""
    AB_PACKAGES_ASSUME_YES=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) AB_PACKAGES_ASSUME_YES=1; shift ;;
            --only) _ud_only=${2:?--only needs a package name}; shift 2 ;;
            -*) say "ab-packages update: unknown option $1"; usage ;;
            *) say "ab-packages update: unexpected argument $1"; usage ;;
        esac
    done

    if [ -n "${_ud_only}" ]; then
        cmd_update_only "${_ud_only}"
        return $?
    fi

    cmd_update_plan ""
    case $? in
        0) : ;;
        10)
            say "ab-packages: declined, nothing was written reason=declined"
            return 0
            ;;
        74) refuse noninteractive "no terminal to ask on; pass --yes to accept" ;;
        *) die "plan-unusable (the block could not be rendered)" ;;
    esac
    # The transaction. `ab_packages_follow` publishes the record from what apk printed and
    # clears the cache; this command only reports it.
    if ab_packages_follow "${AB_PACKAGES_ROOT}"; then
        _ud_state=${AB_PACKAGES_FOLLOW_STATE:-ok}
    else
        _ud_state=${AB_PACKAGES_FOLLOW_STATE:-failed}
    fi
    say "ab-packages: follow=${_ud_state} upgraded=${AB_PACKAGES_FOLLOW_UPGRADED:-0} kept=${AB_PACKAGES_FOLLOW_KEPT:-0} mode=${AB_PACKAGES_FOLLOW_MODE:-unknown}"
    # The store is tidied after the transaction, not before: a body a feed took over in the same
    # minute should not be replayed by the plan that is still running.
    ab_pkgs_assets_maintain "${AB_PACKAGES_ROOT}" || :
    if [ -n "${AB_PKGS_ASSETS_SUPERSEDED}" ]; then
        say "ab-packages: superseded by a feed, bodies removed:${AB_PKGS_ASSETS_SUPERSEDED}"
    fi
    [ -z "${AB_PKGS_ASSETS_PRUNED}" ] \
        || say "ab-packages: pruned:${AB_PKGS_ASSETS_PRUNED} (${AB_PKGS_ASSETS_REASON:-older-version})"
    {
        printf 'follow=%s upgraded=%s kept=%s assets=%s\n' "${_ud_state}" \
            "${AB_PACKAGES_FOLLOW_UPGRADED:-0}" "${AB_PACKAGES_FOLLOW_KEPT:-0}" \
            "${AB_PKGS_ASSETS_BYTES:-0}"
    }
    [ "${_ud_state}" = "followed" ] && return 0
    _record_reason=$(_record_field reason)
    say "ab-packages: the follow did not complete (reason=${_record_reason:-unknown}); the record says what was attempted"
    return 1
}

# cmd_update_only <name>: retry one package.
#
# This is a narrower transaction than the follow (`apk upgrade <name>`, measured working on the
# device), and it deliberately does not touch the record: the record is one line about the whole
# world, and a single package that moved says nothing about the others. What moved is measured
# from apk's own database before and after, so a transaction that printed something and changed
# nothing cannot be reported as a success.
cmd_update_only() {
    _uo_name=$1
    if ! _uo_before=$(_installed_version "${_uo_name}"); then
        refuse "${_uo_name}-not-installed" \
            "These packages are a follow of what is installed; ${_uo_name} is not." \
            "Next: ab-packages status    to see what the world holds"
    fi
    _uo_mode="follow"
    [ "${AB_PACKAGES_ASSUME_YES:-0}" = "1" ] && _uo_mode="yes"
    _uo_plan="${TMPDIR:-/tmp}/ab-packages-only.$$"
    {
        printf 'section Packages\n'
        printf 'row retry %s\n' "${_uo_name}"
        printf 'row installed %s\n' "${_uo_before}"
        printf 'count 1\n'
        printf 'note one package only: the record still describes the whole world\n'
    } >"${_uo_plan}"
    ab_plan_present "${_uo_plan}" "${_uo_mode}"
    _uo_rc=$?
    rm -f "${_uo_plan}" 2>/dev/null || :
    case "${_uo_rc}" in
        0) : ;;
        10)
            say "ab-packages: declined, nothing was written reason=declined"
            return 0
            ;;
        74) refuse noninteractive "no terminal to ask on; pass --yes to accept" ;;
        *) die "plan-unusable" ;;
    esac
    # The one-package retry reads the same repositories as the whole-world follow: a plugin that
    # is active must move the packages it feeds here too, or this retry silently measures a
    # narrower set of sources than the follow it re-runs a part of. Empty when no plugin
    # contributes, which keeps the command byte-identical to what it always ran (ac-9).
    #
    # The root is the same rule every other apk call here follows: the running machine gets no
    # `--root`, a fixture tree is named with one.
    _uo_repos_args=$(_plugins_repos_args)
    _uo_repos_dir=""
    if [ -n "${_uo_repos_args}" ]; then
        # The pair is "--repositories-file <file>", and the directory to remove is the file's:
        # it is the private one _plugins_repos_args made, never ${TMPDIR} itself.
        _uo_repos_file=${_uo_repos_args##* }
        _uo_repos_dir=${_uo_repos_file%/*}
    fi
    _uo_root_args=$(_plugins_apk_root_args)
    # shellcheck disable=SC2086  # --root <dir> and --repositories-file <file>, each as two words or nothing
    _uo_out=$(apk ${_uo_root_args} ${_uo_repos_args} upgrade "${_uo_name}" 2>&1) || _uo_apk_rc=$?
    [ -z "${_uo_repos_dir}" ] || _plugins_tmpdrop "${_uo_repos_dir}"
    _uo_apk_rc=${_uo_apk_rc:-0}
    printf '%s\n' "${_uo_out:-}" | grep . | head -n 5 | sed 's/^/ab-packages:   /' >&2
    _uo_after=$(_installed_version "${_uo_name}") || _uo_after=""
    if [ "${_uo_apk_rc}" -ne 0 ]; then
        printf 'retry name=%s result=failed reason=apk-%s\n' "${_uo_name}" "${_uo_apk_rc}"
        return 1
    fi
    if [ "${_uo_before}" = "${_uo_after}" ]; then
        printf 'retry name=%s result=unchanged version=%s\n' "${_uo_name}" "${_uo_before}"
        say "ab-packages: nothing moved; apk had no candidate for it (the feed may not carry a newer build)"
        return 0
    fi
    printf 'retry name=%s result=ok version=%s->%s\n' "${_uo_name}" "${_uo_before}" "${_uo_after}"
    return 0
}

# _installed_version <name>: the version apk's database records, asked of the database so the
# answer works in a fixture tree and needs no apk binary.
_installed_version() {
    _iv_root=$(_root_prefix)
    _iv_db="${_iv_root}/lib/apk/db/installed"
    [ -f "${_iv_db}" ] || return 1
    _iv_ver=$(awk -v want="$1" '
        /^P:/ { pkg = substr($0, 3); next }
        pkg == want && /^V:/ { print substr($0, 3); exit }
    ' "${_iv_db}" 2>/dev/null)
    [ -n "${_iv_ver}" ] || return 1
    printf '%s' "${_iv_ver}"
}

cmd_replay() {
    _re_mode="follow"
    _re_decl_name=""
    _re_decl_ver=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) _re_mode="yes"; shift ;;
            --name)
                [ "$#" -ge 2 ] || { say "ab-packages replay: --name needs a value"; usage; }
                _re_decl_name=$2
                shift 2
                ;;
            --version)
                [ "$#" -ge 2 ] || { say "ab-packages replay: --version needs a value"; usage; }
                _re_decl_ver=$2
                shift 2
                ;;
            -*) say "ab-packages replay: unknown option $1"; usage ;;
            *) break ;;
        esac
    done
    # A file argument is the moment a local package's body is kept: the file is captured first,
    # so an install that fails still leaves the body behind for the next attempt. The declared
    # form is the same act with a person-supplied identity, and it is checked before anything is
    # written: a declaration is an input, not an authority.
    if [ -n "${_re_decl_name}" ] || [ -n "${_re_decl_ver}" ]; then
        if [ -z "${_re_decl_name}" ] || [ -z "${_re_decl_ver}" ]; then
            say "ab-packages replay: --name and --version go together"
            usage
        fi
        if [ "$#" -ne 1 ]; then
            say "ab-packages replay: --name/--version describe one file"
            usage
        fi
        if ! ab_pkgs_assets_capture_declared "${AB_PACKAGES_ROOT}" \
            "${_re_decl_name}" "${_re_decl_ver}" "$1"; then
            case "${AB_PKGS_ASSETS_REASON}" in
                asset-name-mismatch)
                    refuse asset-name-mismatch \
                        "The package does not call itself ${_re_decl_name} ${_re_decl_ver}." \
                        "The identity inside the file is what apk installs by; a declaration only names the kept body."
                    ;;
                asset-name-unverifiable)
                    refuse asset-name-unverifiable \
                        "Nothing on this machine could confirm the declared identity." \
                        "The file was not kept: a body filed under a name nobody checked is a body the next upgrade will trust."
                    ;;
                *)
                    refuse "${AB_PKGS_ASSETS_REASON:-asset-unidentified}" \
                        "The file could not be kept under the declared name." \
                        "Nothing was written to the store."
                    ;;
            esac
        fi
        say "ab-packages: kept${AB_PKGS_ASSETS_CAPTURED:- nothing} (declared)"
    elif [ "$#" -gt 0 ]; then
        if ! ab_pkgs_assets_capture "${AB_PACKAGES_ROOT}" "$@"; then
            refuse "${AB_PKGS_ASSETS_REASON:-asset-unidentified}" \
                "One of those files is not a package this tool can name." \
                "The name comes from the package's own metadata (apk adbdump, then .PKGINFO);" \
                "for a file no tool here can read, pass --name and --version and they will be checked."
        fi
        say "ab-packages: kept${AB_PKGS_ASSETS_CAPTURED:- nothing}"
    fi
    if [ "$#" -gt 0 ]; then
        # The captured bodies are replayed by name, not by `name-version`: the replay asks the
        # store for the highest body of a name, which is the one just captured when it is the
        # only one, and the newest one when the store already held another version. The library
        # reports the names it kept, so this does not depend on re-parsing a file name.
        set --
        for _re_item in ${AB_PKGS_ASSETS_CAPTURED_NAMES}; do
            # shellcheck disable=SC2086  # one name per body, by construction
            set -- "$@" "${_re_item}"
        done
    fi
    _re_count=$(ab_pkgs_assets_list "${AB_PACKAGES_ROOT}" | grep -c . || true)
    _re_count=${_re_count:-0}
    if [ "${_re_count}" -eq 0 ]; then
        printf 'replay result=empty bodies=0\n'
        say "ab-packages: no kept body to replay; a local package keeps its body only when it is installed through ab-packages replay"
        return 0
    fi
    _re_plan="${TMPDIR:-/tmp}/ab-packages-replay.$$"
    {
        printf 'section Packages\n'
        printf 'row replay %s kept bodies\n' "${_re_count}"
        printf 'row trust the file itself (apk add --allow-untrusted)\n'
        printf 'count %s\n' "${_re_count}"
        printf 'note a config file you edited is kept; the package copy lands as *.apk-new\n'
    } >"${_re_plan}"
    ab_plan_present "${_re_plan}" "${_re_mode}"
    _re_rc=$?
    rm -f "${_re_plan}" 2>/dev/null || :
    case "${_re_rc}" in
        0) : ;;
        10)
            say "ab-packages: declined, nothing was written reason=declined"
            return 0
            ;;
        74) refuse noninteractive "no terminal to ask on; pass --yes to accept" ;;
        *) die "plan-unusable" ;;
    esac
    ab_pkgs_assets_replay "${AB_PACKAGES_ROOT}" "$@" || :
    ab_pkgs_assets_maintain "${AB_PACKAGES_ROOT}" || :
    # A declaration that survived capture but not the install is a file that lied about itself;
    # the database is the only witness that cannot be edited by the file. Ordered comparison, so
    # `0.94.0` and `0.94.0-r0` are the same version rather than a mismatch.
    if [ -n "${_re_decl_name}" ]; then
        _re_dbver=$(ab_pkgs_installed_version "${AB_PACKAGES_ROOT}" "${_re_decl_name}" 2>/dev/null) \
            || _re_dbver=""
        _re_same=1
        if [ -n "${_re_dbver}" ]; then
            _re_same=$(ab_pkgs_version_cmp "${AB_PACKAGES_ROOT}" "${_re_dbver}" "${_re_decl_ver}" 2>/dev/null) || _re_same=1
        fi
        if [ "${_re_same}" != "0" ]; then
            printf 'replay name=%s version=%s result=failed reason=asset-name-mismatch\n' \
                "${_re_decl_name}" "${_re_decl_ver}"
            say "ab-packages: the database does not show ${_re_decl_name} ${_re_decl_ver}; the declaration was wrong"
            return 1
        fi
    fi
    printf 'replay result=%s ok=%s unchanged=%s failed=%s\n' "${AB_PKGS_REPLAY_STATE:-unknown}" \
        "${AB_PKGS_REPLAY_OK}" "${AB_PKGS_REPLAY_UNCHANGED}" "${AB_PKGS_REPLAY_FAILED}"
    case "${AB_PKGS_REPLAY_STATE}" in
        fail) return 1 ;;
        partial) say "ab-packages: some bodies did not install; the lines above name them"; return 0 ;;
    esac
    return 0
}

cmd_cache() {
    _ca_sub=${1:-status}
    [ "$#" -gt 0 ] && shift
    case "${_ca_sub}" in
        status)
            printf '%s\n%s\n' "$(ab_pkgs_cache_report "${AB_PACKAGES_ROOT}")" \
                "$(ab_pkgs_assets_report "${AB_PACKAGES_ROOT}")"
            say "ab-packages: the cache is one follow's downloads and is emptied when it ends; kept bodies live in $(ab_pkgs_assets_dir "${AB_PACKAGES_ROOT}")"
            ;;
        clean)
            ab_pkgs_cache_clean "${AB_PACKAGES_ROOT}"
            ;;
        *) say "ab-packages cache: unknown subcommand ${_ca_sub}"; usage ;;
    esac
}

main() {
    [ "$#" -ge 1 ] || usage
    # Identity is answered before any library is loaded: a machine whose package state is a mess
    # can still say which version it is, and `ab-slot --version` prints the same three lines.
    case "$1" in
        -V | --version)
            if _mn_lib=$(lib_path "${AB_VERSION_LIB}"); then
                # shellcheck source=platform/lib/ab-version.sh
                . "${_mn_lib}"
                ab_version_identity
                return 0
            fi
            die "no version library at ${AB_VERSION_LIB}"
            ;;
    esac

    if ! _mn_packages=$(lib_path "${AB_PACKAGES_LIB}"); then
        refuse packages-lib-missing \
            "The package library is not on this machine: ${AB_PACKAGES_LIB}" \
            "Nothing was changed. Next: re-run the upgrade that installs the platform layer"
    fi
    # shellcheck source=platform/lib/upgrade/packages.sh
    . "${_mn_packages}"
    if ! _mn_assets=$(lib_path "${AB_PKGS_ASSETS_LIB}"); then
        refuse assets-lib-missing \
            "The kept-body library is not on this machine: ${AB_PKGS_ASSETS_LIB}"
    fi
    # shellcheck source=platform/lib/ab-pkgs-assets.sh
    . "${_mn_assets}"
    if ! _mn_plan=$(lib_path "${AB_PLAN_LIB}"); then
        refuse plan-lib-missing \
            "The plan library is not on this machine: ${AB_PLAN_LIB}"
    fi
    # shellcheck source=platform/lib/ab-plan.sh
    . "${_mn_plan}"

    _mn_cmd=$1
    shift
    case "${_mn_cmd}" in
        status) cmd_status "$@" ;;
        sources) cmd_sources "$@" ;;
        update) cmd_update "$@" ;;
        replay) cmd_replay "$@" ;;
        cache) cmd_cache "$@" ;;
        plugins)
            # The plugin library is only read by the plugin subcommands and by an attribution in
            # `sources`: a machine whose platform layer predates it can still answer everything
            # else, which is why this is loaded here rather than with the other libraries.
            _plugins_require_lib
            cmd_plugins "$@"
            ;;
        -h | --help | help) usage ;;
        *) say "ab-packages: unknown command ${_mn_cmd}"; usage ;;
    esac
}

main "$@"
