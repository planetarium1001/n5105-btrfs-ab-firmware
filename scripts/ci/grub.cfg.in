# Rendered by scripts/ci/grub-render.sh from scripts/ci/grub.cfg.in -- do not edit.
#
# GRUB picks the committed slot. A menu entry that boots the other slot first marks
# itself as the one-shot try: it stores ab_try=<slot> and ab-commit clears the slot
# state after the health check passes.
#
# GRUB script is not bash: no && or || chains and no ${var:-default} expansions.
set timeout=@GRUB_TIMEOUT@
set default=@COMMITTED_INDEX@
set fallback=@COMMITTED_INDEX@

menuentry "N5105 AB slot a" --id n5105-a {
	set ab_slot=a
	set ab_try=a
	save_env -f @GRUBENV_PATH@ ab_try
	linux /vmlinuz-a root=/dev/ram0 console=ttyS0,115200 console=tty0 ab.slot=a
	initrd /initrd-a
}

menuentry "N5105 AB slot b" --id n5105-b {
	set ab_slot=b
	set ab_try=b
	save_env -f @GRUBENV_PATH@ ab_try
	linux /vmlinuz-b root=/dev/ram0 console=ttyS0,115200 console=tty0 ab.slot=b
	initrd /initrd-b
}

menuentry "N5105 AB recovery (committed slot, read-only writable layer)" --id n5105-recovery {
	set ab_slot=@COMMITTED_SLOT@
	linux /vmlinuz-@COMMITTED_SLOT@ root=/dev/ram0 console=ttyS0,115200 console=tty0 ab.slot=@COMMITTED_SLOT@ ab.degraded=1
	initrd /initrd-@COMMITTED_SLOT@
}
